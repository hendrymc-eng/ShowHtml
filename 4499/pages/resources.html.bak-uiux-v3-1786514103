    .filter-divider { width: 1px; height: 20px; background: var(--color-line); }

    /* News list */
    .news-list { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-md); overflow: hidden; margin-top: var(--space-6); }
    .news-item { display: grid; grid-template-columns: 120px 1fr auto; gap: var(--space-6); padding: var(--space-5) var(--space-6); border-bottom: 1px solid var(--color-line); align-items: center; }
