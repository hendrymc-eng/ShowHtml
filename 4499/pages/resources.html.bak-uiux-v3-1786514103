    .feature-card:hover { background: var(--color-surface-2); border-color: var(--color-line-2); }
    .feature-cover {
      aspect-ratio: 16 / 9;
      border-radius: var(--radius-sm);
      background: var(--color-surface-2);
      border: 1px solid var(--color-line);
      overflow: hidden;
      position: relative;
    }
    .feature-cover svg { width: 100%; height: 100%; display: block; }
    .feature-meta { display: flex; align-items: center; gap: var(--space-3); font-size: var(--text-xs); color: var(--color-ink-3); }
    .feature-tag {
      padding: 2px var(--space-2);
      background: var(--color-accent-soft);
      color: var(--color-accent);
      border-radius: var(--radius-pill);
      font-weight: var(--weight-medium);
    }
    .feature-tag-trust { background: var(--color-trust-soft); color: var(--color-trust); }
    .feature-tag-success { background: var(--color-success-soft); color: var(--color-success); }
    .feature-tag-info { background: var(--color-info-soft); color: var(--color-info); }
    .feature-title {
      font-family: var(--font-display);
      font-size: var(--text-xl);
      font-weight: var(--weight-semibold);
      color: var(--color-ink);
      margin: 0;
