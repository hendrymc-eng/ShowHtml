    .newsletter-form { display: flex; gap: var(--space-2); }

    /* CTA band */
    .cta-band { background: var(--color-ink); color: var(--color-ink-inv); padding: var(--space-20) 0; }
    .cta-band-inner { max-width: var(--container-max); margin: 0 auto; padding: 0 var(--space-6); display: grid; grid-template-columns: 1.4fr 1fr; gap: var(--space-12); align-items: center; }
