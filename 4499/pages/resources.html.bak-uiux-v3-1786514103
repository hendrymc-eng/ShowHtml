    .news-date { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--color-ink-3); }
    .news-date strong { display: block; font-family: var(--font-display); font-size: var(--text-lg); color: var(--color-ink); font-weight: var(--weight-semibold); }
    .news-title { font-size: var(--text-md); color: var(--color-ink); font-weight: var(--weight-medium); }
    .news-tag { padding: 2px var(--space-2); font-size: var(--text-xs); color: var(--color-ink-2); background: var(--color-surface-2); border-radius: var(--radius-pill); }

    /* Newsletter */
    .newsletter {
      background: var(--color-surface);
      border: 1px solid var(--color-line);
      border-radius: var(--radius-lg);
      padding: var(--space-10);
