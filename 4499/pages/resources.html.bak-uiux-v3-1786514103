    .feature-desc { font-size: var(--text-sm); color: var(--color-ink-2); line-height: var(--leading-relaxed); margin: 0; }
    .feature-footer { display: flex; justify-content: space-between; align-items: center; padding-top: var(--space-3); border-top: 1px solid var(--color-line); font-size: var(--text-sm); color: var(--color-ink-3); }
    .feature-link { color: var(--color-accent); font-weight: var(--weight-medium); }
    .feature-link::after { content: ' →'; }

    /* Filter row */
    .filter-row {
      display: flex; gap: var(--space-3);
      margin-top: var(--space-6); margin-bottom: var(--space-4);
      flex-wrap: wrap; align-items: center;
    }
    .filter-pill {
      padding: 4px var(--space-3);
      font-size: var(--text-sm);
      color: var(--color-ink-2);
      background: var(--color-surface);
      border: 1px solid var(--color-line);
      border-radius: var(--radius-pill);
