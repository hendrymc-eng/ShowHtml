<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>登录 / 准入 · 4499</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="../css/tokens.css"?v=2 />
  <link rel="stylesheet" href="../css/components.css"?v=2 />
  <style>
    body { background: var(--color-paper); min-height: 100vh; display: flex; flex-direction: column; }
    .login-bar { height: var(--topbar-height); background: var(--color-surface); border-bottom: 1px solid var(--color-line); display: flex; align-items: center; padding: 0 var(--space-6); }
    .login-main { flex: 1; display: grid; grid-template-columns: 1fr 1fr; min-height: 0; }
    @media (max-width: 1024px) { .login-main { grid-template-columns: 1fr; } }
    .login-left { padding: var(--space-12) var(--space-10); display: flex; flex-direction: column; justify-content: center; max-width: 480px; margin: 0 auto; }
    .login-right { background: var(--color-surface); border-left: 1px solid var(--color-line); padding: var(--space-10); overflow-y: auto; }
    @media (max-width: 1024px) { .login-right { display: none; } }
    .gate-item { display: flex; align-items: flex-start; gap: var(--space-3); padding: var(--space-3) 0; border-bottom: 1px solid var(--color-line); }
    .gate-item:last-child { border-bottom: none; }
    .gate-check { width: 22px; height: 22px; border-radius: 50%; background: var(--color-success-soft); color: var(--color-success); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: var(--text-sm); }
    .gate-check.is-pending { background: var(--color-warn-soft); color: var(--color-warn-2); }
    .gate-check.is-failed { background: var(--color-danger-soft); color: var(--color-danger); }
    .gate-main { flex: 1; }
    .gate-name { font-size: var(--text-md); font-weight: var(--weight-medium); color: var(--color-ink); }
    .gate-desc { font-size: var(--text-sm); color: var(--color-ink-3); margin-top: 2px; }

    /* 4 主体选择卡 */
    .login-subject-card { padding: var(--space-3); background: var(--color-paper); border: 1px solid var(--color-line); border-radius: var(--radius-md); cursor: pointer; transition: all var(--dur-fast) var(--ease-out); }
    .login-subject-card:hover { border-color: var(--color-line-2); }
    .login-subject-card.is-active { border-color: var(--color-accent); background: var(--color-accent-softer); }
    .login-subject-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; margin-bottom: 4px; }
    .login-subject-dot[data-color="user"] { background: var(--color-ink-3); }
    .login-subject-dot[data-color="member"] { background: var(--color-accent); }
    .login-subject-dot[data-color="enterprise"] { background: var(--color-info); }
    .login-subject-dot[data-color="organization"] { background: var(--color-warn-2); }
    .login-subject-name { font-size: var(--text-sm); font-weight: var(--weight-semibold); color: var(--color-ink); }
    .login-subject-desc { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; }
  </style>
</head>
<body>
  <header class="login-bar">
    <a href="workbench-recommender.html" class="topbar-brand" style="text-decoration:none;">
      <div class="topbar-brand-mark">4</div><span>4499</span>
    </a>
    <div style="margin-left:auto; display: flex; align-items: center; gap: var(--space-3);">
      <span class="text-sm text-ink-3">还没有账号？</span>
      <button class="btn btn-secondary btn-sm">申请加入</button>
    </div>
  </header>

  <div class="login-main">
    <!-- 左侧：登录表单 -->
    <div class="login-left">
      <span class="eyebrow">登录 · 6 项准入校验</span>
      <h1 class="page-title" style="margin-top: var(--space-2); font-size: var(--text-3xl);">欢迎回到 4499</h1>
      <p class="page-subtitle">使用手机号 / 邮箱 + 密码登录。完成 6 项准入后即可进入完整工作台。</p>

      <!-- 登录方式切换 -->
      <div class="segmented js-segmented mt-4" style="width: 100%;">
        <div class="segmented-item is-active" style="flex: 1; text-align: center;">密码登录</div>
        <div class="segmented-item" style="flex: 1; text-align: center;">验证码登录</div>
        <div class="segmented-item" style="flex: 1; text-align: center;">扫码登录</div>
      </div>

      <div class="mt-6">
        <div class="input-group">
          <label class="input-label">手机号 / 邮箱</label>
          <input type="text" class="input input-lg" placeholder="+86 138 **** 8888" value="linxiuhua@****.com" />
        </div>
        <div class="input-group mt-4">
          <label class="input-label">密码</label>
          <input type="password" class="input input-lg" placeholder="至少 8 位" value="********" />
        </div>
        <div class="input-group mt-4">
          <label class="input-label">图形验证码</label>
          <div class="flex gap-2">
            <input type="text" class="input input-lg" placeholder="4 位" style="flex: 1;" />
            <div style="height: 44px; width: 100px; background: var(--color-surface-2); border: 1px solid var(--color-line-2); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-weight: 600; letter-spacing: 4px; color: var(--color-ink);">8M3K</div>
          </div>
        </div>
        <div class="flex justify-between mt-4">
          <label class="flex items-center gap-2 text-sm text-ink-2"><input type="checkbox" checked /> 7 天内自动登录</label>
          <a href="#" class="text-sm">忘记密码？</a>
        </div>
        <button class="btn btn-primary w-full mt-6" style="height: 44px;" onclick="doLogin()">登录</button>
        <div class="text-center text-sm text-ink-3 mt-4">登录即表示同意<a href="#">《用户协议》</a>和<a href="#">《隐私政策》</a></div>

      <!-- 主体选择 (PRD IAM-003) -->
      <div style="margin-top: var(--space-6); padding: var(--space-4); background: var(--color-accent-softer); border: 1px solid var(--color-accent-soft); border-radius: var(--radius-md);">
        <div class="flex items-center justify-between mb-3">
          <div class="text-sm fw-semibold">登录后默认进入的主体 (可登录后切换)</div>
        </div>
        <div class="grid-2x2" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-2);">
          <div class="login-subject-card is-active" data-subject="user" onclick="selectLoginSubject('user')">
            <div class="login-subject-dot" data-color="user"></div>
            <div class="login-subject-name">普通参与者</div>
            <div class="login-subject-desc">基础资料 / 受邀活动</div>
          </div>
          <div class="login-subject-card" data-subject="member" onclick="selectLoginSubject('member')">
            <div class="login-subject-dot" data-color="member"></div>
            <div class="login-subject-name">个人会员</div>
            <div class="login-subject-desc">完整工作台 / 客户经营</div>
          </div>
          <div class="login-subject-card" data-subject="enterprise" onclick="selectLoginSubject('enterprise')">
            <div class="login-subject-dot" data-color="enterprise"></div>
            <div class="login-subject-name">企业经营</div>
            <div class="login-subject-desc">企业画像 / 项目 / 团队</div>
          </div>
          <div class="login-subject-card" data-subject="organization" onclick="selectLoginSubject('organization')">
            <div class="login-subject-dot" data-color="organization"></div>
            <div class="login-subject-name">组织运营</div>
            <div class="login-subject-desc">公益 / 公信力 / 影响力</div>
          </div>
        </div>
      </div>
      </div>

      <!-- 第三方登录 -->
      <div class="mt-8 pt-6" style="border-top: 1px solid var(--color-line);">
        <div class="text-sm text-ink-3 text-center mb-3">其他登录方式</div>
        <div class="flex gap-3 justify-center">
          <button class="btn btn-secondary btn-icon" aria-label="微信">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M3 8a5 5 0 019-3 5 5 0 011 9.7L11 16l-2-1.5a5 5 0 01-6-1A5 5 0 013 8z" stroke="currentColor" stroke-width="1.4"/></svg>
          </button>
          <button class="btn btn-secondary btn-icon" aria-label="企业邮箱">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><rect x="2" y="4" width="14" height="11" rx="1" stroke="currentColor" stroke-width="1.4"/><path d="M2 8h14" stroke="currentColor" stroke-width="1.4"/></svg>
          </button>
          <button class="btn btn-secondary btn-icon" aria-label="SSO">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M3 9a6 6 0 0112 0M3 9a6 6 0 0012 0M9 3v12" stroke="currentColor" stroke-width="1.4"/></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- 右侧：6 项准入校验 + 进度 -->
    <div class="login-right">
      <span class="eyebrow">准入 · 6 项校验</span>
      <h2 class="section-title" style="margin-top: var(--space-2);">完成后开启全部功能</h2>
      <p class="section-subtitle">已通过 3 项 · 还需 3 项</p>

      <!-- 进度 -->
      <div class="card mt-6">
        <div class="flex justify-between mb-2">
          <div class="text-sm text-ink-2">准入进度</div>
          <div class="text-sm fw-medium"><span class="js-counter" data-target="50">0</span>%</div>
        </div>
        <div class="progress progress-trust progress-lg"><div class="progress-bar" style="width: 50%;"></div></div>
        <div class="text-xs text-ink-3 mt-2">预计完成时间：15 分钟</div>
      </div>

      <div class="card mt-4">
        <div class="gate-item">
          <div class="gate-check">✓</div>
          <div class="gate-main">
            <div class="gate-name">1. 身份验证</div>
            <div class="gate-desc">手机号 + 邮箱均已验证 · 2024-03-12 通过</div>
          </div>
          <span class="badge badge-success">已完成</span>
        </div>
        <div class="gate-item">
          <div class="gate-check">✓</div>
          <div class="gate-main">
            <div class="gate-name">2. 账号状态</div>
            <div class="gate-desc">账号正常 · 无违规记录</div>
          </div>
          <span class="badge badge-success">已完成</span>
        </div>
        <div class="gate-item">
          <div class="gate-check">✓</div>
          <div class="gate-main">
            <div class="gate-name">3. KYC 基础</div>
            <div class="gate-desc">身份证 + 银行卡 4 项均已通过</div>
          </div>
          <span class="badge badge-success">已完成</span>
        </div>
        <div class="gate-item">
          <div class="gate-check is-pending">!</div>
          <div class="gate-main">
            <div class="gate-name">4. 角色选择</div>
            <div class="gate-desc">推荐人 / EMP / AI 顾问 / 专业中心 / 平台运营</div>
          </div>
          <button class="btn btn-secondary btn-sm">去选择</button>
        </div>
        <div class="gate-item">
          <div class="gate-check is-pending">!</div>
          <div class="gate-main">
            <div class="gate-name">5. 资质认证</div>
            <div class="gate-desc">专业证书 / 资历证明上传 · 至少 1 项</div>
          </div>
          <button class="btn btn-secondary btn-sm">去认证</button>
        </div>
        <div class="gate-item">
          <div class="gate-check is-pending">!</div>
          <div class="gate-main">
            <div class="gate-name">6. 合规签署</div>
            <div class="gate-desc">服务协议 / 数据授权 / 利益冲突声明</div>
          </div>
          <button class="btn btn-secondary btn-sm">去签署</button>
        </div>
      </div>

      <!-- 解锁能力 -->
      <div class="mt-6">
        <div class="text-sm text-ink-3 mb-2 fw-medium">完成全部 6 项后可解锁</div>
        <div class="grid-2x" style="gap: var(--space-2);">
          <div class="text-sm flex items-center gap-2"><span class="badge badge-accent">✓</span> 客户管理</div>
          <div class="text-sm flex items-center gap-2"><span class="badge badge-accent">✓</span> 专业协作</div>
          <div class="text-sm flex items-center gap-2"><span class="badge badge-accent">✓</span> 公益参与</div>
          <div class="text-sm flex items-center gap-2"><span class="badge badge-accent">✓</span> 商业网络</div>
          <div class="text-sm flex items-center gap-2"><span class="badge badge-accent">✓</span> Trust Passport</div>
          <div class="text-sm flex items-center gap-2"><span class="badge badge-accent">✓</span> EMP 1v1 通道</div>
        </div>
      </div>

      <!-- 风险提示 -->
      <div class="mt-6 p-4" style="background: var(--color-warn-soft); border-radius: var(--radius-md);">
        <div class="text-sm fw-medium" style="color: var(--color-warn-2);">⚠ 重要提示</div>
        <div class="text-xs text-ink-2 mt-1">4499 不接受任何 "代客理财 / 团队计酬 / 高回报承诺" 行为。如发现违规，将立即冻结账号并向监管部门报告。</div>
      </div>
    </div>
  </div>
  <script src="../js/app.js"></script>
  <script>
    // 4 主体选择 (默认 member)
    function selectLoginSubject(t) {
      try { localStorage.setItem('mvs_subject_type', t); } catch (e) {}
      document.querySelectorAll('.login-subject-card').forEach(function (c) {
        c.classList.toggle('is-active', c.getAttribute('data-subject') === t);
      });
    }
    function doLogin() {
      var subj = 'member';
      try { subj = localStorage.getItem('mvs_subject_type') || 'member'; } catch (e) {}
      var map = { user: 'workbench-user.html', member: 'workbench-recommender.html', enterprise: 'workbench-enterprise.html', organization: 'workbench-organization.html' };
      toast('登录成功 · 进入「' + (subj === 'user' ? '普通参与者' : subj === 'member' ? '个人会员' : subj === 'enterprise' ? '企业经营' : '组织运营') + '」', 'success');
      setTimeout(function () { window.location.href = map[subj] || 'workbench-recommender.html'; }, 600);
    }
    // 初始 is-active
    (function () {
      var cur = 'member';
      try { cur = localStorage.getItem('mvs_subject_type') || 'member'; } catch (e) {}
      document.querySelectorAll('.login-subject-card').forEach(function (c) {
        c.classList.toggle('is-active', c.getAttribute('data-subject') === cur);
      });
    })();
  </script>
</body>
</html>
