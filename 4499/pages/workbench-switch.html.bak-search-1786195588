  <script>
    // 4 主体切换
    document.querySelectorAll('.js-subject-card').forEach(function (card) {
      card.addEventListener('click', function () {
        var subj = card.getAttribute('data-subject');
        try { localStorage.setItem('mvs_subject_type', subj); } catch (e) {}
        // is-active 状态
        document.querySelectorAll('.js-subject-card').forEach(function (c) { c.classList.remove('is-active'); });
        card.classList.add('is-active');
        // 跳对应 workbench
        var target = subj === 'user' ? 'workbench-user.html' :
                     subj === 'member' ? 'workbench-recommender.html' :
                     subj === 'enterprise' ? 'workbench-enterprise.html' :
                     'workbench-organization.html';
        toast('已切换到「' + card.querySelector('.fw-semibold').textContent + '」', 'success');
        setTimeout(function () { window.location.href = target; }, 600);
      });
    });
    // 初始 is-active 跟着 localStorage
    (function () {
      var cur = 'member';
      try { cur = localStorage.getItem('mvs_subject_type') || 'member'; } catch (e) {}
      document.querySelectorAll('.js-subject-card').forEach(function (c) {
        c.classList.toggle('is-active', c.getAttribute('data-subject') === cur);
      });
    })();
  </script>
<script>
  // 主体切换菜单
  function toggleSubjectMenu(e) {
    e.stopPropagation();
    var menu = document.getElementById('jsSubjectMenu');
    if (!menu) return;
    menu.hidden = !menu.hidden;
  }
  function switchSubject(t) {
    try { localStorage.setItem('mvs_subject_type', t); } catch (e) {}
    // 触发自定义事件, 让 app.js 监听并重渲染 sidebar (不刷新页面)
    window.dispatchEvent(new CustomEvent('mvs:subject-changed'));
    // 关闭菜单
    var menu = document.getElementById('jsSubjectMenu');
    if (menu) menu.hidden = true;
    // toast 提示
    if (typeof toast === 'function') {
      var labels = { user: '普通参与者', member: '个人会员', enterprise: '企业经营', organization: '组织运营' };
      toast('已切换到「' + (labels[t] || t) + '」', 'success');
    }
  }
  // 初始化 chip (根据 localStorage)
  (function () {
    var cur = 'member';
    try { cur = localStorage.getItem('mvs_subject_type') || 'member'; } catch (e) {}
    var labels = { user: '普通参与者', member: '个人会员', enterprise: '企业经营', organization: '组织运营' };
    var chip = document.getElementById('jsSubjectChip');
    var lbl = document.getElementById('jsSubjectLabel');
    if (chip) chip.setAttribute('data-subject', cur);
    if (lbl) lbl.textContent = labels[cur] || '个人会员';
    // 点击外部关闭菜单
    document.addEventListener('click', function () {
      var menu = document.getElementById('jsSubjectMenu');
      if (menu) menu.hidden = true;
    });
  })();

  // 11 角色卡 click 响应 (workbench-switch.html 专用)
  // - 推荐人 (active) -> 跳 workbench-recommender.html
  // - 其它 10 个 (is-disabled) -> 弹 toast "该角色工作台待开放"
  function enterRoleWorkbench(role) {
    if (role === 'recommender') {
      // 唯一真实可跳转的工作台
      if (typeof toast === 'function') toast('进入「推荐人工作台」', 'success');
      setTimeout(function () { window.location.href = 'workbench-recommender.html'; }, 400);
      return;
    }
    // 10 个待开放角色
    var labels = {
      emp: 'EMP 顾问',
      ai: 'AI 顾问',
      center: '专业中心',
      learner: '学习者',
      consultant: '独立顾问',
      family: '家庭办公室',
      charity: '公益参与者',
      'enterprise-rep': '企业代表',
      coordinator: '协作发起人',
      alumni: '校友会'
    };
    if (typeof toast === 'function') {
      toast('「' + (labels[role] || role) + '」工作台待开放', 'info');
    }
  }
  </script>
