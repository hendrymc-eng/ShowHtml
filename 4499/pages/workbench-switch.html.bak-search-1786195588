  <style>
    .role-card { padding: var(--space-5); cursor: pointer; transition: all var(--dur-fast) var(--ease-out); }
    .role-single { display: block; max-width: 720px; }
    .role-single .role-card { display: grid; grid-template-columns: 56px 1fr auto; gap: var(--space-5); align-items: start; padding: var(--space-6); }
    .role-single .role-icon { margin-bottom: 0; width: 56px; height: 56px; }
    .role-single .role-card-body { min-width: 0; }
    .role-single .role-card-side { display: flex; flex-direction: column; align-items: flex-end; gap: var(--space-2); }
    .role-card:hover { border-color: var(--color-accent); background: var(--color-accent-softer); }
    .role-card.is-active { border-color: var(--color-accent); background: var(--color-accent-soft); border-width: 2px; }
    .role-card.is-disabled { opacity: 0.55; cursor: not-allowed; }
    .role-card.is-disabled:hover { border-color: var(--color-line); background: var(--color-paper); transform: none; }
    .role-icon { width: 48px; height: 48px; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-3); }
    .role-perm { display: flex; flex-direction: column; gap: var(--space-1); margin-top: var(--space-3); padding-top: var(--space-3); border-top: 1px solid var(--color-line); }
  
    .subject-chip { display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; background: var(--color-accent-soft); border: 1px solid var(--color-accent); border-radius: var(--radius-pill); font-size: var(--text-xs); font-weight: var(--weight-semibold); color: var(--color-accent); cursor: pointer; user-select: none; transition: background var(--dur-fast) var(--ease-out); position: relative; }
    .subject-chip:hover { background: var(--color-accent); }
    .subject-chip-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
    .subject-chip[data-subject="user"] { background: var(--color-surface-2); border-color: var(--color-line); color: var(--color-ink-2); }
    .subject-chip[data-subject="enterprise"] { background: var(--color-info-soft); border-color: var(--color-info); color: var(--color-info); }
    .subject-chip[data-subject="organization"] { background: var(--color-warn-soft); border-color: var(--color-warn-2); color: var(--color-warn-2); }
    .subject-menu { position: absolute; top: calc(100% + 4px); right: 0; min-width: 140px; background: var(--color-paper); border: 1px solid var(--color-line); border-radius: var(--radius-md); padding: 4px; box-shadow: var(--shadow-md); z-index: 100; }
    .subject-menu-item { display: flex; align-items: center; gap: 6px; padding: 6px 10px; font-size: var(--text-xs); color: var(--color-ink-2); border-radius: var(--radius-sm); cursor: pointer; }
    .subject-menu-item:hover { background: var(--color-surface); color: var(--color-ink); }
    .subject-menu-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-line-2); }
    .subject-menu-item[data-subject="user"] .subject-menu-dot { background: var(--color-ink-3); }
    .subject-menu-item[data-subject="member"] .subject-menu-dot { background: var(--color-accent); }
    .subject-menu-item[data-subject="enterprise"] .subject-menu-dot { background: var(--color-info); }
    .subject-menu-item[data-subject="organization"] .subject-menu-dot { background: var(--color-warn-2); }
    </style>
