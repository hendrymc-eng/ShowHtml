    .org-logo { width: 80px; height: 80px; border-radius: var(--radius-md); background: var(--color-charity-soft); color: var(--color-charity); display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-size: 32px; font-weight: 600; }
