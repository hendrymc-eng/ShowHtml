    .identity-icon { width: 32px; height: 32px; border-radius: var(--radius-sm); background: var(--color-accent-soft); color: var(--color-accent); display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-2); }
    .identity-name { font-size: var(--text-sm); font-weight: var(--weight-semibold); color: var(--color-ink); }
