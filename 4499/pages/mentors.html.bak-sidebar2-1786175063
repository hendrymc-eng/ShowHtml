  <style>
    /* 专长领域矩阵 */
    .skill-matrix { width: 100%; border-collapse: separate; border-spacing: 0; font-size: var(--text-sm); }
    .skill-matrix th, .skill-matrix td { padding: var(--space-3); text-align: center; border-bottom: 1px solid var(--color-line); }
    .skill-matrix th { font-weight: var(--weight-medium); color: var(--color-ink-3); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.04em; background: var(--color-surface-2); }
    .skill-matrix th:first-child, .skill-matrix td:first-child { text-align: left; color: var(--color-ink-2); font-weight: var(--weight-medium); }
    .skill-cell { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 24px; border-radius: var(--radius-sm); font-family: var(--font-mono); font-size: var(--text-xs); font-weight: var(--weight-medium); }
    .skill-cell-l4 { background: var(--color-accent); color: white; }
    .skill-cell-l3 { background: var(--color-accent-soft); color: var(--color-accent); }
    .skill-cell-l2 { background: var(--color-surface-2); color: var(--color-ink-2); border: 1px solid var(--color-line-2); }
    .skill-cell-l1 { background: var(--color-surface); color: var(--color-ink-3); border: 1px dashed var(--color-line-2); }

    /* 预约日历 · 周视图 */
    .schedule-grid { display: grid; grid-template-columns: 60px repeat(7, 1fr); gap: 1px; background: var(--color-line); border: 1px solid var(--color-line); border-radius: var(--radius-md); overflow: hidden; }
    .schedule-cell { background: var(--color-surface); padding: var(--space-2); min-height: 48px; display: flex; align-items: center; justify-content: center; font-size: var(--text-xs); color: var(--color-ink-3); cursor: pointer; transition: background var(--dur-fast) var(--ease-out); }
    .schedule-cell:hover { background: var(--color-accent-softer); }
    .schedule-cell-head { background: var(--color-surface-2); font-weight: var(--weight-medium); color: var(--color-ink-2); font-size: var(--text-sm); }
    .schedule-cell-time { background: var(--color-surface-2); color: var(--color-ink-3); font-family: var(--font-mono); font-size: var(--text-xs); }
    .schedule-cell-available { background: var(--color-accent-softer); color: var(--color-accent); font-weight: var(--weight-medium); }
    .schedule-cell-booked { background: var(--color-warn-softer); color: var(--color-warn-2); }
    .schedule-cell-today { background: var(--color-accent); color: white; font-weight: var(--weight-semibold); }

    /* 评价卡 */
    .review-card { padding: var(--space-4); border: 1px solid var(--color-line); border-radius: var(--radius-md); background: var(--color-surface); }
    .review-quote { font-size: var(--text-md); color: var(--color-ink-2); line-height: var(--leading-relaxed); position: relative; padding-left: var(--space-4); border-left: 2px solid var(--color-accent-soft); }
    .review-rating { display: flex; align-items: center; gap: var(--space-2); margin-top: var(--space-3); }
    .review-stars { color: var(--color-warn-2); letter-spacing: 1px; }
    .review-meta { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: var(--space-2); }

    /* AI 匹配推荐 */
    .match-card { padding: var(--space-4); border: 1px solid var(--color-line); border-radius: var(--radius-md); display: flex; gap: var(--space-3); align-items: flex-start; }
    .match-card-rank { width: 28px; height: 28px; border-radius: 50%; background: var(--color-accent-soft); color: var(--color-accent); display: flex; align-items: center; justify-content: center; font-size: var(--text-sm); font-weight: var(--weight-semibold); flex-shrink: 0; }
    .match-card-main { flex: 1; min-width: 0; }
    .match-card-title { font-size: var(--text-md); font-weight: var(--weight-semibold); color: var(--color-ink); }
    .match-card-reason { font-size: var(--text-sm); color: var(--color-ink-2); margin-top: var(--space-1); line-height: var(--leading-relaxed); }
    .match-card-score { text-align: right; flex-shrink: 0; }

    /* 合作历史 timeline */
    .collab-timeline { display: flex; flex-direction: column; }
    .collab-timeline-item { display: flex; gap: var(--space-3); padding-bottom: var(--space-4); position: relative; }
    .collab-timeline-item:not(:last-child)::after { content: ''; position: absolute; left: 7px; top: 20px; bottom: 0; width: 1px; background: var(--color-line); }
    .collab-timeline-dot { width: 14px; height: 14px; border-radius: 50%; background: var(--color-surface); border: 2px solid var(--color-accent); flex-shrink: 0; margin-top: 4px; }
    .collab-timeline-main { flex: 1; min-width: 0; }
    .collab-timeline-title { font-size: var(--text-md); color: var(--color-ink); font-weight: var(--weight-medium); }
    .collab-timeline-meta { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; }
    .collab-timeline-desc { font-size: var(--text-sm); color: var(--color-ink-2); margin-top: var(--space-1); }
    /* 身份卡 (9 种运营身份) */
    .identity-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); }
    .identity-card { padding: var(--space-3); border: 1px solid var(--color-line); border-radius: var(--radius-sm); background: var(--color-surface); transition: all var(--dur-fast) var(--ease-out); cursor: pointer; }
    .identity-card:hover { border-color: var(--color-line-2); background: var(--color-surface-2); }
    .identity-card.is-current { border-color: var(--color-accent); background: var(--color-accent-softer); box-shadow: 0 0 0 1px var(--color-accent); }
    .identity-icon { width: 32px; height: 32px; border-radius: var(--radius-sm); background: var(--color-accent-soft); color: var(--color-accent); display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-2); }
    .identity-name { font-size: var(--text-sm); font-weight: var(--weight-semibold); color: var(--color-ink); }
    .identity-duty { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; }
    .identity-limit { font-size: 11px; color: var(--color-warn-2); margin-top: var(--space-2); padding-top: var(--space-2); border-top: 1px solid var(--color-line); }

    /* 客户授权视角 - 只能在 Active 窗口内看到 */
    .auth-customer-list { display: flex; flex-direction: column; }
    .auth-customer-row { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr auto; gap: var(--space-3); align-items: center; padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--color-line); }
    .auth-customer-row:last-child { border-bottom: none; }
    .auth-customer-row:hover { background: var(--color-surface-2); }
    .auth-customer-row.is-locked { opacity: 0.5; background: var(--color-surface-2); }
    .lock-icon { color: var(--color-ink-4); }

    /* 数据边界 - 可见/不可见 */
    .data-boundary { display: grid; grid-template-columns: 1fr auto 1fr; gap: var(--space-4); align-items: start; }
    .data-boundary-list { padding: var(--space-3); border-radius: var(--radius-sm); font-size: var(--text-sm); }
    .data-boundary-allow { background: var(--color-success-soft); border: 1px solid var(--color-success-soft); }
    .data-boundary-deny { background: var(--color-danger-soft); border: 1px solid var(--color-danger-soft); }
    .data-boundary-list ul { list-style: none; padding: 0; margin: 0; }
    .data-boundary-list li { padding: 4px 0; color: var(--color-ink-2); }
    .data-boundary-arrow { color: var(--color-ink-3); align-self: center; }

    /* 资质状态 */
    .qual-pill { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: var(--radius-pill); font-size: 11px; font-weight: var(--weight-medium); }
    .qual-active { background: var(--color-success-soft); color: var(--color-success); }
