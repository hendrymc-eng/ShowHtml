<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>4499 · 全球商业关系与信任匹配引擎</title>
  <meta name="description" content="4499 平台 · Opulrich 生态中的会员成功与生态运营平台。连接商业关系、构建长期信任、智能匹配专业协作。" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="../css/tokens.css" />
  <link rel="stylesheet" href="../css/components.css" />
  <link rel="stylesheet" href="../css/brand-anim.css" />
  <style>
    /* Hallmark · macrostructure: Marquee Hero + 紧凑 page-section · tone: modern-minimal · anchor hue: Cobalt oklch(48% 0.18 255) · system-managed (design.md v1.0 · 2026-08-08) */
    /* === 官网独立 chrome（不接 app sidebar/topbar） === */
    body { background: var(--color-paper); }
    .site-nav {
      position: sticky;
      top: 0;
      z-index: 50;
      background: var(--color-paper);
      border-bottom: 1px solid var(--color-line);
      backdrop-filter: saturate(180%) blur(8px);
    }
    .site-nav-inner {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 var(--space-6);
      height: 64px;
      display: flex;
      align-items: center;
      gap: var(--space-8);
    }
    .site-brand {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-family: var(--font-display);
      font-weight: var(--weight-semibold);
      font-size: var(--text-lg);
      color: var(--color-ink);
      text-decoration: none;
      letter-spacing: -0.01em;
    }
    .site-brand-mark {
      width: 28px; height: 28px;
      border-radius: var(--radius-sm);
      background: linear-gradient(135deg, var(--color-accent), var(--color-accent-2));
      color: var(--color-accent-ink);
      display: inline-flex; align-items: center; justify-content: center;
      font-weight: var(--weight-bold);
      font-size: var(--text-sm);
      font-family: var(--font-display);
    }
    .site-menu {
      display: flex;
      align-items: center;
      gap: var(--space-1);
      flex: 1;
    }
    .site-menu a {
      padding: var(--space-2) var(--space-3);
      border-radius: var(--radius-sm);
      color: var(--color-ink-2);
      font-size: var(--text-md);
      font-weight: var(--weight-medium);
      text-decoration: none;
      transition: color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
    }
    .site-menu a:hover { color: var(--color-ink); background: var(--color-surface-2); }
    .site-menu a.is-current { color: var(--color-ink); }
    .site-actions { display: flex; align-items: center; gap: var(--space-2); }
    .nav-toggle { display: none; }

    /* === Hero === */
    .hero { padding: var(--space-10) 0 0;
      position: relative;
      overflow: hidden;
    }
    .hero-grid-bg {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      background-image:
        linear-gradient(to right, var(--color-line) 1px, transparent 1px),
        linear-gradient(to bottom, var(--color-line) 1px, transparent 1px);
      background-size: 48px 48px;
      mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 30%, transparent 80%);
      -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 30%, transparent 80%);
      opacity: 0.5;
    }
    .hero-inner {
      position: relative;
      z-index: 1;
      max-width: 880px;
      margin: 0 auto;
      padding: 0 var(--space-6);
      text-align: center;
    }
    .hero-eyebrow {
      display: inline-flex; align-items: center; gap: var(--space-2);
      font-size: var(--text-xs);
      font-weight: var(--weight-medium);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-accent);
      padding: 6px var(--space-3);
      background: var(--color-accent-soft);
      border: 1px solid var(--color-accent-soft);
      border-radius: var(--radius-pill);
      margin-bottom: var(--space-4);
    }
    .hero-eyebrow-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-accent); }
    .hero-title {
      font-family: var(--font-display);
      font-size: var(--text-display);
      font-weight: var(--weight-semibold);
      color: var(--color-ink);
      line-height: 1.05;
      letter-spacing: -0.025em;
      margin: 0 0 var(--space-3);
    }
    .hero-subtitle {
      font-size: var(--text-lg);
      color: var(--color-ink-2);
      line-height: var(--leading-relaxed);
      max-width: 640px;
      margin: 0 auto var(--space-4);
    }
    .hero-cta { display: flex; gap: var(--space-3); flex-wrap: wrap; justify-content: center; }
    .hero-trustline {
      margin-top: var(--space-4);
      padding-top: var(--space-4);
      border-top: 1px solid var(--color-line);
      display: flex; align-items: center; justify-content: center; gap: var(--space-6);
      font-size: var(--text-sm);
      color: var(--color-ink-3);
      flex-wrap: wrap;
    }
    .hero-trustline strong { color: var(--color-ink); font-weight: var(--weight-semibold); }

    /* GSAP 兜底：hero 元素初始 opacity 0.85（动画未触发或中断时仍可见） */
    .hero-eyebrow, .hero-subtitle, .hero-cta, .hero-trustline { opacity: 0.85; }

    /* === Section base === */
    .page-section { padding: var(--space-10) 0; }
    .page-section:first-of-type { padding-top: var(--space-6); }
    /* hero 紧邻的 page-section 紧凑处理（替代 :first-of-type，因为 hero 也是 section） */
    .hero + .page-section { padding-top: var(--space-3); padding-bottom: var(--space-6); }
    .page-section + .page-section { border-top: 1px solid var(--color-line); }
    .container {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 var(--space-6);
    }

    /* === Section 1: Metrics Strip（紧凑横排，无 section-head） === */
    .metrics-strip {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      background: var(--color-surface);
      border: 1px solid var(--color-line);
      border-radius: var(--radius-lg);
      overflow: hidden;
    }
    .metric-cell {
      padding: var(--space-5) var(--space-6);
      border-right: 1px solid var(--color-line);
      transition: background 200ms ease;
    }
    .metric-cell:last-child { border-right: none; }
    .metric-cell:hover { background: var(--color-surface-2); }
    .metric-cell-label {
      font-size: var(--text-xs);
      color: var(--color-ink-3);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: var(--space-2);
    }
    .metric-cell-value {
      font-family: var(--font-display);
      font-size: var(--text-3xl);
      font-weight: var(--weight-semibold);
      color: var(--color-ink);
      line-height: 1.1;
      letter-spacing: -0.02em;
      margin-bottom: var(--space-2);
    }
    .metric-cell-value.is-pending {
      font-size: var(--text-xl);
      color: var(--color-ink-3);
      font-weight: var(--weight-regular);
    }
    .metric-cell-note {
      font-size: var(--text-xs);
      color: var(--color-ink-3);
      line-height: 1.5;
    }
    @media (max-width: 1024px) {
      .metrics-strip { grid-template-columns: repeat(2, 1fr); }
      .metric-cell:nth-child(2) { border-right: none; }
      .metric-cell:nth-child(1), .metric-cell:nth-child(2) { border-bottom: 1px solid var(--color-line); }
    }
    @media (max-width: 640px) {
      .metrics-strip { grid-template-columns: 1fr; }
      .metric-cell { border-right: none; border-bottom: 1px solid var(--color-line); }
      .metric-cell:last-child { border-bottom: none; }
    }

    /* === Legacy Metrics grid (保留给其它场景) === */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-4);
    }
    .metric-card {
      background: var(--color-surface);
      border: 1px solid var(--color-line);
      border-radius: var(--radius-md);
      padding: var(--space-5);
    }
    .metric-label { font-size: var(--text-sm); color: var(--color-ink-3); margin-bottom: var(--space-3); }
    .metric-value {
      font-family: var(--font-display);
      font-size: var(--text-4xl);
      font-weight: var(--weight-semibold);
      color: var(--color-ink);
      line-height: 1;
      letter-spacing: -0.02em;
      margin-bottom: var(--space-2);
    }
    .metric-note { font-size: var(--text-sm); color: var(--color-ink-3); }

    /* === Value props (2x2) === */
    .value-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
      margin-top: var(--space-4);
    }
    .value-card {
      background: var(--color-surface);
      border: 1px solid var(--color-line);
      border-radius: var(--radius-md);
      padding: var(--space-5);
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    .value-icon {
      width: 36px; height: 36px;
      border-radius: var(--radius-sm);
      background: var(--color-accent-soft);
      color: var(--color-accent);
      display: inline-flex; align-items: center; justify-content: center;
      margin-bottom: var(--space-2);
    }
    .value-title { font-family: var(--font-display); font-size: var(--text-xl); font-weight: var(--weight-semibold); color: var(--color-ink); margin: 0; letter-spacing: -0.01em; }
    .value-desc { font-size: var(--text-md); color: var(--color-ink-2); line-height: var(--leading-relaxed); margin: 0; }

    /* === 8 trust dimensions (4x2) === */
    .trust-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-4);
      margin-top: var(--space-6);
    }
    .trust-card {
      background: var(--color-surface);
      border: 1px solid var(--color-line);
      border-radius: var(--radius-md);
      padding: var(--space-5);
    }
    .trust-num {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      color: var(--color-ink-4);
      letter-spacing: 0.08em;
      margin-bottom: var(--space-3);
    }
    .trust-title { font-size: var(--text-md); font-weight: var(--weight-semibold); color: var(--color-ink); margin: 0 0 var(--space-2); }
    .trust-desc { font-size: var(--text-sm); color: var(--color-ink-2); line-height: var(--leading-relaxed); margin: 0; }

    /* === AI Matching (split) === */
    .ai-split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-12);
      align-items: center;
      margin-top: var(--space-4);
    }
    .ai-visual {
      background: var(--color-surface);
      border: 1px solid var(--color-line);
      border-radius: var(--radius-lg);
      padding: var(--space-5);
      aspect-ratio: 4 / 3;
    }
    .ai-visual svg { width: 100%; height: 100%; display: block; }
    .ai-list { list-style: none; padding: 0; margin: var(--space-6) 0 0; display: flex; flex-direction: column; gap: var(--space-4); }
    .ai-list-item { display: flex; gap: var(--space-3); align-items: flex-start; }
    .ai-list-mark {
      width: 22px; height: 22px;
      flex-shrink: 0;
      border-radius: 50%;
      background: var(--color-accent-soft);
      color: var(--color-accent);
      display: inline-flex; align-items: center; justify-content: center;
      font-size: var(--text-xs);
      font-weight: var(--weight-semibold);
    }
    .ai-list-text { font-size: var(--text-md); color: var(--color-ink-2); line-height: var(--leading-relaxed); padding-top: 1px; }

    /* === Logo wall (cases) === */
    .case-row { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-4); }
    .case-tile {
      flex: 1 1 calc(50% - var(--space-4));
      min-width: 260px;
      background: var(--color-surface);
      border: 1px solid var(--color-line);
      border-radius: var(--radius-md);
      padding: var(--space-5);
    }
    .case-logo {
      width: 40px; height: 40px;
      border-radius: var(--radius-sm);
      background: var(--color-surface-2);
      color: var(--color-ink-3);
      display: inline-flex; align-items: center; justify-content: center;
      font-family: var(--font-display);
      font-weight: var(--weight-semibold);
      font-size: var(--text-sm);
      margin-bottom: var(--space-4);
    }
    .case-title { font-size: var(--text-md); font-weight: var(--weight-semibold); color: var(--color-ink); margin: 0 0 var(--space-2); }
    .case-meta { font-size: var(--text-sm); color: var(--color-ink-3); margin: 0 0 var(--space-3); }
    .case-link { font-size: var(--text-sm); color: var(--color-accent); text-decoration: none; font-weight: var(--weight-medium); }
    .case-link::after { content: ' →'; }

    .logo-strip {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: var(--space-4);
      margin-top: var(--space-8);
      padding: var(--space-5) 0;
      border-top: 1px solid var(--color-line);
      border-bottom: 1px solid var(--color-line);
    }
    .logo-strip-item {
      height: 40px;
      display: flex; align-items: center; justify-content: center;
      color: var(--color-ink-4);
      font-family: var(--font-display);
      font-weight: var(--weight-semibold);
      font-size: var(--text-sm);
      letter-spacing: 0.04em;
    }

    /* === CTA band === */
    .cta-band {
      background: var(--color-ink);
      color: var(--color-ink-inv);
      padding: var(--space-20) 0;
    }
    .cta-band-inner {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 var(--space-6);
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: var(--space-12);
      align-items: center;
    }
    .cta-band-eyebrow { color: var(--color-ink-4); margin-bottom: var(--space-3); display: block; }
    .cta-band-title { font-size: var(--text-3xl); font-weight: var(--weight-semibold); color: var(--color-ink-inv); margin: 0; letter-spacing: -0.02em; }
    .cta-band-actions { display: flex; gap: var(--space-3); justify-content: flex-end; flex-wrap: wrap; }
    .btn-on-dark { background: var(--color-ink-inv); color: var(--color-ink); }
    .btn-on-dark:hover { background: var(--color-surface-2); }
    .btn-on-dark-outline { background: transparent; color: var(--color-ink-inv); border-color: var(--color-line-3); }
    .btn-on-dark-outline:hover { background: rgba(255,255,255,0.08); }

    /* === Footer === */
    .site-footer {
      background: var(--color-surface);
      border-top: 1px solid var(--color-line);
      padding: var(--space-16) 0 var(--space-8);
    }
    .footer-grid {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 var(--space-6);
      display: grid;
      grid-template-columns: 1.5fr repeat(4, 1fr);
      gap: var(--space-8);
    }
    .footer-brand-block { display: flex; flex-direction: column; gap: var(--space-3); }
    .footer-tagline { font-size: var(--text-sm); color: var(--color-ink-2); line-height: var(--leading-relaxed); max-width: 280px; }
    .footer-social { display: flex; gap: var(--space-2); margin-top: var(--space-2); }
    .footer-social a {
      width: 32px; height: 32px;
      border-radius: var(--radius-sm);
      background: var(--color-surface-2);
      color: var(--color-ink-2);
      display: inline-flex; align-items: center; justify-content: center;
      text-decoration: none;
      transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
    }
    .footer-social a:hover { background: var(--color-accent-soft); color: var(--color-accent); }
    .footer-col h4 {
      font-size: var(--text-xs);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-ink-3);
      font-weight: var(--weight-medium);
      margin: 0 0 var(--space-3);
    }
    .footer-col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-2); }
    .footer-col a { font-size: var(--text-sm); color: var(--color-ink-2); text-decoration: none; }
    .footer-col a:hover { color: var(--color-ink); }
    .footer-bottom {
      max-width: var(--container-max);
      margin: var(--space-12) auto 0;
      padding: var(--space-6) var(--space-6) 0;
      border-top: 1px solid var(--color-line);
      display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-3);
      font-size: var(--text-sm);
      color: var(--color-ink-3);
    }
    .footer-bottom-links { display: flex; gap: var(--space-4); }
    .footer-bottom-links a { color: var(--color-ink-3); text-decoration: none; }
    .footer-bottom-links a:hover { color: var(--color-ink); }

    /* === Responsive === */
    @media (max-width: 1200px) {
      .hero-title { font-size: 56px; }
      .trust-grid { grid-template-columns: repeat(2, 1fr); }
      .logo-strip { grid-template-columns: repeat(3, 1fr); }
      .footer-grid { grid-template-columns: 1.5fr repeat(2, 1fr); }
    }
    @media (max-width: 1024px) {
      .hero-inner { grid-template-columns: 1fr; gap: var(--space-10); }
      .hero-decor { max-width: 420px; margin: 0; }
      .ai-split { grid-template-columns: 1fr; }
      .metrics-grid { grid-template-columns: repeat(2, 1fr); }
      .cta-band-inner { grid-template-columns: 1fr; }
      .cta-band-actions { justify-content: flex-start; }
    }
    @media (max-width: 768px) {
      .site-menu { display: none; }
      .nav-toggle { display: inline-flex; }
      .site-actions .btn-text-hide { display: none; }
      .hero { padding: var(--space-14) 0 var(--space-10); }
      .hero-title { font-size: 40px; }
      .page-section { padding: var(--space-12) 0; }
      .value-grid { grid-template-columns: 1fr; }
      .trust-grid { grid-template-columns: 1fr; }
      .logo-strip { grid-template-columns: repeat(2, 1fr); }
      .footer-grid { grid-template-columns: 1fr 1fr; }
      .footer-brand-block { grid-column: span 2; }
    }
    @media (max-width: 480px) {
      .hero-title { font-size: 34px; }
      .hero-trustline { flex-direction: column; align-items: flex-start; gap: var(--space-2); }
      .metrics-grid { grid-template-columns: 1fr; }
      .case-tile { flex-basis: 100%; }
      .footer-grid { grid-template-columns: 1fr; }
      .footer-brand-block { grid-column: span 1; }
    }

    /* Reduced motion 兼容 */
    @media (prefers-reduced-motion: reduce) {
      * { transition-duration: 0.01ms !important; }
    }
  </style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
