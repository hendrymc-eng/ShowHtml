  <style>
    /* 授权流程图（5 步骤进度条） */
    .auth-flow { display: grid; grid-template-columns: repeat(5, 1fr); gap: var(--space-3); }
    .auth-flow-step { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-md); padding: var(--space-4); text-align: center; position: relative; }
    .auth-flow-step.is-done { background: var(--color-success-soft); border-color: var(--color-success-soft); }
    .auth-flow-step.is-current { background: var(--color-accent-softer); border-color: var(--color-accent); box-shadow: 0 0 0 3px var(--color-accent-soft); }
    .auth-flow-num { width: 32px; height: 32px; border-radius: 50%; background: var(--color-surface-2); color: var(--color-ink-3); display: inline-flex; align-items: center; justify-content: center; font-weight: var(--weight-semibold); font-size: var(--text-md); margin-bottom: var(--space-2); }
    .auth-flow-step.is-done .auth-flow-num { background: var(--color-success); color: var(--color-ink-inv); }
    .auth-flow-step.is-current .auth-flow-num { background: var(--color-accent); color: var(--color-accent-ink); }
    .auth-flow-label { font-size: var(--text-sm); color: var(--color-ink); font-weight: var(--weight-medium); }
    .auth-flow-meta { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: var(--space-1); }

    /* 授权矩阵 */
    .auth-matrix { font-size: var(--text-sm); }
    .auth-matrix-head { background: var(--color-surface-2); font-weight: var(--weight-medium); font-size: var(--text-xs); color: var(--color-ink-3); text-transform: uppercase; letter-spacing: 0.04em; padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--color-line); }
    .auth-matrix-row { display: grid; grid-template-columns: 1.5fr 1fr 1.5fr 1fr; padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--color-line); align-items: center; }
    .auth-matrix-row:last-child { border-bottom: none; }
    .auth-matrix-row:hover { background: var(--color-surface-2); }
    .auth-matrix-row.is-selected { background: var(--color-accent-soft); box-shadow: inset 2px 0 0 var(--color-accent); }

    /* 即将到期卡片 */
    .expiry-card { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-4); background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-md); }
    .expiry-card.is-warn { border-color: var(--color-warn-soft); background: var(--color-warn-soft); }
    .expiry-day { font-family: var(--font-display); font-size: var(--text-2xl); font-weight: var(--weight-semibold); color: var(--color-warn-2); }
    .expiry-info { flex: 1; min-width: 0; }
    .expiry-title { font-size: var(--text-md); color: var(--color-ink); font-weight: var(--weight-medium); }
    .expiry-meta { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; }
  </style>
</head>
