  <style>
    .apply-layout { display: grid; grid-template-columns: 1fr 320px; gap: var(--space-6); align-items: start; }
    @media (max-width: 1280px) { .apply-layout { grid-template-columns: 1fr; } .apply-side { display: none; } }
    .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
    @media (max-width: 768px) { .field-row { grid-template-columns: 1fr; } }
    .check-group { display: flex; gap: var(--space-2); flex-wrap: wrap; margin-top: var(--space-2); }
    .check-pill {
      display: inline-flex; align-items: center; gap: var(--space-2);
      padding: 6px 12px;
      border: 1px solid var(--color-line-2);
      border-radius: var(--radius-pill);
      cursor: pointer;
      font-size: var(--text-sm);
      transition: all var(--dur-fast) var(--ease-out);
    }
    .check-pill:hover { border-color: var(--color-line-3); background: var(--color-surface-2); }
    .check-pill.is-active { background: var(--color-accent-soft); border-color: var(--color-accent); color: var(--color-accent); }
    .check-pill input { display: none; }
    .check-box { display: flex; align-items: flex-start; gap: var(--space-2); padding: var(--space-3); border: 1px solid var(--color-line); border-radius: var(--radius-sm); cursor: pointer; transition: all var(--dur-fast) var(--ease-out); }
    .check-box:hover { background: var(--color-surface-2); }
    .check-box.is-active { background: var(--color-accent-soft); border-color: var(--color-accent); }
    .check-box input { display: none; }
    .check-box-icon { width: 32px; height: 32px; border-radius: var(--radius-sm); background: var(--color-surface-2); color: var(--color-ink-3); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .check-box.is-active .check-box-icon { background: var(--color-accent); color: var(--color-accent-ink); }
    .check-box-title { font-size: var(--text-md); font-weight: var(--weight-medium); color: var(--color-ink); }
    .check-box-desc { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; }
    .help-box { padding: var(--space-3); background: var(--color-info-soft); border-radius: var(--radius-sm); border-left: 3px solid var(--color-info); margin-top: var(--space-2); }
    .help-box-text { font-size: var(--text-sm); color: var(--color-ink-2); }
    .warn-box { padding: var(--space-3); background: var(--color-warn-softer); border-radius: var(--radius-sm); border-left: 3px solid var(--color-warn); margin-top: var(--space-2); }
    .warn-box-text { font-size: var(--text-sm); color: var(--color-ink-2); }

    /* B1 增强 */
    .required-mark { color: var(--color-danger); margin-left: 2px; }
    .form-error-hint { color: var(--color-danger); font-size: var(--text-xs); margin-top: var(--space-1); min-height: 14px; }
    .step.is-clickable { cursor: pointer; }
    .step.is-clickable:hover .step-circle { background: var(--color-accent-soft); color: var(--color-accent); border-color: var(--color-accent); }
    @keyframes grow-bar { from { width: 0 !important; } }
    .progress-bar.animate-in { animation: grow-bar 900ms var(--ease-out) forwards; }

    /* B2 新增：申请时间线 / 模板 / 案例 / 资源 / 费用 */
    .timeline-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; margin-top: var(--space-3); position: relative; }
    .timeline-4::before { content: ''; position: absolute; top: 18px; left: 12%; right: 12%; height: 2px; background: var(--color-line); z-index: 0; }
    .timeline-step { position: relative; z-index: 1; text-align: center; padding: 0 var(--space-2); }
    .timeline-step-circle { width: 36px; height: 36px; border-radius: 50%; background: var(--color-surface); border: 2px solid var(--color-line-2); color: var(--color-ink-3); display: inline-flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-size: var(--text-md); font-weight: var(--weight-semibold); margin: 0 auto var(--space-2); }
    .timeline-step.is-done .timeline-step-circle { background: var(--color-success); border-color: var(--color-success); color: var(--color-ink-inv); }
    .timeline-step.is-current .timeline-step-circle { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-accent-ink); box-shadow: 0 0 0 4px var(--color-accent-soft); }
    .timeline-step-title { font-size: var(--text-sm); font-weight: var(--weight-medium); color: var(--color-ink); }
    .timeline-step-desc { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; line-height: var(--leading-snug); }
    .timeline-step-time { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: var(--space-1); font-family: var(--font-mono); }

    .template-card { padding: var(--space-3); border: 1px solid var(--color-line); border-radius: var(--radius-md); background: var(--color-surface); cursor: pointer; transition: all var(--dur-fast) var(--ease-out); }
    .template-card:hover { border-color: var(--color-accent); background: var(--color-accent-softer); }
    .template-card-title { font-size: var(--text-md); font-weight: var(--weight-medium); color: var(--color-ink); display: flex; align-items: center; gap: var(--space-2); }
    .template-card-desc { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: var(--space-1); line-height: var(--leading-snug); }
    .template-card-meta { display: flex; gap: var(--space-2); margin-top: var(--space-2); font-size: var(--text-xs); color: var(--color-ink-3); }
    .template-card-meta-tag { padding: 1px 6px; background: var(--color-surface-2); border-radius: var(--radius-xs); }

    .case-item { padding: var(--space-3); border-left: 2px solid var(--color-line-2); background: var(--color-surface); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; }
    .case-item-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); }
    .case-item-type { font-size: var(--text-md); font-weight: var(--weight-medium); color: var(--color-ink); }
    .case-item-time { font-size: var(--text-xs); color: var(--color-ink-3); font-family: var(--font-mono); }
    .case-item-meta { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: var(--space-1); }

    .resource-row { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3); border: 1px solid var(--color-line); border-radius: var(--radius-sm); background: var(--color-surface); }
    .resource-row + .resource-row { margin-top: var(--space-2); }
    .resource-status-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-success); flex-shrink: 0; }
    .resource-status-dot.is-warn { background: var(--color-warn); }
    .resource-status-dot.is-busy { background: var(--color-danger); }
    .resource-row-main { flex: 1; min-width: 0; }
    .resource-row-name { font-size: var(--text-sm); font-weight: var(--weight-medium); color: var(--color-ink); }
    .resource-row-meta { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; }

    .fee-table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
    .fee-table th { text-align: left; padding: var(--space-2) var(--space-3); font-weight: var(--weight-medium); color: var(--color-ink-3); border-bottom: 1px solid var(--color-line); font-size: var(--text-xs); }
    .fee-table td { padding: var(--space-3); border-bottom: 1px solid var(--color-line); vertical-align: top; }
    .fee-table tr:last-child td { border-bottom: none; }
    .fee-cat { font-weight: var(--weight-medium); color: var(--color-ink); }
    .fee-range { font-family: var(--font-mono); color: var(--color-ink); }
    .fee-note { color: var(--color-ink-3); font-size: var(--text-xs); margin-top: 2px; }
