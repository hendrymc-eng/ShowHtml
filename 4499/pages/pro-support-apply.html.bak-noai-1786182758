<script src="../js/app.js"></script>
<script>
  // B1 增强：进度条入场动画
  (function () {
    var bars = document.querySelectorAll('.progress-bar');
    if ('IntersectionObserver' in window) {
      var obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('animate-in'); obs.unobserve(e.target); } });
      }, { threshold: 0.3 });
      bars.forEach(function (b) { obs.observe(b); });
    }
  })();

  // B1 增强：步骤切换
  (function () {
    var steps = document.querySelectorAll('#apply-steps .step');
    var sections = document.querySelectorAll('.apply-layout > div > section');
    function setStep(idx) {
      steps.forEach(function (s, i) {
        s.classList.remove('is-current', 'is-done', 'is-clickable');
        s.classList.add('is-clickable');
        if (i < idx - 1) s.classList.add('is-done');
        if (i === idx - 1) s.classList.add('is-current');
      });
      sections.forEach(function (sec, i) {
        // 只对 step 1-4 对应的 4 个 section 生效（顺序：客户确认 / 服务内容 / 授权范围 / 确认）
        if (i < 4) sec.style.display = (i === idx - 1) ? '' : (i < idx - 1 ? '' : 'none');
      });
      // 滚动到当前
      var cur = document.querySelector('#apply-steps .step.is-current');
      if (cur) cur.scrollIntoView({ behavior: 'smooth', block: 'center' });
      toast('已切换到步骤 ' + idx, 'info');
    }
    steps.forEach(function (s) {
      s.addEventListener('click', function () {
        var idx = parseInt(s.getAttribute('data-step'), 10);
        setStep(idx);
      });
    });

    // 上下一步按钮
    document.addEventListener('click', function (e) {
      var a = e.target.closest('[data-action]');
      if (!a) return;
      var action = a.getAttribute('data-action');
      var current = document.querySelector('#apply-steps .step.is-current');
      var idx = current ? parseInt(current.getAttribute('data-step'), 10) : 2;
      if (action === 'next-step') {
        if (idx < 4) setStep(idx + 1);
      } else if (action === 'prev-step') {
        if (idx > 1) setStep(idx - 1);
      } else if (action === 'save-draft') {
        toast('草稿已保存', 'success');
      } else if (action === 'cancel-apply') {
        if (confirm('确定取消当前申请？已填内容会丢失。')) {
          toast('已取消申请', 'warn');
        }
      } else if (action === 'open-confirm') {
        if (!validateForm()) { toast('请填写所有必填项', 'error'); return; }
        var m = document.getElementById('modal-confirm-submit');
        if (m) {
          m.classList.add('is-open');
          var bd = document.querySelector('[data-modal-backdrop="modal-confirm-submit"]');
          if (bd) bd.classList.add('is-open');
          document.body.style.overflow = 'hidden';
        }
      } else if (action === 'final-submit') {
        toast('已提交申请，AI 匹配中...', 'info');
        setTimeout(function () {
          var m = document.getElementById('modal-confirm-submit');
          if (m) m.classList.remove('is-open');
          var bd = document.querySelector('[data-modal-backdrop="modal-confirm-submit"]');
          if (bd) bd.classList.remove('is-open');
          document.body.style.overflow = '';
        }, 700);
      }
    });

    // 表单验证
    function validateForm() {
      var fields = document.querySelectorAll('[data-validate]');
      var ok = true;
      fields.forEach(function (f) {
        var v = f.value.trim();
        var name = f.getAttribute('name') || f.getAttribute('data-validate') || f.getAttribute('name');
        var errEl = document.querySelector('[data-error-for="' + (f.getAttribute('name') || '') + '"]');
        if (!v) {
          f.setAttribute('data-state', 'error');
          if (errEl) errEl.textContent = '此项必填';
          ok = false;
        } else {
          f.removeAttribute('data-state');
          if (errEl) errEl.textContent = '';
        }
      });
      return ok;
    }

    // 失焦实时验证
    document.querySelectorAll('[data-validate]').forEach(function (f) {
      f.addEventListener('blur', function () {
        var v = f.value.trim();
        var name = f.getAttribute('name') || '';
        var errEl = document.querySelector('[data-error-for="' + name + '"]');
        if (!v) {
          f.setAttribute('data-state', 'error');
          if (errEl) errEl.textContent = '此项必填';
        } else {
          f.removeAttribute('data-state');
          if (errEl) errEl.textContent = '';
        }
      });
      f.addEventListener('input', function () {
        if (f.getAttribute('data-state') === 'error' && f.value.trim()) {
          f.removeAttribute('data-state');
          var errEl = document.querySelector('[data-error-for="' + (f.getAttribute('name') || '') + '"]');
          if (errEl) errEl.textContent = '';
        }
      });
    });

    // 暴露给外部
    window._validateApplyForm = validateForm;
  })();

  // B1 增强：客户卡片修改、check pill 切换 toast
  document.querySelectorAll('.check-pill.js-check-pill').forEach(function (pill) {
    pill.addEventListener('click', function () {
      setTimeout(function () {
        var title = pill.textContent.trim();
        if (title.includes('企业') || title.includes('成长') || title.includes('AI') || title.includes('RWA') || title.includes('黄金') || title.includes('再生营')) {
          toast('已选服务类型：' + title, 'info');
        }
      }, 50);
    });
  });

  // B1 增强：AI 预匹配卡点击查看匹配
  document.querySelectorAll('.apply-side .card').forEach(function (c) {
    if (c.querySelector('.avatar')) {
      c.style.cursor = 'pointer';
      c.addEventListener('click', function () {
        var name = c.querySelector('.text-sm.fw-medium');
        if (name) toast('查看 ' + name.textContent.trim() + ' 的匹配详情', 'info');
