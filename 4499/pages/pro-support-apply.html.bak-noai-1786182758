    }
  });

  // B2 新增：申请模板点击 → 一键填入
  document.querySelectorAll('[data-action="apply-template"]').forEach(function (tpl) {
    tpl.addEventListener('click', function () {
      var key = tpl.getAttribute('data-template');
      var title = tpl.querySelector('.template-card-title');
      toast('已套用模板：' + (title ? title.textContent.trim() : key), 'success');
    });
  });

  // B2 新增：资源对接卡点击
  document.querySelectorAll('.resource-row').forEach(function (row) {
    row.style.cursor = 'pointer';
    row.addEventListener('click', function () {
      var name = row.querySelector('.resource-row-name');
      if (name) toast(name.textContent.trim() + ' · 可在 24 小时内响应', 'info');
    });
  });
</script>
