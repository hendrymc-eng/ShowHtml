  <style>
    .profile-hero { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-md); padding: var(--space-6); display: grid; grid-template-columns: auto 1fr auto; gap: var(--space-6); align-items: center; }
    @media (max-width: 768px) { .profile-hero { grid-template-columns: 1fr; } }
    .dim-bar { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3) 0; }
    .dim-bar + .dim-bar { border-top: 1px solid var(--color-line); }
    .dim-name { font-size: var(--text-sm); color: var(--color-ink-2); width: 120px; flex-shrink: 0; }
    .dim-bar-track { flex: 1; }
    .dim-score { font-family: var(--font-mono); font-weight: var(--weight-semibold); font-size: var(--text-md); color: var(--color-ink); width: 40px; text-align: right; }
    .tag-cloud { display: flex; flex-wrap: wrap; gap: var(--space-2); }
    .timeline { display: flex; flex-direction: column; }
    .timeline-item { display: flex; gap: var(--space-3); padding-bottom: var(--space-4); position: relative; }
    .timeline-item:not(:last-child)::after { content: ''; position: absolute; left: 7px; top: 18px; bottom: 0; width: 1px; background: var(--color-line); }
    .timeline-dot { width: 14px; height: 14px; border-radius: 50%; background: var(--color-surface); border: 2px solid var(--color-accent); flex-shrink: 0; margin-top: 4px; }
    .timeline-item-done .timeline-dot { background: var(--color-accent); }
    .timeline-item-current .timeline-dot { background: var(--color-warn); border-color: var(--color-warn); }
    .timeline-title { font-size: var(--text-md); color: var(--color-ink); }
    .timeline-meta { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; }

    /* 联系记录 5 项必填 (PRD CRM-006) */
    .contact-form { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: var(--space-3); }
    .contact-form-field { display: flex; flex-direction: column; gap: 4px; }
    .contact-form-label { font-size: var(--text-xs); color: var(--color-ink-3); font-weight: var(--weight-medium); }
    .contact-form-label .req { color: var(--color-danger); }
    .contact-form-input, .contact-form-select, .contact-form-textarea {
      padding: 8px 10px; border: 1px solid var(--color-line); border-radius: var(--radius-sm);
      font-size: var(--text-sm); background: var(--color-surface); color: var(--color-ink);
      font-family: inherit;
    }
    .contact-form-textarea { min-height: 60px; resize: vertical; }

    /* 联系方式审计提示 (PRD CRM-010 / §3.4) */
    .export-watermark-notice {
      padding: var(--space-3); background: var(--color-warn-soft);
      border: 1px solid var(--color-warn-soft); border-radius: var(--radius-sm);
      font-size: var(--text-xs); color: var(--color-ink-2);
    }
    .export-watermark-notice strong { color: var(--color-ink); }
    .audit-log-entry { display: grid; grid-template-columns: 140px 1fr 1fr; gap: var(--space-3); padding: var(--space-2) 0; border-bottom: 1px solid var(--color-line); font-size: var(--text-xs); }
    .audit-log-entry:last-child { border-bottom: none; }
    .audit-log-time { font-family: var(--font-mono); color: var(--color-ink-3); }
    .audit-log-actor { color: var(--color-ink); font-weight: var(--weight-medium); }
    .audit-log-action { color: var(--color-ink-2); }

    /* 字段来源标签 (PRD PRO-003) */
    .field-source { display: inline-flex; align-items: center; gap: 2px; padding: 1px 6px; border-radius: var(--radius-xs); font-size: 10px; font-weight: var(--weight-medium); margin-left: 4px; vertical-align: middle; }
    .field-source-self { background: var(--color-surface-2); color: var(--color-ink-2); }
    .field-source-platform { background: var(--color-info-soft); color: var(--color-info); }
    .field-source-verified { background: var(--color-success-soft); color: var(--color-success); }
    .field-source-ai { background: var(--color-accent-soft); color: var(--color-accent); }
    .field-verified-badge { display: inline-flex; align-items: center; gap: 2px; padding: 1px 6px; background: var(--color-success-soft); color: var(--color-success); border-radius: var(--radius-xs); font-size: 10px; font-weight: var(--weight-semibold); margin-left: 4px; vertical-align: middle; }
    .field-unverified-badge { display: inline-flex; align-items: center; gap: 2px; padding: 1px 6px; background: var(--color-surface-2); color: var(--color-ink-3); border: 1px dashed var(--color-line-2); border-radius: var(--radius-xs); font-size: 10px; font-weight: var(--weight-medium); margin-left: 4px; vertical-align: middle; }

    /* 版本历史 (PRD PRO-006) */
    .version-timeline { display: flex; flex-direction: column; gap: var(--space-2); }
    .version-item { display: grid; grid-template-columns: 100px 1fr 180px; gap: var(--space-3); padding: var(--space-2) 0; border-bottom: 1px solid var(--color-line); font-size: var(--text-sm); }
    .version-item:last-child { border-bottom: none; }
    .version-time { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-ink-3); }
    .version-changes { color: var(--color-ink-2); }
    .version-diff { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; }
    .version-diff .old { background: var(--color-danger-soft); color: var(--color-danger); padding: 1px 4px; border-radius: 2px; text-decoration: line-through; }
    .version-diff .new { background: var(--color-success-soft); color: var(--color-success); padding: 1px 4px; border-radius: 2px; }

    /* 字段来源图例 */
    .field-source-legend { display: flex; flex-wrap: wrap; gap: var(--space-3); padding: var(--space-2) var(--space-3); background: var(--color-surface-2); border-radius: var(--radius-sm); font-size: var(--text-xs); color: var(--color-ink-3); }
    .field-source-legend-item { display: inline-flex; align-items: center; gap: 4px; }

    /* Hallmark · component: service-records + ai-match · genre: modern-minimal · theme: Cobalt (design.md v1.0)
     * states: default · hover · focus-within
     * contrast: pass
     * redesign 2026-08-08: timeline + match-card (replaces emoji-heavy field-row × 5) */

    /* 服务记录 — 摘要条 */
    .svc-summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-md); overflow: hidden; }
    .svc-summary-cell { padding: var(--space-5) var(--space-6); border-right: 1px solid var(--color-line); }
    .svc-summary-cell:last-child { border-right: none; }
    .svc-summary-label { font-size: var(--text-xs); color: var(--color-ink-3); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: var(--space-2); font-weight: var(--weight-medium); }
    .svc-summary-value { font-family: var(--font-display); font-size: var(--text-3xl); font-weight: var(--weight-semibold); color: var(--color-ink); line-height: 1.1; letter-spacing: -0.02em; }
    .svc-summary-unit { font-family: var(--font-body); font-size: var(--text-md); color: var(--color-ink-3); margin-left: var(--space-1); font-weight: var(--weight-regular); letter-spacing: 0; }

    /* 服务记录 — timeline (替换重复 field-row × 5) */
    .svc-timeline { display: flex; flex-direction: column; }
    .svc-timeline-item { display: grid; grid-template-columns: 20px 90px 1fr 90px 110px; gap: var(--space-4); align-items: center; padding: var(--space-4) 0; border-bottom: 1px solid var(--color-line); position: relative; transition: background 150ms ease; }
    .svc-timeline-item:last-child { border-bottom: none; }
    .svc-timeline-item::before { content: ''; position: absolute; left: 9px; top: 0; bottom: 0; width: 1px; background: var(--color-line); }
    .svc-timeline-item:first-child::before { top: calc(var(--space-4) + 7px); }
    .svc-timeline-item:last-child::before { bottom: calc(50% + 7px); }
    .svc-timeline-item:hover { background: var(--color-surface-2); }
    .svc-timeline-dot { width: 14px; height: 14px; border-radius: 50%; background: var(--color-surface); border: 2px solid var(--color-accent); flex-shrink: 0; position: relative; z-index: 1; }
    .svc-timeline-item.is-done .svc-timeline-dot { background: var(--color-accent); }
    .svc-timeline-item.is-pending .svc-timeline-dot { background: var(--color-surface); border-color: var(--color-warn); }
    .svc-timeline-date { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-ink-3); }
    .svc-timeline-main { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .svc-timeline-title { font-size: var(--text-md); color: var(--color-ink); font-weight: var(--weight-medium); }
    .svc-timeline-meta { font-size: var(--text-xs); color: var(--color-ink-3); }
    .svc-timeline-amount { font-family: var(--font-mono); font-size: var(--text-md); color: var(--color-ink); font-weight: var(--weight-semibold); text-align: right; }
    .svc-timeline-amount.is-zero { color: var(--color-ink-3); font-weight: var(--weight-regular); }

    /* AI 合作机会 — 摘要条 (替代 ai-suggestion banner) */
    .match-summary { display: flex; align-items: center; gap: var(--space-4); padding: var(--space-3) var(--space-4); background: var(--color-accent-soft); border-radius: var(--radius-md); margin-bottom: var(--space-4); }
    .match-summary-icon { width: 32px; height: 32px; border-radius: 50%; background: var(--color-accent); color: var(--color-accent-ink); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .match-summary-body { flex: 1; }
    .match-summary-text { font-size: var(--text-sm); color: var(--color-ink); line-height: 1.5; }
    .match-summary-text strong { color: var(--color-accent); font-weight: var(--weight-semibold); }

    /* AI 合作机会 — match-card (替代重复 field-row × 5 + emoji 装饰) */
    .match-card { display: grid; grid-template-columns: 36px 1fr 180px; gap: var(--space-5); padding: var(--space-5) var(--space-6); background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-md); margin-bottom: var(--space-3); position: relative; transition: border-color 200ms ease, transform 200ms ease; }
    .match-card:last-child { margin-bottom: 0; }
    .match-card:hover, .match-card:focus-within { border-color: var(--color-accent); transform: translateY(-1px); }
    .match-card-rank { font-family: var(--font-mono); font-size: var(--text-xl); color: var(--color-ink-3); font-weight: var(--weight-regular); line-height: 1.2; padding-top: 2px; }
    .match-card-body { display: flex; flex-direction: column; gap: var(--space-3); min-width: 0; }
    .match-card-head { display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
    .match-card-name { font-size: var(--text-md); color: var(--color-ink); font-weight: var(--weight-semibold); }
    .match-card-tag { display: inline-flex; align-items: center; padding: 1px 8px; font-size: var(--text-xs); background: var(--color-surface-2); color: var(--color-ink-2); border-radius: var(--radius-pill); font-weight: var(--weight-medium); }
    .match-card-desc { font-size: var(--text-sm); color: var(--color-ink-2); line-height: 1.5; }
    .match-card-meta { display: flex; gap: var(--space-4); flex-wrap: wrap; font-size: var(--text-xs); color: var(--color-ink-3); }
    .match-card-meta-item { display: inline-flex; align-items: center; gap: 4px; }
    .match-card-meta-item strong { font-family: var(--font-mono); color: var(--color-ink-2); font-weight: var(--weight-semibold); }
    .match-card-bar { display: flex; align-items: center; gap: var(--space-3); padding-top: var(--space-2); border-top: 1px solid var(--color-line); }
    .match-card-bar-label { font-size: var(--text-xs); color: var(--color-ink-3); width: 56px; flex-shrink: 0; }
    .match-card-bar-track { flex: 1; height: 4px; background: var(--color-surface-2); border-radius: 2px; overflow: hidden; }
    .match-card-bar-fill { height: 100%; background: var(--color-accent); border-radius: 2px; }
    .match-card.is-urgent .match-card-bar-fill { background: var(--color-danger); }
    .match-card.is-warn .match-card-bar-fill { background: var(--color-warn); }
    .match-card-bar-value { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-ink); font-weight: var(--weight-semibold); width: 28px; text-align: right; }
    .match-card-actions { display: flex; flex-direction: column; gap: var(--space-2); align-items: stretch; }

    /* :focus-visible 强调 */
    .match-card a:focus-visible, .match-card button:focus-visible, .svc-timeline-item a:focus-visible, .svc-timeline-item button:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; border-radius: var(--radius-xs); }

    /* 响应式 (hallmark gate 32-37) */
    @media (max-width: 900px) {
      .svc-summary { grid-template-columns: 1fr; }
      .svc-summary-cell { border-right: none; border-bottom: 1px solid var(--color-line); }
      .svc-summary-cell:last-child { border-bottom: none; }
      .svc-timeline-item { grid-template-columns: 20px 1fr; gap: var(--space-2) var(--space-3); }
      .svc-timeline-date, .svc-timeline-amount { display: none; }
      .match-card { grid-template-columns: 1fr; gap: var(--space-3); padding: var(--space-4); }
      .match-card-actions { flex-direction: row; }
    }
  </style>
</head>
