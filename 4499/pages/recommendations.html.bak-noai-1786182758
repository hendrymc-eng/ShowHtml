    /* 关系图谱 */
    .rel-graph { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-md); padding: var(--space-6); }
    .rel-graph-svg { width: 100%; height: 300px; display: block; }
    .rel-graph-legend { display: flex; gap: var(--space-4); margin-top: var(--space-3); font-size: var(--text-xs); color: var(--color-ink-3); flex-wrap: wrap; }
    .rel-graph-legend-item { display: inline-flex; align-items: center; gap: var(--space-1); }
    .rel-graph-legend-dot { width: 8px; height: 8px; border-radius: 50%; }

    /* 关系深度柱图 */
    .depth-bars { display: flex; align-items: flex-end; gap: var(--space-4); height: 180px; padding: var(--space-2) 0; }
    .depth-bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; gap: var(--space-2); height: 100%; }
    .depth-bar-track { width: 100%; max-width: 88px; flex: 1; background: var(--color-surface-2); border-radius: var(--radius-sm); position: relative; overflow: hidden; display: flex; align-items: flex-end; }
    .depth-bar-fill { width: 100%; background: var(--color-accent); border-radius: var(--radius-sm); transition: height 0.8s var(--ease-out); }
    .depth-bar-num { font-family: var(--font-mono); font-size: var(--text-md); font-weight: var(--weight-medium); color: var(--color-ink); }
    .depth-bar-label { font-size: var(--text-xs); color: var(--color-ink-3); }

    /* 协作者贡献度 6 维矩阵 */
    .contrib-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); }
    .contrib-cell { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-md); padding: var(--space-4); }
    .contrib-cell-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-2); }
    .contrib-cell-label { font-size: var(--text-sm); color: var(--color-ink-2); }
    .contrib-cell-num { font-family: var(--font-display); font-size: var(--text-2xl); font-weight: var(--weight-semibold); color: var(--color-accent); letter-spacing: -0.02em; }
    .contrib-cell-bar { height: 4px; background: var(--color-surface-2); border-radius: var(--radius-pill); overflow: hidden; }
    .contrib-cell-bar-fill { height: 100%; background: var(--color-accent); border-radius: var(--radius-pill); }
    .contrib-cell-foot { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: var(--space-2); }

    /* 时间线 */
    .rel-timeline { display: flex; flex-direction: column; }
    .rel-timeline-item { display: flex; gap: var(--space-3); padding-bottom: var(--space-4); position: relative; }
    .rel-timeline-item:not(:last-child)::after { content: ''; position: absolute; left: 7px; top: 20px; bottom: 0; width: 1px; background: var(--color-line); }
    .rel-timeline-dot { width: 14px; height: 14px; border-radius: 50%; background: var(--color-surface); border: 2px solid var(--color-accent); flex-shrink: 0; margin-top: 4px; }
    .rel-timeline-dot-warn { border-color: var(--color-warn-2); }
    .rel-timeline-dot-success { border-color: var(--color-success); background: var(--color-success); }
    .rel-timeline-main { flex: 1; min-width: 0; }
    .rel-timeline-title { font-size: var(--text-md); color: var(--color-ink); font-weight: var(--weight-medium); }
    .rel-timeline-meta { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; }
    .rel-timeline-desc { font-size: var(--text-sm); color: var(--color-ink-2); margin-top: var(--space-1); line-height: var(--leading-relaxed); }

    /* 待办 check-box */
    .todo-row { display: flex; align-items: flex-start; gap: var(--space-3); padding: var(--space-3) var(--space-4); border: 1px solid var(--color-line); border-radius: var(--radius-sm); margin-bottom: var(--space-2); transition: background var(--dur-fast) var(--ease-out); }
    .todo-row:hover { background: var(--color-surface-2); }
    .todo-check { width: 18px; height: 18px; border-radius: var(--radius-xs); border: 1.5px solid var(--color-line-3); flex-shrink: 0; cursor: pointer; display: flex; align-items: center; justify-content: center; margin-top: 2px; transition: all var(--dur-fast) var(--ease-out); }
    .todo-check.is-done { background: var(--color-success); border-color: var(--color-success); color: white; }
    .todo-check.is-done::after { content: '✓'; font-size: 12px; }
    .todo-main { flex: 1; min-width: 0; }
    .todo-title { font-size: var(--text-md); color: var(--color-ink); font-weight: var(--weight-medium); }
    .todo-meta { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 4px; }
    .todo-row.is-done .todo-title { color: var(--color-ink-3); text-decoration: line-through; }
    .todo-row.is-done .todo-meta { color: var(--color-ink-4); }
  </style>
</head>
