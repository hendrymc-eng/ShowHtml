  <style>
    body { background: var(--color-paper); }
    .umax-shell { max-width: 1200px; margin: 0 auto; padding: var(--space-8) var(--space-6); }
    .umax-hero {
      background: linear-gradient(135deg, var(--color-accent-soft) 0%, var(--color-paper) 100%);
      border: 1px solid var(--color-line);
      border-radius: var(--radius-lg);
      padding: var(--space-8) var(--space-8);
      margin-bottom: var(--space-6);
    }
    .umax-hero h1 { font-size: var(--text-3xl); margin: 0 0 var(--space-3); }
    .umax-hero p { color: var(--color-ink-2); margin: 0; }
    .umax-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); margin-bottom: var(--space-6); }
    .umax-card {
      background: var(--color-surface);
      border: 1px solid var(--color-line);
      border-radius: var(--radius-md);
      padding: var(--space-5) var(--space-6);
      transition: all 200ms ease;
    }
    .umax-card.is-locked { opacity: 0.6; background: var(--color-surface-2); }
    .umax-card:hover { border-color: var(--color-line-2); transform: translateY(-1px); }
    .umax-card-icon {
      width: 40px; height: 40px; border-radius: var(--radius-md);
      background: var(--color-accent-soft); color: var(--color-accent);
      display: inline-flex; align-items: center; justify-content: center;
      margin-bottom: var(--space-3);
    }
    .umax-card.is-locked .umax-card-icon { background: var(--color-surface); color: var(--color-ink-4); }
    .umax-card-title { font-size: var(--text-md); font-weight: var(--weight-semibold); color: var(--color-ink); margin: 0 0 var(--space-2); }
    .umax-card-desc { font-size: var(--text-sm); color: var(--color-ink-3); line-height: 1.5; margin: 0 0 var(--space-3); }
    .umax-card-action { display: flex; gap: var(--space-2); align-items: center; }
    .activation-box {
      background: var(--color-surface);
      border: 1px solid var(--color-line);
      border-radius: var(--radius-md);
      padding: var(--space-5) var(--space-6);
      display: flex; gap: var(--space-3); align-items: center;
    }
    .activation-box input {
      flex: 1; font-family: var(--font-mono); font-size: var(--text-md);
      letter-spacing: 0.1em; text-transform: uppercase;
    }
    .activity-row {
      display: flex; align-items: center; gap: var(--space-3);
      padding: var(--space-3) 0; border-bottom: 1px solid var(--color-line);
    }
    .activity-row:last-child { border-bottom: none; }
    .activity-time { font-size: var(--text-sm); color: var(--color-ink-3); min-width: 80px; font-family: var(--font-mono); }
    .activity-text { font-size: var(--text-sm); color: var(--color-ink-2); flex: 1; }
    @media (max-width: 1024px) { .umax-grid { grid-template-columns: 1fr; } }
  
    .tools-nav { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-md); padding: var(--space-4) var(--space-5); margin-bottom: var(--space-5); }
    .tools-nav-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-3); }
    .tools-nav-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: var(--space-2); }
    .tools-nav-card { display: flex; align-items: flex-start; gap: var(--space-2); padding: var(--space-3); border: 1px solid var(--color-line); border-radius: var(--radius-sm); background: var(--color-paper); text-decoration: none; color: inherit; transition: all 200ms ease; }
    .tools-nav-card:hover { border-color: var(--color-line-2); transform: translateY(-1px); }
    .tools-nav-card.is-current { border-color: var(--color-accent); }
    .tools-nav-icon { width: 18px; height: 18px; color: var(--color-accent); flex-shrink: 0; margin-top: 2px; }
    .tools-nav-title { font-size: var(--text-sm); font-weight: var(--weight-semibold); color: var(--color-ink); }
    .tools-nav-desc { font-size: var(--text-xs); color: var(--color-ink-3); line-height: 1.4; margin-top: 2px; }
    .tools-nav-badge { display: inline-block; font-size: 10px; color: var(--color-ink-4); margin-top: 4px; }
    @media (max-width: 1024px) { .tools-nav-grid { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 640px) { .tools-nav-grid { grid-template-columns: repeat(2, 1fr); } }
  </style>
</head>
