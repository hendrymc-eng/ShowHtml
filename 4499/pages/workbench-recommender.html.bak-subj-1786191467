<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>我的工作台 · 推荐人 · 4499</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="../css/tokens.css" />
  <link rel="stylesheet" href="../css/components.css" />
  <style>
    /* 页面级微调 */
    body { background: var(--color-paper); }
    .workbench-hero {
      background: linear-gradient(180deg, var(--color-accent-softer) 0%, var(--color-paper) 100%);
      border-bottom: 1px solid var(--color-line);
      padding: var(--space-8) 0 var(--space-10);
    }
    .workbench-hero-inner { max-width: var(--container-content); margin: 0 auto; padding: 0 var(--space-6); }
    .workbench-greet { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-2); }
    .workbench-greet-time { font-size: var(--text-sm); color: var(--color-ink-3); font-family: var(--font-mono); }
    .workbench-greet-name { font-size: var(--text-sm); color: var(--color-ink-2); }
    .workbench-greet-name strong { color: var(--color-ink); font-weight: var(--weight-semibold); }
    .workbench-title { font-size: var(--text-3xl); font-weight: var(--weight-semibold); letter-spacing: -0.02em; color: var(--color-ink); }
    .workbench-subtitle { font-size: var(--text-md); color: var(--color-ink-2); margin-top: var(--space-2); }
    .kpi-row {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: var(--space-4);
      margin-top: var(--space-6);
    }
    @media (max-width: 1200px) { .kpi-row { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 768px) { .kpi-row { grid-template-columns: repeat(2, 1fr); } }

    .ai-suggestion-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: var(--space-4);
    }
    @media (max-width: 1024px) { .ai-suggestion-grid { grid-template-columns: 1fr; } }

    .priority-list { display: flex; flex-direction: column; }
    .priority-item {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      padding: var(--space-3) 0;
      border-bottom: 1px solid var(--color-line);
    }
    .priority-item:last-child { border-bottom: none; }
    .priority-rank { font-family: var(--font-display); font-weight: var(--weight-semibold); font-size: var(--text-lg); color: var(--color-accent); width: 24px; }
    .priority-main { flex: 1; min-width: 0; }
    .priority-name { font-size: var(--text-md); font-weight: var(--weight-medium); color: var(--color-ink); }
    .priority-reason { font-size: var(--text-sm); color: var(--color-ink-3); margin-top: 2px; }
    .priority-action { font-size: var(--text-sm); }

    .alert-item {
      display: flex;
      align-items: flex-start;
      gap: var(--space-3);
      padding: var(--space-3);
      border-radius: var(--radius-sm);
      background: var(--color-surface-2);
      margin-bottom: var(--space-2);
    }
    .alert-item:last-child { margin-bottom: 0; }
    .alert-item-warn { background: var(--color-warn-softer); }
    .alert-item-danger { background: var(--color-danger-softer); }
    .alert-item-info { background: var(--color-info-soft); }
    .alert-dot { width: 8px; height: 8px; border-radius: 50%; margin-top: 6px; flex-shrink: 0; }
    .alert-item-warn .alert-dot { background: var(--color-warn); }
    .alert-item-danger .alert-dot { background: var(--color-danger); }
    .alert-item-info .alert-dot { background: var(--color-info); }
    .alert-main { flex: 1; min-width: 0; }
    .alert-title { font-size: var(--text-sm); font-weight: var(--weight-medium); color: var(--color-ink); }
    .alert-desc { font-size: var(--text-xs); color: var(--color-ink-2); margin-top: 2px; }

    .task-row {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      padding: var(--space-3) var(--space-4);
      border-bottom: 1px solid var(--color-line);
      transition: background var(--dur-fast) var(--ease-out);
    }
    .task-row:hover { background: var(--color-surface-2); }
    .task-row:last-child { border-bottom: none; }
    .task-check {
      width: 18px; height: 18px;
      border-radius: var(--radius-xs);
      border: 1.5px solid var(--color-line-3);
      flex-shrink: 0;
      cursor: pointer;
      display: flex; align-items: center; justify-content: center;
    }
    .task-main { flex: 1; min-width: 0; }
    .task-title { font-size: var(--text-md); color: var(--color-ink); }
    .task-meta { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; }
    .task-time { font-size: var(--text-xs); color: var(--color-ink-3); font-family: var(--font-mono); flex-shrink: 0; }

    .timeline { display: flex; flex-direction: column; }
    .timeline-item {
      display: flex;
      gap: var(--space-3);
      padding-bottom: var(--space-4);
      position: relative;
    }
    .timeline-item:not(:last-child)::after {
      content: '';
      position: absolute;
      left: 7px; top: 18px; bottom: 0;
      width: 1px;
      background: var(--color-line);
    }
    .timeline-dot {
      width: 14px; height: 14px;
      border-radius: 50%;
      background: var(--color-surface);
      border: 2px solid var(--color-accent);
      flex-shrink: 0;
      margin-top: 4px;
    }
    .timeline-item-done .timeline-dot { background: var(--color-accent); }
    .timeline-item-pending .timeline-dot { border-color: var(--color-line-3); }
    .timeline-main { flex: 1; min-width: 0; }
    .timeline-title { font-size: var(--text-md); color: var(--color-ink); }
    .timeline-meta { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; }

    .quick-action {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      padding: var(--space-3);
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: background var(--dur-fast) var(--ease-out);
    }
    .quick-action:hover { background: var(--color-surface-2); }
    .quick-action-icon {
      width: 36px; height: 36px;
      border-radius: var(--radius-sm);
      background: var(--color-accent-soft);
      color: var(--color-accent);
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .quick-action-main { flex: 1; }
    .quick-action-title { font-size: var(--text-md); color: var(--color-ink); font-weight: var(--weight-medium); }
    .quick-action-desc { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; }

    /* B1 增强：进度条入场动画 + 内联编辑 + drawer body */
    @keyframes grow-bar { from { width: 0 !important; } }
    .progress-bar.animate-in { animation: grow-bar 900ms var(--ease-out) forwards; }

    .inline-edit-trigger { cursor: pointer; padding: 2px 4px; border-radius: var(--radius-xs); transition: background var(--dur-fast) var(--ease-out); }
    .inline-edit-trigger:hover { background: var(--color-accent-soft); }
    .inline-edit-form { display: none; padding: var(--space-3); background: var(--color-accent-softer); border: 1px solid var(--color-accent-soft); border-radius: var(--radius-sm); margin-top: var(--space-2); }
    .inline-edit-form.is-open { display: block; }
    .inline-edit-form .field-row-mini { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2); margin-bottom: var(--space-2); }

    .drawer-section { margin-bottom: var(--space-5); }
    .drawer-section:last-child { margin-bottom: 0; }
    .drawer-section-title { font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-ink-3); font-weight: var(--weight-medium); margin-bottom: var(--space-2); }
    .drawer-kv { display: flex; justify-content: space-between; align-items: center; padding: var(--space-2) 0; border-bottom: 1px solid var(--color-line); font-size: var(--text-sm); }
    .drawer-kv:last-child { border-bottom: none; }
    .drawer-kv-label { color: var(--color-ink-3); }
    .drawer-kv-val { color: var(--color-ink); font-weight: var(--weight-medium); }

    .required-mark { color: var(--color-danger); margin-left: 2px; }
    .form-error-hint { color: var(--color-danger); font-size: var(--text-xs); margin-top: var(--space-1); min-height: 14px; }

    /* B1 增强（数据密度） */
    .kpi-trend {
      display: inline-flex; align-items: center; gap: 2px;
      font-size: var(--text-xs); font-family: var(--font-mono);
      margin-top: var(--space-1);
    }
    .kpi-trend-up { color: var(--color-success); }
    .kpi-trend-down { color: var(--color-danger); }
    .kpi-trend-flat { color: var(--color-ink-3); }
    .kpi-meta { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; line-height: 1.5; }

    .urgency-pill {
      display: inline-flex; align-items: center; gap: 4px;
      padding: 2px 8px; border-radius: var(--radius-pill);
      font-size: var(--text-xs); font-weight: var(--weight-medium);
      flex-shrink: 0;
    }
    .urgency-urgent { background: var(--color-danger-soft); color: var(--color-danger); }
    .urgency-high { background: var(--color-warn-soft); color: var(--color-warn-2); }
    .urgency-normal { background: var(--color-surface-2); color: var(--color-ink-2); }
    .urgency-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

    .priority-row { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3) 0; border-bottom: 1px solid var(--color-line); }
    .priority-row:last-child { border-bottom: none; }
    .priority-row .priority-main { flex: 1; min-width: 0; }
    .priority-name { font-size: var(--text-md); font-weight: var(--weight-medium); color: var(--color-ink); display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
    .priority-reason { font-size: var(--text-sm); color: var(--color-ink-3); margin-top: 2px; line-height: 1.5; }
    .priority-meta-row { display: flex; align-items: center; gap: var(--space-3); margin-top: 4px; font-size: var(--text-xs); color: var(--color-ink-3); }
    .priority-meta-item { display: inline-flex; align-items: center; gap: 4px; }
    .priority-action-text { font-size: var(--text-sm); color: var(--color-accent); margin-top: 4px; }

    .ai-suggestion-row {
      display: flex; align-items: flex-start; gap: var(--space-3);
      padding: var(--space-3) 0;
      border-bottom: 1px solid var(--color-accent-soft);
    }
    .ai-suggestion-row:last-child { border-bottom: none; }
    .ai-suggestion-num {
      width: 24px; height: 24px; border-radius: 50%;
      background: var(--color-accent); color: var(--color-accent-ink);
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-mono); font-size: var(--text-xs); font-weight: var(--weight-semibold);
      flex-shrink: 0;
    }
    .ai-suggestion-body { flex: 1; min-width: 0; }
    .ai-suggestion-head { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
    .ai-suggestion-text { font-size: var(--text-sm); color: var(--color-ink-2); margin-top: 4px; line-height: 1.6; }

    .alert-meta { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 4px; }
    .alert-action { font-size: var(--text-xs); color: var(--color-accent); margin-top: 4px; display: inline-flex; align-items: center; gap: 2px; }

    .task-customer { font-size: var(--text-xs); color: var(--color-accent); margin-top: 2px; }

    .timeline-type-pill {
      display: inline-block; padding: 1px 6px; border-radius: var(--radius-xs);
      font-size: 10px; font-weight: var(--weight-medium);
      background: var(--color-surface-2); color: var(--color-ink-2);
      margin-right: 4px;
    }
    .timeline-type-pill.t-course { background: var(--color-biz-poif); color: var(--color-ink-inv); }
    .timeline-type-pill.t-umax { background: var(--color-info-soft); color: var(--color-info); }
    .timeline-type-pill.t-event { background: var(--color-warn-soft); color: var(--color-warn-2); }
    .timeline-type-pill.t-renew { background: var(--color-success-soft); color: var(--color-success); }

    /* 今日推荐行动（AI 生成） */
    .recommend-action {
      display: flex; align-items: flex-start; gap: var(--space-3);
      padding: var(--space-4); border: 1px solid var(--color-accent-soft);
      border-radius: var(--radius-md); background: var(--color-surface);
      position: relative;
      transition: border-color var(--dur-fast) var(--ease-out);
    }
    .recommend-action:hover { border-color: var(--color-accent); }
    .recommend-action-num {
      width: 32px; height: 32px; border-radius: 50%;
      background: var(--color-accent); color: var(--color-accent-ink);
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-display); font-weight: var(--weight-semibold);
      flex-shrink: 0;
    }
    .recommend-action-body { flex: 1; min-width: 0; }
    .recommend-action-title { font-size: var(--text-md); font-weight: var(--weight-semibold); color: var(--color-ink); }
    .recommend-action-desc { font-size: var(--text-sm); color: var(--color-ink-2); margin-top: 4px; line-height: 1.6; }
    .recommend-action-meta { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3); }
    .recommend-meta-tag {
      display: inline-flex; align-items: center; gap: 4px;
      padding: 2px 8px; border-radius: var(--radius-pill);
      font-size: var(--text-xs); background: var(--color-surface-2); color: var(--color-ink-2);
    }
    .recommend-meta-tag .meta-label { color: var(--color-ink-3); }
    .recommend-meta-tag .meta-val { font-family: var(--font-mono); color: var(--color-ink); font-weight: var(--weight-medium); }
    .recommend-action-btn { flex-shrink: 0; }

    /* 本周业绩双柱状图 */
    .dual-bar-row { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-2) 0; }
    .dual-bar-label { width: 64px; font-size: var(--text-sm); color: var(--color-ink-2); flex-shrink: 0; }
    .dual-bar-track { flex: 1; display: flex; flex-direction: column; gap: 2px; }
    .dual-bar-item { display: flex; align-items: center; gap: var(--space-2); }
    .dual-bar-name { width: 36px; font-size: 10px; color: var(--color-ink-3); font-family: var(--font-mono); }
    .dual-bar-fill { height: 10px; border-radius: 2px; }
    .dual-bar-fill.this-month { background: var(--color-accent); }
    .dual-bar-fill.last-month { background: var(--color-accent-soft); }
    .dual-bar-val { width: 40px; text-align: right; font-size: var(--text-sm); font-family: var(--font-mono); font-weight: var(--weight-medium); color: var(--color-ink); }
  </style>
</head>
