        entries.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.classList.add('animate-in');
            obs.unobserve(e.target);
          }
        });
      }, { threshold: 0.3 });
      bars.forEach(function (b) { obs.observe(b); });
    } else {
      bars.forEach(function (b) { b.classList.add('animate-in'); });
