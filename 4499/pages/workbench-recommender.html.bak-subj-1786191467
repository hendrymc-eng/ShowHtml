      document.getElementById('drawer-client-avatar').textContent = letter;
      document.getElementById('drawer-client-name').textContent = data.name;
      document.getElementById('drawer-client-id').textContent = data.id;
      document.getElementById('drawer-client-level').textContent = data.level;
      document.getElementById('drawer-client-status').textContent = data.status;
      var fields = drawer.querySelectorAll('[data-field]');
      fields.forEach(function (el) {
        var f = el.getAttribute('data-field');
        el.textContent = data[f] || '—';
      });
      drawer.querySelector('[name="name"]').value = data.name;
      drawer.querySelector('[name="phone"]').value = data.phone.replace(/\*+/g, '');
      drawer.querySelector('[name="biz"]').value = data.biz;
      drawer.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      drawer.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    // 优先级客户列表点击头像 / 姓名 → 打开 drawer
    document.querySelectorAll('.priority-item').forEach(function (item) {
      item.style.cursor = 'pointer';
      item.addEventListener('click', function (e) {
        if (e.target.closest('button')) return; // 按钮上的点击不触发
        var avatar = item.querySelector('.avatar');
        if (!avatar) return;
        openDrawer(avatar.textContent.trim());
      });
    });

    // 关闭按钮
    drawer.querySelectorAll('[data-drawer-close]').forEach(function (btn) {
      btn.addEventListener('click', closeDrawer);
    });

    // 内部按钮 action
    drawer.addEventListener('click', function (e) {
      var trigger = e.target.closest('[data-action]');
      if (!trigger) return;
      var action = trigger.getAttribute('data-action');
      if (action === 'toggle-inline-edit') {
        var t = trigger.getAttribute('data-target');
        var f = document.getElementById(t);
        if (f) f.classList.toggle('is-open');
      } else if (action === 'save-inline-edit') {
        var f = document.getElementById('drawer-edit-basic');
        if (f) {
          f.classList.remove('is-open');
          var nameVal = f.querySelector('[name="name"]').value;
          var phoneVal = f.querySelector('[name="phone"]').value;
          var bizVal = f.querySelector('[name="biz"]').value;
          if (nameVal) drawer.querySelector('[data-field="name"]').textContent = nameVal;
          if (phoneVal) drawer.querySelector('[data-field="phone"]').textContent = phoneVal + ' ****';
          if (bizVal) drawer.querySelector('[data-field="biz"]').textContent = bizVal;
          toast('已保存修改', 'success');
        }
      } else if (action === 'add-note') {
        var ta = document.getElementById('drawer-new-note');
        var v = ta.value.trim();
        if (!v) { toast('请输入跟进内容', 'error'); return; }
        var tl = document.getElementById('drawer-client-timeline');
        if (tl.querySelector('.text-sm.text-ink-3')) tl.innerHTML = '';
        var now = new Date();
        var time = now.getFullYear() + '-' + String(now.getMonth()+1).padStart(2,'0') + '-' + String(now.getDate()).padStart(2,'0') + ' ' + String(now.getHours()).padStart(2,'0') + ':' + String(now.getMinutes()).padStart(2,'0');
        var item = document.createElement('div');
        item.className = 'tl-item tl-item-done';
        item.innerHTML = '<div class="tl-dot"></div><div class="tl-time">' + time + '</div><div class="tl-title">UMAX 消息 · 跟进记录</div><div class="tl-desc">' + v + '</div>';
        tl.insertBefore(item, tl.firstChild);
        ta.value = '';
        toast('跟进记录已添加', 'success');
      } else if (action === 'contact-client') {
        toast('已发起联系', 'success');
        setTimeout(closeDrawer, 600);
      }
    });
  })();

  // B1 增强：新建客户表单验证 + 提交
  (function () {
    var form = document.getElementById('form-new-client');
    if (!form) return;

    function getVal(name) {
      var el = form.querySelector('[name="' + name + '"]');
      return el ? el.value.trim() : '';
    }
    function setError(name, msg) {
      var el = form.querySelector('[data-error-for="' + name + '"]');
      if (el) el.textContent = msg || '';
      var input = form.querySelector('[name="' + name + '"]');
      if (input) {
        if (msg) input.setAttribute('data-state', 'error');
        else input.removeAttribute('data-state');
      }
    }
    function validate() {
      var ok = true;
      if (!getVal('name')) { setError('name', '请填写姓名'); ok = false; } else setError('name', '');
      var phone = getVal('phone');
      if (!phone) { setError('phone', '请填写手机号'); ok = false; }
      else if (!/^1[3-9]\d{9}$/.test(phone)) { setError('phone', '手机号格式不正确'); ok = false; }
      else setError('phone', '');
      if (!getVal('source')) { setError('source', '请选择客户来源'); ok = false; } else setError('source', '');
      return ok;
    }

    // 失焦验证
    form.querySelectorAll('[name]').forEach(function (el) {
      el.addEventListener('blur', function () {
        var n = el.getAttribute('name');
        if (n === 'name' && !getVal('name')) setError('name', '请填写姓名');
        if (n === 'phone') {
          var p = getVal('phone');
          if (p && !/^1[3-9]\d{9}$/.test(p)) setError('phone', '手机号格式不正确');
          else if (p) setError('phone', '');
        }
        if (n === 'source' && !getVal('source')) setError('source', '请选择客户来源');
      });
      el.addEventListener('input', function () {
        var n = el.getAttribute('name');
        if (el.getAttribute('data-state') === 'error') setError(n, '');
      });
    });

    document.addEventListener('click', function (e) {
      var a = e.target.closest('[data-action]');
      if (!a) return;
      var action = a.getAttribute('data-action');
      if (action === 'submit-new-client') {
        if (validate()) {
          toast('客户创建成功', 'success');
          form.reset();
          setTimeout(function () {
            var m = document.getElementById('modal-new-client');
            if (m) m.classList.remove('is-open');
            var bd = document.querySelector('[data-modal-backdrop="modal-new-client"]');
            if (bd) bd.classList.remove('is-open');
            document.body.style.overflow = '';
          }, 400);
        } else {
          toast('请填写所有必填项', 'error');
        }
      } else if (action === 'save-draft') {
        toast('草稿已保存', 'success');
      }
    });
  })();

  // B1 增强：priority-item 行内"立即联系"按钮追加 toast
  document.querySelectorAll('.priority-action').forEach(function (btn) {
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      var t = btn.textContent.trim();
      if (t.includes('立即联系')) {
        setTimeout(function () { toast('已发起联系', 'success'); }, 50);
      } else if (t.includes('查看申请')) {
        setTimeout(function () { toast('已提交申请，AI 匹配中...', 'info'); }, 50);
      } else if (t.includes('申请支持')) {
        setTimeout(function () { toast('正在跳转专业支持申请...', 'info'); }, 50);
      } else if (t.includes('回访')) {
        setTimeout(function () { toast('回访任务已创建', 'success'); }, 50);
      } else if (t.includes('处理')) {
        setTimeout(function () { toast('已标记为处理中', 'success'); }, 50);
      } else if (t.includes('查看建议')) {
        setTimeout(function () { toast('AI 建议已生成', 'info'); }, 50);
      }
    });
  });

  // B1 增强：快速操作区点击 toast
  document.querySelectorAll('.quick-action').forEach(function (qa) {
    qa.addEventListener('click', function () {
      var title = qa.querySelector('.quick-action-title');
      if (title) {
        setTimeout(function () { toast('打开：' + title.textContent.trim(), 'info'); }, 50);
      }
    });
  });
</script>
