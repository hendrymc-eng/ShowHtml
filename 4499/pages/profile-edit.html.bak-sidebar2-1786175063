                    <span class="badge badge-danger" style="cursor: pointer;">高污染制造业 ×</span>
                    <span class="badge badge-outline" style="cursor: pointer;">+ 添加</span>
                  </div>
                </div>
              </div>
              <div class="form-row">
                <div class="form-label">ESG 偏好</div>
                <div>
                  <select class="select" style="max-width: 240px;">
                    <option>绿色产业（推荐）</option>
                    <option>所有 ESG 评级 ≥ B</option>
                    <option>无偏好</option>
                  </select>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 长期目标 -->
        <div class="section">
          <div class="section-head">
            <span class="eyebrow">目标</span>
            <h2 class="section-title">3 年长期目标</h2>
          </div>
          <div class="card">
            <div class="form-row">
              <div class="form-label">家庭办公室</div>
              <div>
                <select class="select" style="max-width: 320px;">
                  <option>1.0 搭建（进行中）</option>
                  <option>2.0 升级（已完成）</option>
                  <option>3.0 跨境架构（待启动）</option>
