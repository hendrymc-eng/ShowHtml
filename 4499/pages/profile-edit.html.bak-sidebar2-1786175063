                <span class="badge badge-success" style="cursor: pointer;">ESG 投资 ×</span>
                <span class="badge badge-success" style="cursor: pointer;">二代教育 ×</span>
              </div>
              <div class="text-xs text-ink-3 mt-2">同行推荐次数：23 次 · 评分均值 4.8 / 5</div>
            </div>
          </div>
        </div>

        <!-- 资源 -->
        <div class="section">
          <div class="section-head">
            <span class="eyebrow">资源</span>
            <h2 class="section-title">可对外提供资源</h2>
            <p class="section-subtitle">用于商业网络智能匹配 · 仅合作方可见</p>
          </div>
          <div class="card">
            <div class="form-section">
              <div class="form-section-title">资本资源</div>
              <div class="form-row">
                <div class="form-label">可调动资金</div>
                <div>
                  <div class="flex gap-2 items-center">
                    <input class="input" value="8000 万 - 2 亿" style="flex: 1;" />
