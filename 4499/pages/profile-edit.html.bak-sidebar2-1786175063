          <div class="section-head">
            <span class="eyebrow">紧急</span>
            <h2 class="section-title">紧急联系人 · 3 位</h2>
            <p class="section-subtitle">关键场景自动通知 · 含 1 位主联系人 + 2 位备选</p>
          </div>
          <div class="grid-2x2">
            <div class="card">
              <div class="flex items-center justify-between mb-3">
                <span class="badge badge-accent">主联系人</span>
                <span class="badge badge-success">已验证</span>
              </div>
              <div class="flex items-center gap-3 mb-3">
                <div class="avatar avatar-md avatar-role-recommender">林</div>
                <div>
                  <div class="text-md fw-semibold">林建华</div>
                  <div class="text-xs text-ink-3 text-mono">+86 139 **** 1234</div>
                </div>
              </div>
              <div class="text-sm text-ink-2 mb-1">关系：配偶</div>
              <div class="text-sm text-ink-2 mb-3">接收通知：所有紧急场景</div>
              <div class="flex gap-2">
                <button class="btn btn-ghost btn-sm">编辑</button>
                <button class="btn btn-ghost btn-sm">测试通知</button>
              </div>
            </div>
            <div class="card">
              <div class="flex items-center justify-between mb-3">
                <span class="badge badge-outline">备选 1</span>
