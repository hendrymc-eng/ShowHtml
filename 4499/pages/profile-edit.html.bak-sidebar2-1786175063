                <div class="input-hint mt-1">截止 2026-12-31</div>
              </div>
            </div>
            <div class="form-row">
              <div class="form-label">二代传承</div>
              <div>
                <div class="flex items-center gap-2">
                  <input class="input" value="启动二代传承教育计划" style="flex: 1;" />
                  <span class="text-sm text-ink-3">截止 2027-06-30</span>
                </div>
              </div>
            </div>
            <div class="form-row">
              <div class="form-label">公益目标</div>
              <div>
                <div class="flex items-center gap-2">
                  <input class="input" value="5 年累计 1000 万" style="flex: 1;" />
