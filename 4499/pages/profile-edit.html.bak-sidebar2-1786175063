                <span class="badge badge-success">已验证</span>
              </div>
              <div class="flex items-center gap-3 mb-3">
                <div class="avatar avatar-md avatar-role-ai">陈</div>
                <div>
                  <div class="text-md fw-semibold">陈思远</div>
                  <div class="text-xs text-ink-3 text-mono">+86 135 **** 9012</div>
                </div>
