                    <label class="check-pill js-check-pill is-active" style="display:flex; padding: 4px 12px; border: 1px solid var(--color-accent); border-radius: 999px; background: var(--color-accent-softer); font-size: var(--text-sm);"><input type="checkbox" checked style="display:none;" />家族基金</label>
