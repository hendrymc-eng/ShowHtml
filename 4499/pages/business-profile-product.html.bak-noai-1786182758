  <style>
    .prod-hero { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-md); padding: var(--space-6); display: grid; grid-template-columns: 100px 1fr; gap: var(--space-6); align-items: center; }
    @media (max-width: 768px) { .prod-hero { grid-template-columns: 1fr; } }
    .prod-image { width: 100px; height: 100px; border-radius: var(--radius-md); background: var(--color-accent-soft); display: flex; align-items: center; justify-content: center; color: var(--color-accent); }
    .price-row { display: flex; align-items: baseline; gap: var(--space-2); }
    .price { font-family: var(--font-display); font-size: var(--text-3xl); font-weight: 600; color: var(--color-ink); letter-spacing: -0.02em; }
    .price-unit { font-size: var(--text-sm); color: var(--color-ink-3); }
    .media-thumb { width: 100%; aspect-ratio: 16/10; background: var(--color-surface-2); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; color: var(--color-ink-4); }

    /* 联系记录 5 项必填 (PRD CRM-006) */
    .contact-form { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: var(--space-3); }
    .contact-form-field { display: flex; flex-direction: column; gap: 4px; }
    .contact-form-label { font-size: var(--text-xs); color: var(--color-ink-3); font-weight: var(--weight-medium); }
    .contact-form-label .req { color: var(--color-danger); }
    .contact-form-input, .contact-form-select, .contact-form-textarea {
      padding: 8px 10px; border: 1px solid var(--color-line); border-radius: var(--radius-sm);
      font-size: var(--text-sm); background: var(--color-surface); color: var(--color-ink);
      font-family: inherit;
    }
    .contact-form-textarea { min-height: 60px; resize: vertical; }

    /* 联系方式审计提示 (PRD CRM-010 / §3.4) */
    .export-watermark-notice {
      padding: var(--space-3); background: var(--color-warn-soft);
      border: 1px solid var(--color-warn-soft); border-radius: var(--radius-sm);
      font-size: var(--text-xs); color: var(--color-ink-2);
    }
    .export-watermark-notice strong { color: var(--color-ink); }
    .audit-log-entry { display: grid; grid-template-columns: 140px 1fr 1fr; gap: var(--space-3); padding: var(--space-2) 0; border-bottom: 1px solid var(--color-line); font-size: var(--text-xs); }
    .audit-log-entry:last-child { border-bottom: none; }
    .audit-log-time { font-family: var(--font-mono); color: var(--color-ink-3); }
    .audit-log-actor { color: var(--color-ink); font-weight: var(--weight-medium); }
    .audit-log-action { color: var(--color-ink-2); }

    /* 字段来源标签 (PRD PRO-003) */
    .field-source { display: inline-flex; align-items: center; gap: 2px; padding: 1px 6px; border-radius: var(--radius-xs); font-size: 10px; font-weight: var(--weight-medium); margin-left: 4px; vertical-align: middle; }
    .field-source-self { background: var(--color-surface-2); color: var(--color-ink-2); }
    .field-source-platform { background: var(--color-info-soft); color: var(--color-info); }
    .field-source-verified { background: var(--color-success-soft); color: var(--color-success); }
    .field-source-ai { background: var(--color-accent-soft); color: var(--color-accent); }
    .field-verified-badge { display: inline-flex; align-items: center; gap: 2px; padding: 1px 6px; background: var(--color-success-soft); color: var(--color-success); border-radius: var(--radius-xs); font-size: 10px; font-weight: var(--weight-semibold); margin-left: 4px; vertical-align: middle; }
    .field-unverified-badge { display: inline-flex; align-items: center; gap: 2px; padding: 1px 6px; background: var(--color-surface-2); color: var(--color-ink-3); border: 1px dashed var(--color-line-2); border-radius: var(--radius-xs); font-size: 10px; font-weight: var(--weight-medium); margin-left: 4px; vertical-align: middle; }

    /* 版本历史 (PRD PRO-006) */
    .version-timeline { display: flex; flex-direction: column; gap: var(--space-2); }
    .version-item { display: grid; grid-template-columns: 100px 1fr 180px; gap: var(--space-3); padding: var(--space-2) 0; border-bottom: 1px solid var(--color-line); font-size: var(--text-sm); }
    .version-item:last-child { border-bottom: none; }
    .version-time { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-ink-3); }
    .version-changes { color: var(--color-ink-2); }
    .version-diff { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; }
    .version-diff .old { background: var(--color-danger-soft); color: var(--color-danger); padding: 1px 4px; border-radius: 2px; text-decoration: line-through; }
    .version-diff .new { background: var(--color-success-soft); color: var(--color-success); padding: 1px 4px; border-radius: 2px; }

    /* 字段来源图例 */
    .field-source-legend { display: flex; flex-wrap: wrap; gap: var(--space-3); padding: var(--space-2) var(--space-3); background: var(--color-surface-2); border-radius: var(--radius-sm); font-size: var(--text-xs); color: var(--color-ink-3); }
    .field-source-legend-item { display: inline-flex; align-items: center; gap: 4px; }

    /* stat-mini（KPI 小卡） */
    .stat-mini { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-sm); padding: var(--space-4); display: flex; flex-direction: column; gap: 4px; }
    .stat-mini-label { font-size: var(--text-xs); color: var(--color-ink-3); }
    .stat-mini-value { font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 600; color: var(--color-ink); line-height: 1.2; letter-spacing: -0.02em; }
    .stat-mini-delta { font-size: var(--text-xs); }

    /* 产品主卡（服务产品专属） */
    .prod-hero-card { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-md); padding: var(--space-6); }
    .prod-hero-top { display: grid; grid-template-columns: 100px 1fr auto; gap: var(--space-6); align-items: center; }
    @media (max-width: 768px) { .prod-hero-top { grid-template-columns: 1fr; } }

    /* 服务流程时间线 */
    .service-timeline { display: flex; flex-direction: column; }
    .service-step { display: grid; grid-template-columns: 32px 1fr; gap: var(--space-3); align-items: flex-start; padding: var(--space-3) 0; border-bottom: 1px solid var(--color-line); }
    .service-step:last-child { border-bottom: none; }
    .service-step-num { width: 32px; height: 32px; border-radius: 50%; background: var(--color-accent); color: var(--color-accent-ink); display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-size: var(--text-md); font-weight: 600; flex-shrink: 0; }
    .service-step-title { font-size: var(--text-md); font-weight: var(--weight-semibold); color: var(--color-ink); }
    .service-step-desc { font-size: var(--text-sm); color: var(--color-ink-2); margin-top: 4px; line-height: 1.6; }

    /* AI 建议 box */
    .ai-suggestion-box { display: flex; align-items: flex-start; gap: var(--space-3); padding: var(--space-4); border: 1px solid var(--color-accent-soft); border-radius: var(--radius-md); background: var(--color-accent-soft); }
    .ai-suggestion-icon { width: 36px; height: 36px; border-radius: var(--radius-sm); background: var(--color-accent); color: var(--color-accent-ink); display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-weight: 700; font-size: var(--text-sm); flex-shrink: 0; }
    .ai-suggestion-title { font-size: var(--text-md); font-weight: var(--weight-semibold); color: var(--color-ink); }
    .ai-suggestion-text { font-size: var(--text-sm); color: var(--color-ink-2); margin-top: 4px; line-height: 1.6; }

    /* 候选客户卡 */
    .candidate-card { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-sm); padding: var(--space-4); display: flex; flex-direction: column; gap: var(--space-3); transition: border-color var(--dur-fast) var(--ease-out); }
    .candidate-card:hover { border-color: var(--color-accent); }
    .candidate-head { display: flex; align-items: center; gap: var(--space-3); }
    .candidate-name { font-size: var(--text-md); font-weight: var(--weight-semibold); color: var(--color-ink); }
    .candidate-meta { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; }
    .candidate-tags { display: flex; gap: var(--space-2); flex-wrap: wrap; }
  </style>
</head>
