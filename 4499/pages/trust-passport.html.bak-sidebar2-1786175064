<script>
  // B1 增强：进度条入场动画
  (function () {
    var bars = document.querySelectorAll('.progress-bar');
    if ('IntersectionObserver' in window) {
      var obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('animate-in'); obs.unobserve(e.target); } });
      }, { threshold: 0.3 });
      bars.forEach(function (b) { obs.observe(b); });
    }
  })();

  // B1 增强：徽章点击 → toast 显示详情
  document.querySelectorAll('.badge-tile').forEach(function (b) {
    b.addEventListener('click', function () {
      var d = b.getAttribute('data-badge-detail');
      if (d) toast(d, 'info');
    });
  });

  // B1 增强：时间线折叠
  document.addEventListener('click', function (e) {
    var a = e.target.closest('[data-action]');
    if (!a) return;
    if (a.getAttribute('data-action') === 'toggle-timeline') {
      var hidden = document.getElementById('tl-hidden');
      if (!hidden) return;
      if (hidden.style.display === 'none') {
        hidden.style.display = '';
        a.textContent = '收起 ↑';
        toast('已展开更早的 3 条记录', 'info');
      } else {
        hidden.style.display = 'none';
        a.textContent = '查看更早记录 ↓';
      }
    }
  });

  // B1 增强：维度卡点击
  document.querySelectorAll('.dim-card').forEach(function (c) {
    c.style.cursor = 'pointer';
    c.addEventListener('click', function () {
      var n = c.querySelector('.dim-name');
      var s = c.querySelector('.dim-score');
      if (n) toast(n.textContent.trim() + ' · 当前 ' + (s ? s.textContent : '—'), 'info');
    });
  });

  // B1 增强：page actions
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('button');
    if (!btn) return;
    var t = btn.textContent.trim();
    if (t === '查看全部') toast('已显示全部 25 个徽章位（7 已获 / 18 待解锁）', 'info');
    else if (t === '分享 Trust Passport') toast('已生成分享链接', 'success');
  });
</script>
