  <style>
    .passport-hero {
      background: linear-gradient(135deg, var(--color-trust-soft) 0%, var(--color-paper) 100%);
      border: 1px solid var(--color-line);
      border-radius: var(--radius-md);
      padding: var(--space-8);
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-8);
      align-items: center;
      margin-bottom: var(--space-6);
    }
    @media (max-width: 1024px) { .passport-hero { grid-template-columns: 1fr; } }
    .pb-orb {
      width: 120px; height: 120px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--color-trust) 0%, oklch(50% 0.18 45) 100%);
      display: flex; align-items: center; justify-content: center;
      color: white;
      font-family: var(--font-display);
      font-weight: var(--weight-semibold);
      font-size: var(--text-3xl);
      box-shadow: 0 8px 24px rgba(232, 144, 26, 0.25);
    }
    .pb-stat-row { display: flex; gap: var(--space-6); margin-top: var(--space-3); }
    .pb-stat-item { }
    .pb-stat-num { font-family: var(--font-mono); font-size: var(--text-xl); font-weight: var(--weight-semibold); color: var(--color-ink); }
    .pb-stat-label { font-size: var(--text-xs); color: var(--color-ink-3); }
    .pb-rank { font-size: var(--text-md); color: var(--color-ink-2); }
    .dimension-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-4); }
    @media (max-width: 1024px) { .dimension-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 640px) { .dimension-grid { grid-template-columns: 1fr; } }
    .dim-card { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-md); padding: var(--space-4); }
    .dim-icon {
      width: 36px; height: 36px;
      border-radius: var(--radius-sm);
      display: flex; align-items: center; justify-content: center;
      background: var(--color-accent-soft); color: var(--color-accent);
      margin-bottom: var(--space-3);
    }
    .dim-name { font-size: var(--text-md); font-weight: var(--weight-semibold); color: var(--color-ink); }
    .dim-score { font-family: var(--font-mono); font-size: var(--text-xl); font-weight: var(--weight-semibold); color: var(--color-ink); margin-top: var(--space-2); }
    .badge-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: var(--space-3); }
    @media (max-width: 1024px) { .badge-grid { grid-template-columns: repeat(3, 1fr); } }
    .badge-tile {
      background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-md);
      padding: var(--space-4); text-align: center; cursor: pointer;
      transition: all var(--dur-fast) var(--ease-out);
    }
    .badge-tile:hover { border-color: var(--color-line-2); }
    .badge-tile.is-locked { opacity: 0.5; }
    .badge-tile-orb { width: 48px; height: 48px; border-radius: 50%; margin: 0 auto var(--space-2); display: flex; align-items: center; justify-content: center; font-size: var(--text-xl); }
    .badge-tile-name { font-size: var(--text-sm); font-weight: var(--weight-medium); color: var(--color-ink); }
    .badge-tile-meta { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; }

    /* B1 增强：徽章 hover 浮起 + 时间线折叠 */
    .badge-tile { position: relative; }
    .badge-tile:hover { transform: translateY(-2px); box-shadow: var(--shadow-sm); }
    .badge-tile:hover .badge-detail { display: block; }
    .badge-detail {
      display: none; position: absolute; top: 100%; left: 50%; transform: translateX(-50%);
      margin-top: 8px; z-index: 10; min-width: 220px;
      background: var(--color-surface); border: 1px solid var(--color-line);
      border-radius: var(--radius-md); padding: var(--space-3);
      box-shadow: var(--shadow-md);
      text-align: left;
    }
    .badge-detail::before {
      content: ''; position: absolute; top: -6px; left: 50%; transform: translateX(-50%) rotate(45deg);
      width: 10px; height: 10px; background: var(--color-surface); border-left: 1px solid var(--color-line); border-top: 1px solid var(--color-line);
    }
    .badge-detail-name { font-size: var(--text-md); font-weight: var(--weight-semibold); margin-bottom: 4px; }
    .badge-detail-meta { font-size: var(--text-xs); color: var(--color-ink-3); line-height: var(--leading-relaxed); }
    .tl-collapse { margin-top: var(--space-3); text-align: center; }
    @keyframes grow-bar { from { width: 0 !important; } }
    .progress-bar.animate-in { animation: grow-bar 900ms var(--ease-out) forwards; }

    /* B2 新增：详细分解 / 验证历史 / 第三方背书 / 风险 / 使用记录 */
    .dim-grid-8 { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-4); }
    @media (max-width: 1024px) { .dim-grid-8 { grid-template-columns: repeat(2, 1fr); } }
    .dim-card-full { padding: var(--space-4); border: 1px solid var(--color-line); border-radius: var(--radius-md); background: var(--color-surface); }
    .dim-card-full.is-weak { border-color: var(--color-warn); background: var(--color-warn-softer); }
    .dim-card-head { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-3); }
    .dim-card-info { flex: 1; min-width: 0; }
    .dim-card-name { font-size: var(--text-md); font-weight: var(--weight-semibold); color: var(--color-ink); }
    .dim-card-name-en { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; }
    .dim-score-ring { width: 56px; height: 56px; position: relative; flex-shrink: 0; }
    .dim-score-ring svg { transform: rotate(-90deg); }
    .dim-score-ring-bg { fill: none; stroke: var(--color-surface-2); stroke-width: 5; }
    .dim-score-ring-fg { fill: none; stroke: var(--color-accent); stroke-width: 5; stroke-linecap: round; }
    .dim-score-ring-num { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-size: var(--text-sm); font-weight: var(--weight-semibold); color: var(--color-ink); }
    .dim-metrics { display: flex; flex-direction: column; gap: var(--space-1); margin-top: var(--space-2); }
    .dim-metric { display: flex; justify-content: space-between; font-size: var(--text-xs); padding: 4px 0; border-bottom: 1px dashed var(--color-line); }
    .dim-metric:last-child { border-bottom: none; }
    .dim-metric-name { color: var(--color-ink-3); }
    .dim-metric-val { color: var(--color-ink); font-family: var(--font-mono); }

    .verify-tl { display: flex; flex-direction: column; gap: var(--space-3); }
    .verify-item { display: flex; gap: var(--space-3); padding: var(--space-3); border: 1px solid var(--color-line); border-radius: var(--radius-sm); background: var(--color-surface); }
    .verify-icon { width: 36px; height: 36px; border-radius: 50%; background: var(--color-success-soft); color: var(--color-success); display: flex; align-items: center; justify-content: center; font-size: var(--text-md); flex-shrink: 0; }
    .verify-icon.is-warn { background: var(--color-warn-soft); color: var(--color-warn-2); }
    .verify-icon.is-info { background: var(--color-info-soft); color: var(--color-info); }
    .verify-main { flex: 1; min-width: 0; }
    .verify-type { font-size: var(--text-sm); font-weight: var(--weight-medium); color: var(--color-ink); }
    .verify-result { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; line-height: var(--leading-snug); }
    .verify-time { font-size: var(--text-xs); color: var(--color-ink-3); font-family: var(--font-mono); flex-shrink: 0; }

    .endorse-card { padding: var(--space-4); border: 1px solid var(--color-line); border-radius: var(--radius-md); background: var(--color-surface); }
    .endorse-head { display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-2); }
    .endorse-org { font-size: var(--text-md); font-weight: var(--weight-medium); color: var(--color-ink); }
    .endorse-quote { font-size: var(--text-sm); color: var(--color-ink-2); line-height: var(--leading-relaxed); margin: var(--space-2) 0; }
    .endorse-meta { font-size: var(--text-xs); color: var(--color-ink-3); display: flex; justify-content: space-between; }

    .usage-item { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3); border-bottom: 1px dashed var(--color-line); }
    .usage-item:last-child { border-bottom: none; }
    .usage-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-accent); flex-shrink: 0; }
    .usage-main { flex: 1; min-width: 0; }
    .usage-scenario { font-size: var(--text-sm); color: var(--color-ink); font-weight: var(--weight-medium); }
    .usage-meta { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; }
    .usage-time { font-size: var(--text-xs); color: var(--color-ink-3); font-family: var(--font-mono); }
  </style>
