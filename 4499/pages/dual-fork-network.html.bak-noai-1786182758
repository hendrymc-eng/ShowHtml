  <style>
    .network-layout { display: grid; grid-template-columns: 1fr 340px; gap: var(--space-6); align-items: start; }
    @media (max-width: 1280px) { .network-layout { grid-template-columns: 1fr; } .network-side { display: none; } }
    .network-canvas {
      background: var(--color-surface);
      border: 1px solid var(--color-line);
      border-radius: var(--radius-md);
      padding: var(--space-6);
      min-height: 580px;
      position: relative;
      overflow: hidden;
    }
    .network-svg { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
    .layer-row { display: flex; align-items: center; justify-content: center; gap: var(--space-6); position: relative; z-index: 1; }
    .node-cluster { display: flex; flex-direction: column; align-items: center; gap: var(--space-2); }
    .node {
      background: var(--color-surface);
      border: 1px solid var(--color-line);
      border-radius: var(--radius-md);
      padding: var(--space-3) var(--space-4);
      display: flex; align-items: center; gap: var(--space-2);
      min-width: 200px;
      cursor: pointer;
      transition: all var(--dur-fast) var(--ease-out);
    }
    .node:hover { border-color: var(--color-accent); background: var(--color-accent-softer); transform: translateY(-1px); }
    .node-self { border: 2px solid var(--color-accent); background: var(--color-accent-softer); }
    .node-info { flex: 1; min-width: 0; }
    .node-name { font-size: var(--text-sm); font-weight: var(--weight-semibold); color: var(--color-ink); }
    .node-meta { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; }
    .node-stat { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-accent); font-weight: var(--weight-medium); }
    .layer-label { font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-ink-3); margin-top: var(--space-3); }
    .network-legend { display: flex; gap: var(--space-4); align-items: center; flex-wrap: wrap; }
    .legend-item { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); color: var(--color-ink-2); }
    .legend-dot { width: 10px; height: 10px; border-radius: 50%; }
    .layer-gap { height: var(--space-12); position: relative; }

    /* B1 增强：节点高亮 + 展开动画 */
    .node.is-selected { border: 2px solid var(--color-accent); background: var(--color-accent-softer); transform: translateY(-1px); box-shadow: 0 4px 12px rgba(30, 63, 174, 0.12); }
    .node { position: relative; }
    .node.is-selected::before {
      content: '✓';
      position: absolute; top: -6px; right: -6px;
      width: 18px; height: 18px; border-radius: 50%;
      background: var(--color-accent); color: var(--color-accent-ink);
      font-size: 10px; display: flex; align-items: center; justify-content: center;
    }
    .layer-expandable { cursor: pointer; transition: all var(--dur-fast) var(--ease-out); }
    .layer-expandable:hover { background: var(--color-accent-softer); border-color: var(--color-accent); }
    .layer-expanded { animation: fade-in var(--dur-slow) var(--ease-out); }
    @keyframes grow-bar { from { width: 0 !important; } }
    .progress-bar.animate-in { animation: grow-bar 900ms var(--ease-out) forwards; }

    /* B1 增强（数据密度） */
    .node-stat-block { display: flex; align-items: center; gap: var(--space-2); }
    .node-stat-mini {
      font-family: var(--font-mono); font-size: 10px;
      padding: 1px 5px; border-radius: var(--radius-xs);
      background: var(--color-surface-2); color: var(--color-ink-2);
    }
    .node-stat-mini.warn { background: var(--color-warn-soft); color: var(--color-warn-2); }
    .node-stat-mini.danger { background: var(--color-danger-soft); color: var(--color-danger); }
    .node-status-dot {
      width: 8px; height: 8px; border-radius: 50%;
      display: inline-block; flex-shrink: 0;
    }
    .node-status-active { background: var(--color-success); }
    .node-status-inactive { background: var(--color-ink-3); }
    .node-status-warning { background: var(--color-warn); }
    .node-status-danger { background: var(--color-danger); }
    .node-detail-row {
      display: flex; align-items: center; gap: var(--space-2);
      font-size: 10px; color: var(--color-ink-3);
      margin-top: 2px;
    }

    /* 网络健康指标 */
    .health-metric { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3) 0; border-bottom: 1px solid var(--color-line); }
    .health-metric:last-child { border-bottom: none; }
    .health-icon {
      width: 32px; height: 32px; border-radius: var(--radius-sm);
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .health-body { flex: 1; min-width: 0; }
    .health-label { font-size: var(--text-sm); color: var(--color-ink-2); }
    .health-value-row { display: flex; align-items: baseline; gap: var(--space-2); margin-top: 2px; }
    .health-value { font-family: var(--font-display); font-weight: var(--weight-semibold); font-size: var(--text-lg); color: var(--color-ink); }
    .health-unit { font-size: var(--text-xs); color: var(--color-ink-3); }
    .health-bar-track { height: 4px; background: var(--color-surface-2); border-radius: 2px; margin-top: 4px; overflow: hidden; }
    .health-bar-fill { height: 100%; border-radius: 2px; transition: width var(--dur-slow) var(--ease-out); }

    /* 层级分布 */
    .layer-dist-row {
      display: flex; align-items: center; gap: var(--space-3);
      padding: var(--space-3) 0; border-bottom: 1px solid var(--color-line);
    }
    .layer-dist-row:last-child { border-bottom: none; }
    .layer-dist-num {
      width: 36px; height: 36px; border-radius: 50%;
      background: var(--color-accent-soft); color: var(--color-accent);
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-display); font-weight: var(--weight-semibold);
      font-size: var(--text-md); flex-shrink: 0;
    }
    .layer-dist-body { flex: 1; min-width: 0; }
    .layer-dist-label { font-size: var(--text-sm); color: var(--color-ink-2); }
    .layer-dist-bar-track { height: 6px; background: var(--color-surface-2); border-radius: 3px; margin-top: 4px; overflow: hidden; }
    .layer-dist-bar-fill { height: 100%; background: var(--color-accent); border-radius: 3px; }
    .layer-dist-value { text-align: right; flex-shrink: 0; }
    .layer-dist-count { font-family: var(--font-display); font-weight: var(--weight-semibold); font-size: var(--text-lg); color: var(--color-ink); }
    .layer-dist-pct { font-size: 10px; color: var(--color-ink-3); }

    /* 关键人物卡片 */
    .keyperson-card {
      display: flex; align-items: center; gap: var(--space-3);
      padding: var(--space-3); border: 1px solid var(--color-line);
      border-radius: var(--radius-sm); background: var(--color-surface);
      transition: all var(--dur-fast) var(--ease-out);
    }
    .keyperson-card:hover { border-color: var(--color-accent); background: var(--color-accent-softer); }
    .keyperson-rank {
      width: 24px; height: 24px; border-radius: 50%;
      background: var(--color-accent); color: var(--color-accent-ink);
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-mono); font-size: var(--text-xs); font-weight: var(--weight-semibold);
      flex-shrink: 0;
    }
    .keyperson-rank.r2 { background: var(--color-info); }
    .keyperson-rank.r3 { background: var(--color-success); }
    .keyperson-info { flex: 1; min-width: 0; }
    .keyperson-name { font-size: var(--text-md); font-weight: var(--weight-medium); color: var(--color-ink); }
    .keyperson-meta { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; }
    .keyperson-stats { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; }
    .keyperson-stat-val { font-family: var(--font-mono); font-size: var(--text-sm); font-weight: var(--weight-semibold); color: var(--color-accent); }
    .keyperson-stat-label { font-size: 10px; color: var(--color-ink-3); }

    /* 网络演化 */
    .evolution-bar { display: flex; align-items: flex-end; gap: 4px; height: 80px; padding-bottom: 16px; }
    .evolution-bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4px; }
    .evolution-bar-fill { width: 100%; background: var(--color-accent); border-radius: 2px 2px 0 0; }
    .evolution-bar-label { font-size: 9px; color: var(--color-ink-3); font-family: var(--font-mono); }
    .evolution-bar-value { font-size: 10px; color: var(--color-ink); font-family: var(--font-mono); font-weight: var(--weight-medium); }
  </style>
</head>
