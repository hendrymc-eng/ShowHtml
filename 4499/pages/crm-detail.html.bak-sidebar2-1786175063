    .detail-head {
      background: var(--color-surface);
      border: 1px solid var(--color-line);
      border-radius: var(--radius-md);
      padding: var(--space-6);
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-6);
      align-items: start;
      margin-bottom: var(--space-6);
    }
    @media (max-width: 1024px) { .detail-head { grid-template-columns: 1fr; } }
    .detail-avatar { width: 80px; height: 80px; font-size: var(--text-2xl); border-radius: var(--radius-md); }
    .detail-name { font-family: var(--font-display); font-size: var(--text-2xl); font-weight: var(--weight-semibold); color: var(--color-ink); display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
    .detail-meta-row { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-3); }
    .detail-meta { font-size: var(--text-sm); color: var(--color-ink-3); }
    .detail-meta strong { color: var(--color-ink); font-weight: var(--weight-medium); }
    .detail-actions { display: flex; gap: var(--space-2); flex-wrap: wrap; }
    .timeline-block { position: relative; padding-left: 28px; }
    .timeline-block::before { content: ''; position: absolute; left: 7px; top: 8px; bottom: 8px; width: 1px; background: var(--color-line); }
    .tl-item { position: relative; padding-bottom: var(--space-4); }
    .tl-item:last-child { padding-bottom: 0; }
    .tl-dot { position: absolute; left: -28px; top: 4px; width: 14px; height: 14px; border-radius: 50%; background: var(--color-surface); border: 2px solid var(--color-accent); }
    .tl-item-done .tl-dot { background: var(--color-accent); }
    .tl-item-warn .tl-dot { border-color: var(--color-warn); }
    .tl-time { font-size: var(--text-xs); color: var(--color-ink-3); font-family: var(--font-mono); }
    .tl-title { font-size: var(--text-md); font-weight: var(--weight-medium); color: var(--color-ink); margin-top: 2px; }
    .tl-desc { font-size: var(--text-sm); color: var(--color-ink-2); margin-top: 2px; }
    .stage-row { display: flex; align-items: center; gap: var(--space-2); }
    .stage-pill { padding: 4px 10px; border-radius: var(--radius-pill); font-size: var(--text-xs); font-weight: var(--weight-medium); background: var(--color-surface-2); color: var(--color-ink-3); }
    .stage-pill.is-active { background: var(--color-accent); color: var(--color-accent-ink); }
    .stage-pill.is-done { background: var(--color-success); color: var(--color-ink-inv); }
    .stage-line { flex: 1; height: 1px; background: var(--color-line); min-width: 16px; }
    .stage-line.is-done { background: var(--color-success); }
    .biz-card { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3); border-radius: var(--radius-sm); background: var(--color-surface-2); }
    .biz-card-icon { width: 36px; height: 36px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; }

    /* B1 增强 */
    @keyframes grow-bar { from { width: 0 !important; } }
    .progress-bar.animate-in { animation: grow-bar 900ms var(--ease-out) forwards; }
    .inline-edit-form { display: none; padding: var(--space-4); background: var(--color-accent-softer); border: 1px solid var(--color-accent-soft); border-radius: var(--radius-sm); margin-top: var(--space-3); }
    .inline-edit-form.is-open { display: block; }
    .form-error-hint { color: var(--color-danger); font-size: var(--text-xs); margin-top: var(--space-1); min-height: 14px; }
    .required-mark { color: var(--color-danger); margin-left: 2px; }
    .followup-add { padding: var(--space-3); background: var(--color-surface-2); border-radius: var(--radius-sm); margin-top: var(--space-3); }
    .quick-action-row { display: flex; gap: var(--space-2); flex-wrap: wrap; }

    /* B1 增强（数据密度） */
    .tag-cloud { display: flex; flex-wrap: wrap; gap: var(--space-2); }
    .tag-cloud-item {
      display: inline-flex; align-items: center; gap: 4px;
      padding: 4px 10px; border-radius: var(--radius-pill);
      font-size: var(--text-sm);
      background: var(--color-surface-2); color: var(--color-ink-2);
      border: 1px solid var(--color-line);
    }
    .tag-cloud-item .tag-label { color: var(--color-ink-3); font-size: var(--text-xs); }
    .tag-cloud-item .tag-val { color: var(--color-ink); font-weight: var(--weight-medium); }
    .tag-cloud-item.primary { background: var(--color-accent-soft); color: var(--color-accent); border-color: var(--color-accent-soft); }
    .tag-cloud-item.primary .tag-val { color: var(--color-accent); }
    .tag-cloud-item.warn { background: var(--color-warn-soft); color: var(--color-warn-2); border-color: var(--color-warn-soft); }
    .tag-cloud-item.warn .tag-val { color: var(--color-warn-2); }
    .tag-cloud-item.danger { background: var(--color-danger-soft); color: var(--color-danger); border-color: var(--color-danger-soft); }
    .tag-cloud-item.danger .tag-val { color: var(--color-danger); }

    .history-item {
      display: flex; align-items: center; gap: var(--space-3);
      padding: var(--space-3) 0;
      border-bottom: 1px solid var(--color-line);
    }
    .history-item:last-child { border-bottom: none; }
    .history-icon {
      width: 32px; height: 32px; border-radius: var(--radius-sm);
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; font-family: var(--font-display); font-weight: var(--weight-semibold); font-size: 13px;
    }
    .history-body { flex: 1; min-width: 0; }
    .history-title { font-size: var(--text-md); color: var(--color-ink); font-weight: var(--weight-medium); }
    .history-meta { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; }
    .history-status { font-size: var(--text-xs); padding: 2px 8px; border-radius: var(--radius-pill); font-weight: var(--weight-medium); }
    .status-done { background: var(--color-success-soft); color: var(--color-success); }
    .status-active { background: var(--color-accent-soft); color: var(--color-accent); }
    .status-pending { background: var(--color-warn-soft); color: var(--color-warn-2); }

    .network-mini {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr 1fr;
      gap: var(--space-3);
      align-items: center;
    }
    .network-mini-self {
      grid-column: 1 / 5;
      display: flex; justify-content: center; padding: var(--space-2) 0;
    }
    .network-mini-row {
      display: contents;
    }
    .network-mini-node {
      display: flex; flex-direction: column; align-items: center; gap: 4px;
      padding: var(--space-2); border: 1px solid var(--color-line);
      border-radius: var(--radius-sm);
      background: var(--color-surface);
      transition: border-color var(--dur-fast) var(--ease-out);
    }
    .network-mini-node:hover { border-color: var(--color-accent); }
    .network-mini-name { font-size: var(--text-xs); font-weight: var(--weight-medium); color: var(--color-ink); text-align: center; }
    .network-mini-meta { font-size: 10px; color: var(--color-ink-3); }

    .next-step-card {
      display: flex; align-items: flex-start; gap: var(--space-3);
      padding: var(--space-3); border: 1px solid var(--color-line);
      border-radius: var(--radius-sm);
      background: var(--color-surface);
    }
    .next-step-num {
      width: 28px; height: 28px; border-radius: 50%;
      background: var(--color-accent); color: var(--color-accent-ink);
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-mono); font-size: var(--text-xs); font-weight: var(--weight-semibold);
      flex-shrink: 0;
    }
    .next-step-body { flex: 1; min-width: 0; }
    .next-step-title { font-size: var(--text-md); font-weight: var(--weight-semibold); color: var(--color-ink); }
    .next-step-desc { font-size: var(--text-sm); color: var(--color-ink-2); margin-top: 4px; line-height: 1.6; }
    .next-step-meta { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-2); }

    .risk-card { padding: var(--space-3); border-radius: var(--radius-sm); background: var(--color-warn-soft); border-left: 3px solid var(--color-warn-2); }
    .risk-card.danger { background: var(--color-danger-soft); border-left-color: var(--color-danger); }
    .risk-card.info { background: var(--color-info-soft); border-left-color: var(--color-info); }
    .risk-title { font-size: var(--text-sm); font-weight: var(--weight-semibold); color: var(--color-ink); }
    .risk-desc { font-size: var(--text-xs); color: var(--color-ink-2); margin-top: 4px; line-height: 1.6; }
    .risk-action { font-size: var(--text-xs); color: var(--color-accent); margin-top: 4px; display: inline-flex; align-items: center; gap: 2px; }

    /* 联系记录 5 项必填 (PRD CRM-006) */
    .contact-form { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: var(--space-3); }
    .contact-form-field { display: flex; flex-direction: column; gap: 4px; }
    .contact-form-label { font-size: var(--text-xs); color: var(--color-ink-3); font-weight: var(--weight-medium); }
    .contact-form-label .req { color: var(--color-danger); }
    .contact-form-input, .contact-form-select, .contact-form-textarea {
      padding: 8px 10px; border: 1px solid var(--color-line); border-radius: var(--radius-sm);
      font-size: var(--text-sm); background: var(--color-surface); color: var(--color-ink);
      font-family: inherit;
    }
    .contact-form-textarea { min-height: 60px; resize: vertical; }

    /* 联系方式审计提示 (PRD CRM-010 / §3.4) */
    .export-watermark-notice {
      padding: var(--space-3); background: var(--color-warn-soft);
      border: 1px solid var(--color-warn-soft); border-radius: var(--radius-sm);
      font-size: var(--text-xs); color: var(--color-ink-2);
    }
    .export-watermark-notice strong { color: var(--color-ink); }
    .audit-log-entry { display: grid; grid-template-columns: 140px 1fr 1fr; gap: var(--space-3); padding: var(--space-2) 0; border-bottom: 1px solid var(--color-line); font-size: var(--text-xs); }
    .audit-log-entry:last-child { border-bottom: none; }
    .audit-log-time { font-family: var(--font-mono); color: var(--color-ink-3); }
    .audit-log-actor { color: var(--color-ink); font-weight: var(--weight-medium); }
    .audit-log-action { color: var(--color-ink-2); }

    /* 字段来源标签 (PRD PRO-003) */
    .field-source { display: inline-flex; align-items: center; gap: 2px; padding: 1px 6px; border-radius: var(--radius-xs); font-size: 10px; font-weight: var(--weight-medium); margin-left: 4px; vertical-align: middle; }
    .field-source-self { background: var(--color-surface-2); color: var(--color-ink-2); }
    .field-source-platform { background: var(--color-info-soft); color: var(--color-info); }
    .field-source-verified { background: var(--color-success-soft); color: var(--color-success); }
    .field-source-ai { background: var(--color-accent-soft); color: var(--color-accent); }
    .field-verified-badge { display: inline-flex; align-items: center; gap: 2px; padding: 1px 6px; background: var(--color-success-soft); color: var(--color-success); border-radius: var(--radius-xs); font-size: 10px; font-weight: var(--weight-semibold); margin-left: 4px; vertical-align: middle; }
    .field-unverified-badge { display: inline-flex; align-items: center; gap: 2px; padding: 1px 6px; background: var(--color-surface-2); color: var(--color-ink-3); border: 1px dashed var(--color-line-2); border-radius: var(--radius-xs); font-size: 10px; font-weight: var(--weight-medium); margin-left: 4px; vertical-align: middle; }

    /* 版本历史 (PRD PRO-006) */
    .version-timeline { display: flex; flex-direction: column; gap: var(--space-2); }
    .version-item { display: grid; grid-template-columns: 100px 1fr 180px; gap: var(--space-3); padding: var(--space-2) 0; border-bottom: 1px solid var(--color-line); font-size: var(--text-sm); }
    .version-item:last-child { border-bottom: none; }
    .version-time { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-ink-3); }
    .version-changes { color: var(--color-ink-2); }
    .version-diff { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; }
    .version-diff .old { background: var(--color-danger-soft); color: var(--color-danger); padding: 1px 4px; border-radius: 2px; text-decoration: line-through; }
    .version-diff .new { background: var(--color-success-soft); color: var(--color-success); padding: 1px 4px; border-radius: 2px; }

    /* 字段来源图例 */
    .field-source-legend { display: flex; flex-wrap: wrap; gap: var(--space-3); padding: var(--space-2) var(--space-3); background: var(--color-surface-2); border-radius: var(--radius-sm); font-size: var(--text-xs); color: var(--color-ink-3); }
    .field-source-legend-item { display: inline-flex; align-items: center; gap: 4px; }
  </style>
