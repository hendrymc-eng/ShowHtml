  (function () {
    var bars = document.querySelectorAll('.progress-bar');
    if ('IntersectionObserver' in window) {
      var obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add('animate-in'); obs.unobserve(e.target); }
        });
      }, { threshold: 0.3 });
      bars.forEach(function (b) { obs.observe(b); });
    } else {
      bars.forEach(function (b) { b.classList.add('animate-in'); });
    }
  })();

  // B1 增强：filter chip 联动（互斥：付费/免费/即将到期/流失风险 + 申请支持/服务中叠加）
  (function () {
    var chips = document.querySelectorAll('.filter-bar .filter-chip[data-filter]');
    var rows = document.querySelectorAll('tr.js-searchable');
    function applyFilter() {
      var active = [];
      chips.forEach(function (c) { if (c.classList.contains('is-active')) active.push(c.getAttribute('data-filter')); });
      var isAll = active.indexOf('all') >= 0;
      var q = document.querySelector('.js-row-search').value.trim().toLowerCase();
      var visibleCount = 0;
      rows.forEach(function (row) {
        var cat = (row.getAttribute('data-cat') || '').toLowerCase();
        var key = (row.getAttribute('data-search') || '').toLowerCase();
        var passFilter = isAll;
        if (!passFilter) {
          passFilter = active.every(function (f) { return cat.indexOf(f) >= 0; });
        }
        var passSearch = !q || key.indexOf(q) >= 0;
        var show = passFilter && passSearch;
        row.style.display = show ? '' : 'none';
        if (show) visibleCount++;
      });
      // 更新分页显示
      var pagination = document.querySelector('.text-sm.text-ink-3');
      if (pagination && pagination.textContent.indexOf('条') >= 0) {
        pagination.textContent = '显示 1-' + visibleCount + ' / 86 条';
      }
    }
    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        var f = chip.getAttribute('data-filter');
        if (f === 'all') {
          chips.forEach(function (c) { c.classList.remove('is-active'); });
          chip.classList.add('is-active');
        } else {
          // 点击非全部时，取消"全部"，可与其他非全部 chip 共存
          var allChip = document.querySelector('.filter-chip[data-filter="all"]');
          if (allChip) allChip.classList.remove('is-active');
          chip.classList.toggle('is-active');
          // 检查是否还有非全部激活
          var anyActive = Array.from(chips).some(function (c) { return c.getAttribute('data-filter') !== 'all' && c.classList.contains('is-active'); });
          if (!anyActive && allChip) allChip.classList.add('is-active');
        }
        applyFilter();
      });
    });
    // 搜索时也走同一逻辑
    var search = document.querySelector('.js-row-search');
    if (search) {
      search.addEventListener('input', applyFilter);
    }
  })();

