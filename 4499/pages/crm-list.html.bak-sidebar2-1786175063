        var m = document.getElementById('modal-new-client');
        if (m) {
          m.classList.add('is-open');
          var bd = document.querySelector('[data-modal-backdrop="modal-new-client"]');
          if (bd) bd.classList.add('is-open');
          document.body.style.overflow = 'hidden';
        } else {
          toast('请在「我的工作台」新建客户', 'info');
        }
      } else if (txt === '导出') {
        // 由 modal 处理
      } else if (txt === '电话联系' || txt === 'UMAX') {
        toast('已发起联系', 'success');
      } else if (txt === '详情') {
        toast('正在打开客户详情', 'info');
      } else if (txt === '执行建议') {
        toast('已执行 AI 建议', 'success');
      }
    });

    // 确认导出
    document.addEventListener('click', function (e) {
      var a = e.target.closest('[data-action]');
      if (a && a.getAttribute('data-action') === 'confirm-export') {
        var fmt = document.querySelector('input[name="export-fmt"]:checked');
        var range = document.querySelector('input[name="export-range"]:checked');
        var rangeText = range ? range.parentElement.textContent.trim().split(' ')[0] : '当前';
        toast('已生成 ' + rangeText + ' ' + (fmt ? fmt.value.toUpperCase() : 'XLSX') + ' 报表', 'success');
        setTimeout(function () {
          var m = document.getElementById('modal-export');
          if (m) m.classList.remove('is-open');
          var bd = document.querySelector('[data-modal-backdrop="modal-export"]');
          if (bd) bd.classList.remove('is-open');
          document.body.style.overflow = '';
        }, 500);
      }
    });

    // 单选互斥样式（export-option）
    document.querySelectorAll('.export-option').forEach(function (opt) {
      opt.addEventListener('click', function () {
        document.querySelectorAll('.export-option').forEach(function (o) { o.classList.remove('is-active'); });
        opt.classList.add('is-active');
        var input = opt.querySelector('input');
        if (input) { input.checked = true; }
      });
    });
  })();

  // B1 增强：新建客户表单验证 + 提交
  (function () {
    document.addEventListener('click', function (e) {
      var a = e.target.closest('[data-action]');
      if (!a || a.getAttribute('data-action') !== 'submit-new-client') return;
      var form = document.getElementById('form-new-client');
      if (!form) return;
      var name = form.querySelector('[name="name"]').value.trim();
      var phone = form.querySelector('[name="phone"]').value.trim();
      var source = form.querySelector('[name="source"]').value;
      var ok = true;
      function setErr(field, msg) {
        var el = form.querySelector('[data-error-for="' + field + '"]');
        if (el) el.textContent = msg || '';
        var input = form.querySelector('[name="' + field + '"]');
        if (input) { if (msg) input.setAttribute('data-state', 'error'); else input.removeAttribute('data-state'); }
      }
      if (!name) { setErr('name', '请填写姓名'); ok = false; } else setErr('name', '');
      if (!phone) { setErr('phone', '请填写手机号'); ok = false; }
      else if (!/^1[3-9]\d{9}$/.test(phone)) { setErr('phone', '手机号格式不正确'); ok = false; }
      else setErr('phone', '');
      if (!source) { setErr('source', '请选择客户来源'); ok = false; } else setErr('source', '');
      if (!ok) { toast('请填写所有必填项', 'error'); return; }
      toast('客户创建成功', 'success');
      form.reset();
      setTimeout(function () {
        var m = document.getElementById('modal-new-client');
        if (m) m.classList.remove('is-open');
        var bd = document.querySelector('[data-modal-backdrop="modal-new-client"]');
        if (bd) bd.classList.remove('is-open');
        document.body.style.overflow = '';
      }, 400);
    });

    // 失焦验证
    var form = document.getElementById('form-new-client');
    if (form) {
      form.querySelectorAll('[name]').forEach(function (el) {
        el.addEventListener('blur', function () {
          var n = el.getAttribute('name');
          var v = el.value.trim();
          var errEl = form.querySelector('[data-error-for="' + n + '"]');
          if (n === 'name' && !v) { if (errEl) errEl.textContent = '请填写姓名'; el.setAttribute('data-state', 'error'); }
          if (n === 'phone' && v && !/^1[3-9]\d{9}$/.test(v)) { if (errEl) errEl.textContent = '手机号格式不正确'; el.setAttribute('data-state', 'error'); }
          if (n === 'source' && !v) { if (errEl) errEl.textContent = '请选择客户来源'; el.setAttribute('data-state', 'error'); }
        });
        el.addEventListener('input', function () {
          if (el.getAttribute('data-state') === 'error' && el.value.trim()) {
            el.removeAttribute('data-state');
            var errEl = form.querySelector('[data-error-for="' + el.getAttribute('name') + '"]');
            if (errEl) errEl.textContent = '';
          }
        });
      });
    }
  })();
</script>
</body>
</html>
