  <style>
    .crm-layout { display: grid; grid-template-columns: 1fr 360px; gap: var(--space-6); align-items: start; }
    @media (max-width: 1280px) { .crm-layout { grid-template-columns: 1fr; } .crm-side { display: none; } }
    .stat-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-3); }
    @media (max-width: 1024px) { .stat-row { grid-template-columns: repeat(2, 1fr); } }
    .stat-mini { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-md); padding: var(--space-4); }
    .stat-mini-label { font-size: var(--text-sm); color: var(--color-ink-3); }
    .stat-mini-value { font-family: var(--font-display); font-size: var(--text-2xl); font-weight: var(--weight-semibold); margin-top: var(--space-1); }
    .stat-mini-delta { font-size: var(--text-xs); margin-top: 2px; }
    .row-avatar { display: flex; align-items: center; gap: var(--space-3); }
    .row-name { font-weight: var(--weight-medium); color: var(--color-ink); }
    .row-id { font-size: var(--text-xs); color: var(--color-ink-3); font-family: var(--font-mono); }
    .tag-stack { display: flex; gap: var(--space-1); flex-wrap: wrap; }
    .crm-side { position: sticky; top: calc(var(--topbar-height) + var(--space-4)); }
    .ai-mini { background: linear-gradient(135deg, var(--color-accent-softer) 0%, var(--color-surface) 100%); border: 1px solid var(--color-accent-soft); border-radius: var(--radius-md); padding: var(--space-4); }
    .ai-mini-title { font-size: var(--text-sm); font-weight: var(--weight-semibold); color: var(--color-ink); margin-bottom: var(--space-2); }
    .ai-mini-item { display: flex; align-items: flex-start; gap: var(--space-2); padding: var(--space-2) 0; border-top: 1px solid var(--color-accent-soft); font-size: var(--text-sm); color: var(--color-ink-2); }
    .ai-mini-item:first-of-type { border-top: none; }

    /* B1 增强 */
    @keyframes grow-bar { from { width: 0 !important; } }
    .progress-bar.animate-in { animation: grow-bar 900ms var(--ease-out) forwards; }
    .table tbody tr { transition: background var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out); }
    .table tbody tr.js-row-select:hover { cursor: pointer; background: var(--color-surface-2); }
    .filter-bar .filter-chip { user-select: none; }
    .filter-bar .filter-chip.is-active { background: var(--color-accent-soft); color: var(--color-accent); border-color: var(--color-accent-soft); }
    .export-option { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3); border: 1px solid var(--color-line); border-radius: var(--radius-sm); cursor: pointer; transition: all var(--dur-fast) var(--ease-out); }
    .export-option:hover { border-color: var(--color-accent); background: var(--color-accent-softer); }
    .export-option.is-active { border-color: var(--color-accent); background: var(--color-accent-softer); }
    .export-option input { display: none; }
    .export-option-icon { width: 36px; height: 36px; border-radius: var(--radius-sm); background: var(--color-surface-2); display: flex; align-items: center; justify-content: center; }
    .export-option.is-active .export-option-icon { background: var(--color-accent); color: var(--color-accent-ink); }
    .form-error-hint { color: var(--color-danger); font-size: var(--text-xs); margin-top: var(--space-1); min-height: 14px; }
    .required-mark { color: var(--color-danger); margin-left: 2px; }

    /* B1 增强（数据密度） */
    .row-tier { display: inline-flex; align-items: center; gap: 3px; padding: 1px 6px; border-radius: var(--radius-xs); font-size: var(--text-xs); font-weight: var(--weight-medium); }
    .row-tier-vip { background: var(--color-warn-soft); color: var(--color-warn-2); }
    .row-tier-std { background: var(--color-surface-2); color: var(--color-ink-2); }
    .row-tier-ent { background: var(--color-accent-soft); color: var(--color-accent); }
    .row-tier-free { background: var(--color-surface-2); color: var(--color-ink-3); }
    .row-tag { display: inline-block; padding: 1px 6px; border-radius: var(--radius-xs); font-size: 10px; font-weight: var(--weight-medium); margin-right: 2px; }
    .row-tag-high-value { background: var(--color-biz-poif); color: var(--color-ink-inv); }
    .row-tag-renew-risk { background: var(--color-danger-soft); color: var(--color-danger); }
    .row-tag-upgrade-signal { background: var(--color-success-soft); color: var(--color-success); }
    .row-tag-inactive { background: var(--color-warn-soft); color: var(--color-warn-2); }
    .row-tag-active { background: var(--color-info-soft); color: var(--color-info); }

    .row-meta { display: flex; align-items: center; gap: 4px; font-size: var(--text-xs); color: var(--color-ink-3); }

    /* 区域分布柱状图 */
    .region-bar-row { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-2) 0; }
    .region-bar-label { width: 64px; font-size: var(--text-sm); color: var(--color-ink-2); flex-shrink: 0; display: flex; align-items: center; gap: 4px; }
    .region-bar-track { flex: 1; height: 18px; background: var(--color-surface-2); border-radius: var(--radius-xs); overflow: hidden; }
    .region-bar-fill { height: 100%; background: var(--color-accent); border-radius: var(--radius-xs); transition: width var(--dur-slow) var(--ease-out); }
    .region-bar-fill.top1 { background: var(--color-accent); }
    .region-bar-fill.top2 { background: var(--color-info); }
    .region-bar-fill.top3 { background: var(--color-success); }
    .region-bar-val { width: 80px; text-align: right; font-size: var(--text-sm); font-family: var(--font-mono); font-weight: var(--weight-medium); }
    .region-bar-pct { color: var(--color-ink-3); font-size: 11px; margin-left: 4px; }

    /* 活跃度趋势（折线图） */
    .trend-line-svg { width: 100%; height: 180px; }
    .trend-legend { display: flex; gap: var(--space-4); align-items: center; }
    .trend-legend-item { display: flex; align-items: center; gap: 4px; font-size: var(--text-xs); color: var(--color-ink-2); }
    .trend-legend-dot { width: 8px; height: 8px; border-radius: 50%; }
  </style>
</head>
