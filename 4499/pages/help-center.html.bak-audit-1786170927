    .footer-col h4 { color: #fff; font-size: var(--text-sm); font-weight: var(--weight-semibold); margin: 0 0 var(--space-4); }
    .footer-col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-2); }
