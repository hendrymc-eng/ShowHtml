      font-family: var(--font-display);
      font-weight: var(--weight-semibold);
      font-size: var(--text-lg);
      color: var(--color-ink);
      text-decoration: none;
      letter-spacing: -0.01em;
    }
    .site-brand-mark {
      width: 28px; height: 28px;
      border-radius: var(--radius-sm);
      background: linear-gradient(135deg, var(--color-accent), var(--color-accent-2));
      color: var(--color-accent-ink);
      display: inline-flex; align-items: center; justify-content: center;
      font-weight: var(--weight-bold);
      font-size: var(--text-sm);
      font-family: var(--font-display);
    }
    .site-menu { display: flex; align-items: center; gap: var(--space-1); flex: 1; }
    .site-menu a {
      padding: var(--space-2) var(--space-3);
      border-radius: var(--radius-sm);
      color: var(--color-ink-2);
      font-size: var(--text-md);
      font-weight: var(--weight-medium);
      text-decoration: none;
      transition: color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
    }
    .site-menu a:hover { color: var(--color-ink); background: var(--color-surface-2); }
    .site-menu a.is-current { color: var(--color-ink); }
    .site-actions { display: flex; align-items: center; gap: var(--space-2); }
    .nav-toggle { display: none; }

