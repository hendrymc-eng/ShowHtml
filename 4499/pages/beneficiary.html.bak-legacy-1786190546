  <style>
    .bene-layout { display: grid; grid-template-columns: 1fr 360px; gap: var(--space-6); align-items: start; }
    @media (max-width: 1280px) { .bene-layout { grid-template-columns: 1fr; } .bene-side { display: none; } }
    .asset-overview {
      background: linear-gradient(135deg, var(--color-accent-softer) 0%, var(--color-surface) 100%);
      border: 1px solid var(--color-accent-soft);
      border-radius: var(--radius-md);
      padding: var(--space-6);
      margin-bottom: var(--space-6);
    }
    .asset-row { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: var(--space-4); margin-top: var(--space-4); }
    @media (max-width: 768px) { .asset-row { grid-template-columns: repeat(2, 1fr); } }
    .asset-tile { padding: var(--space-3); background: var(--color-surface); border-radius: var(--radius-sm); border: 1px solid var(--color-line); }
    .asset-name { font-size: var(--text-sm); color: var(--color-ink-2); }
    .asset-value { font-family: var(--font-mono); font-size: var(--text-xl); font-weight: var(--weight-semibold); margin-top: var(--space-1); }
    .asset-tile.is-inheritable .asset-name::after { content: '可传承'; font-size: var(--text-xs); color: var(--color-success); margin-left: var(--space-1); padding: 1px 4px; background: var(--color-success-soft); border-radius: var(--radius-xs); }
    .ratio-ring { width: 64px; height: 64px; position: relative; flex-shrink: 0; }
    .ratio-ring svg { transform: rotate(-90deg); }
    .ratio-ring-bg { fill: none; stroke: var(--color-surface-2); stroke-width: 6; }
    .ratio-ring-fg { fill: none; stroke-width: 6; stroke-linecap: round; }
    .ratio-num { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-size: var(--text-md); font-weight: var(--weight-semibold); color: var(--color-ink); }
    .bene-card { display: flex; align-items: center; gap: var(--space-4); padding: var(--space-4); border: 1px solid var(--color-line); border-radius: var(--radius-md); background: var(--color-surface); margin-bottom: var(--space-3); transition: all var(--dur-fast) var(--ease-out); }
    .bene-card:hover { border-color: var(--color-line-2); }
    .bene-card.is-primary { border-color: var(--color-accent); background: var(--color-accent-softer); }
    .bene-info { flex: 1; min-width: 0; }
    .bene-name { font-size: var(--text-md); font-weight: var(--weight-semibold); color: var(--color-ink); display: flex; align-items: center; gap: var(--space-2); }
    .bene-detail { font-size: var(--text-sm); color: var(--color-ink-3); margin-top: 2px; }
    .warn-strip { background: var(--color-warn-softer); border-left: 3px solid var(--color-warn); padding: var(--space-3); border-radius: var(--radius-sm); margin-bottom: var(--space-4); }
    .warn-strip-text { font-size: var(--text-sm); color: var(--color-ink-2); }

    /* B1 增强：内联编辑 + 比例拖动 */
    .bene-card.is-editing { border-color: var(--color-accent); border-width: 2px; background: var(--color-accent-softer); }
    .bene-edit-form { display: none; padding: var(--space-3); background: var(--color-surface); border: 1px solid var(--color-accent-soft); border-radius: var(--radius-sm); margin-top: var(--space-3); }
    .bene-edit-form.is-open { display: block; }
    .ratio-input { display: flex; align-items: center; gap: var(--space-3); }
    .ratio-input input[type="range"] { flex: 1; }
    .ratio-input .ratio-display { font-family: var(--font-mono); font-weight: var(--weight-semibold); min-width: 48px; text-align: right; }
    .required-mark { color: var(--color-danger); margin-left: 2px; }
    .form-error-hint { color: var(--color-danger); font-size: var(--text-xs); margin-top: var(--space-1); min-height: 14px; }
    @keyframes grow-bar { from { width: 0 !important; } }
    .progress-bar.animate-in { animation: grow-bar 900ms var(--ease-out) forwards; }

    /* B2 新增：分配可视化 / 触发条件 / 验证记录 / 注意事项 */
    .alloc-donut { position: relative; width: 200px; height: 200px; flex-shrink: 0; }
    .alloc-donut svg { transform: rotate(-90deg); }
    .alloc-donut-bg { fill: none; stroke: var(--color-surface-2); stroke-width: 24; }
    .alloc-donut-fg { fill: none; stroke-width: 24; transition: stroke-dashoffset 600ms var(--ease-out); }
    .alloc-donut-center { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .alloc-donut-num { font-family: var(--font-display); font-size: var(--text-3xl); font-weight: var(--weight-semibold); color: var(--color-ink); }
    .alloc-donut-lbl { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; }
    .alloc-legend { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: var(--space-2); }
    .alloc-row { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-2) 0; border-bottom: 1px dashed var(--color-line); }
    .alloc-row:last-child { border-bottom: none; }
    .alloc-color { width: 12px; height: 12px; border-radius: 3px; flex-shrink: 0; }
    .alloc-name { flex: 1; font-size: var(--text-sm); color: var(--color-ink); }
    .alloc-pct { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--color-ink); font-weight: var(--weight-medium); }
    .alloc-status { font-size: var(--text-xs); color: var(--color-ink-3); margin-left: var(--space-2); }

    .trigger-card { padding: var(--space-3); border: 1px solid var(--color-line); border-radius: var(--radius-md); background: var(--color-surface); }
    .trigger-card-head { display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-2); }
    .trigger-icon { width: 28px; height: 28px; border-radius: var(--radius-sm); background: var(--color-accent-soft); color: var(--color-accent); display: flex; align-items: center; justify-content: center; font-size: var(--text-md); flex-shrink: 0; }
    .trigger-name { font-size: var(--text-sm); font-weight: var(--weight-medium); color: var(--color-ink); }
    .trigger-desc { font-size: var(--text-xs); color: var(--color-ink-3); line-height: var(--leading-snug); }
    .trigger-source { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: var(--space-1); }

    .verify-row { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3); border: 1px solid var(--color-line); border-radius: var(--radius-sm); background: var(--color-surface); }
    .verify-row + .verify-row { margin-top: var(--space-2); }
    .verify-status-badge { padding: 2px 8px; border-radius: var(--radius-pill); font-size: var(--text-xs); font-weight: var(--weight-medium); }
    .verify-status-badge.is-pass { background: var(--color-success-soft); color: var(--color-success-2); }
    .verify-status-badge.is-pending { background: var(--color-warn-soft); color: var(--color-warn-2); }
    .verify-status-badge.is-fail { background: var(--color-danger-soft); color: var(--color-danger-2); }
    .verify-row-main { flex: 1; min-width: 0; }
    .verify-row-name { font-size: var(--text-sm); color: var(--color-ink); font-weight: var(--weight-medium); }
    .verify-row-meta { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; }
    .verify-row-time { font-size: var(--text-xs); color: var(--color-ink-3); font-family: var(--font-mono); }

    .caution-item { display: flex; gap: var(--space-3); padding: var(--space-3); border-left: 3px solid var(--color-warn); background: var(--color-warn-softer); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; }
    .caution-item + .caution-item { margin-top: var(--space-2); }
    .caution-icon { flex-shrink: 0; width: 24px; height: 24px; border-radius: 50%; background: var(--color-warn); color: var(--color-ink-inv); display: flex; align-items: center; justify-content: center; font-size: var(--text-sm); }
    .caution-title { font-size: var(--text-sm); font-weight: var(--weight-medium); color: var(--color-ink); margin-bottom: 2px; }
    .caution-desc { font-size: var(--text-xs); color: var(--color-ink-2); line-height: var(--leading-snug); }
  </style>
</head>
