                <tr>
                  <td class="benef-diff-name">配偶 · 林 XX</td>
                  <td class="benef-diff-pct">50%</td>
                  <td class="benef-diff-pct">50%</td>
                  <td><span class="benef-diff-pill benef-diff-pill-equal">一致</span></td>
                </tr>
                <tr>
                  <td class="benef-diff-name">长子 · 林子 X</td>
                  <td class="benef-diff-pct">25%</td>
                  <td class="benef-diff-pct">30%</td>
                  <td><span class="benef-diff-pill benef-diff-pill-warn">差异 5%</span></td>
                </tr>
                <tr class="is-diff">
                  <td class="benef-diff-name">次子 · 林子 X</td>
                  <td class="benef-diff-pct">25%</td>
                  <td class="benef-diff-pct">20%</td>
                  <td><span class="benef-diff-pill benef-diff-pill-warn">差异 5%</td>
