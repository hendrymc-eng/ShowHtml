</main>
  </div>

  <!-- ========== B1 增强：添加受益人 Modal ========== -->
  <div class="modal-backdrop" data-modal-backdrop="modal-add-bene"></div>
  <div class="modal" id="modal-add-bene" data-modal>
    <div class="modal-panel">
      <div class="modal-header">
        <div>
          <div class="modal-title">添加受益人</div>
          <div class="text-xs text-ink-3 mt-1">需在 OpulnX 注册并完成 KYC 后可激活</div>
        </div>
        <div class="modal-close" data-modal-close="modal-add-bene">✕</div>
      </div>
      <form class="modal-body" novalidate>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:var(--space-3);">
          <div class="input-group">
            <label class="input-label">姓名<span class="required-mark">*</span></label>
            <input class="input" name="name" placeholder="受益人姓名" />
            <div class="form-error-hint" data-error-for="add-name"></div>
          </div>
          <div class="input-group">
            <label class="input-label">关系<span class="required-mark">*</span></label>
            <select class="select" name="rel">
              <option value="">请选择</option>
              <option>父子</option><option>父女</option><option>母子</option><option>母女</option><option>配偶</option><option>其他</option>
            </select>
            <div class="form-error-hint" data-error-for="add-rel"></div>
          </div>
          <div class="input-group">
            <label class="input-label">身份证号<span class="required-mark">*</span></label>
            <input class="input" name="idcard" placeholder="18 位身份证号" maxlength="18" />
            <div class="form-error-hint" data-error-for="add-idcard"></div>
          </div>
          <div class="input-group">
            <label class="input-label">手机号<span class="required-mark">*</span></label>
            <input class="input" name="phone" placeholder="11 位手机号" maxlength="11" />
            <div class="form-error-hint" data-error-for="add-phone"></div>
          </div>
        </div>
        <div class="input-group" style="margin-top: var(--space-3);">
          <label class="input-label">邮箱</label>
          <input class="input" name="email" placeholder="可选 · 用于通知" />
        </div>
        <div class="input-group" style="margin-top: var(--space-3);">
          <label class="input-label">受益比例 <span id="add-ratio-val" class="text-mono fw-medium" style="color: var(--color-accent);">0%</span><span class="required-mark">*</span></label>
          <div class="ratio-input">
            <input type="range" name="ratio" min="0" max="100" value="0" id="add-ratio" data-target-display="add-ratio-val" />
          </div>
          <div class="input-hint">剩余比例：<span id="add-ratio-remain" class="fw-medium">100%</span>（建议不与现有受益人冲突）</div>
        </div>
        <div class="input-group" style="margin-top: var(--space-3);">
          <label class="input-label">适用资产范围</label>
          <div style="display:flex; gap:var(--space-2); flex-wrap:wrap;">
            <label class="check-pill is-active js-check-pill"><input type="checkbox" checked>POE</label>
            <label class="check-pill is-active js-check-pill"><input type="checkbox" checked>UMDT</label>
            <label class="check-pill is-active js-check-pill"><input type="checkbox" checked>钱包</label>
            <label class="check-pill js-check-pill"><input type="checkbox">RWA 持仓</label>
            <label class="check-pill js-check-pill"><input type="checkbox">可传承项目代币</label>
          </div>
        </div>
        <div class="warn-box" style="margin-top: var(--space-4);">
          <div class="warn-box-text">⚠ <strong>高等级验证</strong>：修改受益人为高敏感操作，提交后将要求人脸识别 + 短信验证。所有修改会留痕，可在「修改记录」中查看。</div>
        </div>
      </form>
      <div class="modal-footer">
        <button class="btn btn-ghost" data-modal-close="modal-add-bene">取消</button>
        <button class="btn btn-primary" data-action="submit-bene">+ 添加受益人</button>
      </div>
    </div>
  </div>

<script src="../js/app.js"></script>
<script>
  // B1 增强：进度条入场动画
  (function () {
    var bars = document.querySelectorAll('.progress-bar');
    if ('IntersectionObserver' in window) {
      var obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('animate-in'); obs.unobserve(e.target); } });
      }, { threshold: 0.3 });
      bars.forEach(function (b) { obs.observe(b); });
    }
  })();

  // B1 增强：内联编辑（修改按钮）
  document.addEventListener('click', function (e) {
    var a = e.target.closest('[data-action]');
    if (!a) return;
    var action = a.getAttribute('data-action');
    if (action === 'edit-bene') {
      var card = a.closest('.bene-card');
      if (!card) return;
      var id = card.getAttribute('data-bene-id');
      var form = document.getElementById('edit-' + id);
      if (!form) return;
      // 关闭其他
      document.querySelectorAll('.bene-edit-form.is-open').forEach(function (f) { f.classList.remove('is-open'); });
      document.querySelectorAll('.bene-card.is-editing').forEach(function (c) { c.classList.remove('is-editing'); });
      form.classList.add('is-open');
      card.classList.add('is-editing');
      toast('编辑模式已开启', 'info');
    } else if (action === 'cancel-bene') {
      var form = a.closest('.bene-edit-form');
      if (form) form.classList.remove('is-open');
      var card = a.closest('.bene-card');
      if (card) card.classList.remove('is-editing');
    } else if (action === 'save-bene') {
      var form = a.closest('.bene-edit-form');
      if (!form) return;
      var card = form.closest('.bene-card');
      var id = card ? card.getAttribute('data-bene-id') : '';
      var nameInput = form.querySelector('[name="name"]');
      var name = nameInput ? nameInput.value.trim() : '';
      var errEl = form.querySelector('[data-error-for="b-' + id + '-name"]');
      if (!name) {
        if (errEl) errEl.textContent = '姓名不能为空';
        if (nameInput) nameInput.setAttribute('data-state', 'error');
        toast('请填写姓名', 'error');
        return;
      } else {
        if (errEl) errEl.textContent = '';
        if (nameInput) nameInput.removeAttribute('data-state');
      }
      // 同步到卡片视图
      var nameEl = card.querySelector('.bene-name');
      if (nameEl) {
        var firstChild = nameEl.firstChild;
        if (firstChild) firstChild.textContent = name;
      }
      // 同步比例到 ratio-ring + 数字
      var ratio = form.querySelector('[name="ratio"]').value;
      var numEl = card.querySelector('.ratio-num');
      if (numEl) numEl.textContent = ratio + '%';
      var fg = card.querySelector('.ratio-ring-fg');
      if (fg) {
        fg.setAttribute('stroke-dasharray', '163.36');
        fg.setAttribute('stroke-dashoffset', 163.36 - (163.36 * ratio / 100));
      }
      form.classList.remove('is-open');
      card.classList.remove('is-editing');
      toast('受益人信息已更新', 'success');
    } else if (action === 'open-add-bene') {
      e.preventDefault();
      e.stopPropagation();
      var m = document.getElementById('modal-add-bene');
      if (m) {
        m.classList.add('is-open');
        var bd = document.querySelector('[data-modal-backdrop="modal-add-bene"]');
        if (bd) bd.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      }
    } else if (action === 'submit-bene') {
      var modal = document.getElementById('modal-add-bene');
      if (!modal) return;
      var name = modal.querySelector('[name="name"]').value.trim();
      var rel = modal.querySelector('[name="rel"]').value;
      var idcard = modal.querySelector('[name="idcard"]').value.trim();
      var phone = modal.querySelector('[name="phone"]').value.trim();
      var ok = true;
      function setErr(field, msg) {
        var el = modal.querySelector('[data-error-for="' + field + '"]');
        if (el) el.textContent = msg || '';
        var input = modal.querySelector('[name="' + field.replace('add-', '') + '"]');
        if (input) { if (msg) input.setAttribute('data-state', 'error'); else input.removeAttribute('data-state'); }
      }
      if (!name) { setErr('add-name', '请填写姓名'); ok = false; } else setErr('add-name', '');
      if (!rel) { setErr('add-rel', '请选择关系'); ok = false; } else setErr('add-rel', '');
      if (!idcard) { setErr('add-idcard', '请填写身份证号'); ok = false; }
      else if (!/^\d{17}[\dXx]$/.test(idcard)) { setErr('add-idcard', '身份证号格式不正确'); ok = false; }
      else setErr('add-idcard', '');
      if (!phone) { setErr('add-phone', '请填写手机号'); ok = false; }
      else if (!/^1[3-9]\d{9}$/.test(phone)) { setErr('add-phone', '手机号格式不正确'); ok = false; }
      else setErr('add-phone', '');
      if (!ok) { toast('请填写所有必填项', 'error'); return; }
      toast('受益人已添加 · 请等待其完成 KYC 验证', 'success');
      // 关闭
      setTimeout(function () {
        m.classList.remove('is-open');
        var bd = document.querySelector('[data-modal-backdrop="modal-add-bene"]');
        if (bd) bd.classList.remove('is-open');
        document.body.style.overflow = '';
        // 清空表单
        modal.querySelectorAll('input, select').forEach(function (i) { if (i.type !== 'range' && i.type !== 'checkbox') i.value = ''; });
      }, 600);
    }
  });

  // B1 增强：比例滑块实时显示
  document.querySelectorAll('input[type="range"][data-target-display]').forEach(function (rng) {
    rng.addEventListener('input', function () {
      var target = rng.getAttribute('data-target-display');
      var el = document.getElementById(target);
      if (el) el.textContent = rng.value + '%';
      // 同步滑块所在 card 的 ratio-ring
      var card = rng.closest('.bene-card');
      if (card) {
        var numEl = card.querySelector('.ratio-num');
        if (numEl) numEl.textContent = rng.value + '%';
        var fg = card.querySelector('.ratio-ring-fg');
        if (fg) {
          fg.setAttribute('stroke-dasharray', '163.36');
          fg.setAttribute('stroke-dashoffset', 163.36 - (163.36 * rng.value / 100));
        }
      }
    });
  });

  // B1 增强：page actions
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('button');
    if (!btn) return;
    var t = btn.textContent.trim();
    if (t === '+ 新增受益人' || t === '添加') {
      var m = document.getElementById('modal-add-bene');
      if (m) {
        m.classList.add('is-open');
        var bd = document.querySelector('[data-modal-backdrop="modal-add-bene"]');
        if (bd) bd.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      }
    } else if (t === '查看传承记录') {
      toast('正在加载传承记录', 'info');
    } else if (t === '查看详情') {
      toast('打开受益人详情', 'info');
    } else if (t === '了解外部服务') {
      toast('外部服务需在 Business Activities 自行发布需求', 'info');
    }
  });
</script>
</body>
</html>
