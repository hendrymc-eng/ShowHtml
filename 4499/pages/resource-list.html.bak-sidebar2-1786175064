    /* 资源价值评估 · 雷达图（纯 CSS/SVG） */
    .radar-grid { position: relative; width: 100%; aspect-ratio: 1 / 1; max-width: 360px; margin: 0 auto; }
    .radar-grid svg { width: 100%; height: 100%; }
    .radar-axis-label { font-size: 11px; fill: var(--color-ink-3); font-family: var(--font-body); }
    .radar-axis-val { font-size: 10px; fill: var(--color-ink-2); font-family: var(--font-mono); }
    .radar-shape { fill: var(--color-accent-soft); stroke: var(--color-accent); stroke-width: 1.5; }

    /* 价值评分维度列表 */
    .radar-legend { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-3); margin-top: var(--space-4); }
    .radar-legend-item { display: flex; align-items: center; justify-content: space-between; font-size: var(--text-sm); }
    .radar-legend-label { color: var(--color-ink-2); }
    .radar-legend-val { font-family: var(--font-mono); color: var(--color-ink); font-weight: var(--weight-medium); }

    /* 30 天日历 */
    .calendar { display: grid; grid-template-columns: 60px repeat(7, 1fr); gap: 1px; background: var(--color-line); border: 1px solid var(--color-line); border-radius: var(--radius-sm); overflow: hidden; }
    .calendar-cell { background: var(--color-surface); padding: var(--space-2); min-height: 56px; font-size: var(--text-xs); color: var(--color-ink-2); }
    .calendar-cell-head { background: var(--color-surface-2); font-weight: var(--weight-medium); text-align: center; padding: var(--space-2); font-size: var(--text-xs); color: var(--color-ink-3); text-transform: uppercase; letter-spacing: 0.04em; }
    .calendar-cell-week { background: var(--color-surface-2); font-weight: var(--weight-medium); text-align: center; font-size: var(--text-xs); color: var(--color-ink-3); display: flex; align-items: center; justify-content: center; }
    .calendar-day-num { font-family: var(--font-mono); font-size: 10px; color: var(--color-ink-3); margin-bottom: 2px; }
    .calendar-tag { display: inline-block; padding: 1px 4px; border-radius: 2px; background: var(--color-accent-soft); color: var(--color-accent); font-size: 10px; margin-top: 2px; }
    .calendar-tag-mute { background: var(--color-surface-2); color: var(--color-ink-3); }
    .calendar-cell.is-today { background: var(--color-accent-softer); }
    .calendar-cell.is-future { opacity: 0.5; }

    /* 对比表（资源对比） */
    .compare-col { display: flex; flex-direction: column; gap: var(--space-2); }
    .compare-row { display: flex; justify-content: space-between; align-items: center; padding: var(--space-2) 0; border-bottom: 1px solid var(--color-line); font-size: var(--text-sm); }
    .compare-row:last-child { border-bottom: none; }
    .compare-row-label { color: var(--color-ink-3); }
    .compare-row-val { font-family: var(--font-mono); color: var(--color-ink); font-weight: var(--weight-medium); }
    .compare-col-header { padding: var(--space-3) 0; border-bottom: 2px solid var(--color-line); }

    /* 资源推荐理由列表 */
    .reason-line { display: flex; align-items: flex-start; gap: var(--space-2); font-size: var(--text-sm); color: var(--color-ink-2); margin-bottom: var(--space-2); line-height: var(--leading-relaxed); }
    .reason-num { width: 18px; height: 18px; border-radius: 50%; background: var(--color-accent-soft); color: var(--color-accent); font-size: 10px; font-weight: var(--weight-semibold); display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2px; }
  </style>
