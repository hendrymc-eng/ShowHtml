  <style>
    .enterprise-hero { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-md); padding: var(--space-6); display: grid; grid-template-columns: 80px 1fr auto; gap: var(--space-6); align-items: center; }
    @media (max-width: 768px) { .enterprise-hero { grid-template-columns: 1fr; } }
    .ent-logo { width: 80px; height: 80px; border-radius: var(--radius-md); background: var(--color-accent-soft); color: var(--color-accent); display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-size: 32px; font-weight: 600; }
    .info-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-3) var(--space-6); }
    .info-row { display: flex; gap: var(--space-3); padding: var(--space-2) 0; }
    .info-label { font-size: var(--text-sm); color: var(--color-ink-3); min-width: 80px; }
    .info-value { font-size: var(--text-sm); color: var(--color-ink); }
    .timeline { display: flex; flex-direction: column; }
    .timeline-item { display: flex; gap: var(--space-3); padding-bottom: var(--space-4); position: relative; }
    .timeline-item:not(:last-child)::after { content: ''; position: absolute; left: 7px; top: 18px; bottom: 0; width: 1px; background: var(--color-line); }
    .timeline-dot { width: 14px; height: 14px; border-radius: 50%; background: var(--color-surface); border: 2px solid var(--color-accent); flex-shrink: 0; margin-top: 4px; }
    .timeline-item-done .timeline-dot { background: var(--color-accent); }
    .timeline-item-current .timeline-dot { background: var(--color-warn); border-color: var(--color-warn); }
    .contact-row { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--color-line); }
    .contact-row:last-child { border-bottom: none; }

    /* 联系记录 5 项必填 (PRD CRM-006) */
    .contact-form { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: var(--space-3); }
    .contact-form-field { display: flex; flex-direction: column; gap: 4px; }
    .contact-form-label { font-size: var(--text-xs); color: var(--color-ink-3); font-weight: var(--weight-medium); }
    .contact-form-label .req { color: var(--color-danger); }
    .contact-form-input, .contact-form-select, .contact-form-textarea {
      padding: 8px 10px; border: 1px solid var(--color-line); border-radius: var(--radius-sm);
      font-size: var(--text-sm); background: var(--color-surface); color: var(--color-ink);
      font-family: inherit;
    }
    .contact-form-textarea { min-height: 60px; resize: vertical; }

    /* 联系方式审计提示 (PRD CRM-010 / §3.4) */
    .export-watermark-notice {
      padding: var(--space-3); background: var(--color-warn-soft);
      border: 1px solid var(--color-warn-soft); border-radius: var(--radius-sm);
      font-size: var(--text-xs); color: var(--color-ink-2);
    }
    .export-watermark-notice strong { color: var(--color-ink); }
    .audit-log-entry { display: grid; grid-template-columns: 140px 1fr 1fr; gap: var(--space-3); padding: var(--space-2) 0; border-bottom: 1px solid var(--color-line); font-size: var(--text-xs); }
    .audit-log-entry:last-child { border-bottom: none; }
    .audit-log-time { font-family: var(--font-mono); color: var(--color-ink-3); }
    .audit-log-actor { color: var(--color-ink); font-weight: var(--weight-medium); }
    .audit-log-action { color: var(--color-ink-2); }

    /* 字段来源标签 (PRD PRO-003) */
    .field-source { display: inline-flex; align-items: center; gap: 2px; padding: 1px 6px; border-radius: var(--radius-xs); font-size: 10px; font-weight: var(--weight-medium); margin-left: 4px; vertical-align: middle; }
    .field-source-self { background: var(--color-surface-2); color: var(--color-ink-2); }
    .field-source-platform { background: var(--color-info-soft); color: var(--color-info); }
    .field-source-verified { background: var(--color-success-soft); color: var(--color-success); }
    .field-source-ai { background: var(--color-accent-soft); color: var(--color-accent); }
    .field-verified-badge { display: inline-flex; align-items: center; gap: 2px; padding: 1px 6px; background: var(--color-success-soft); color: var(--color-success); border-radius: var(--radius-xs); font-size: 10px; font-weight: var(--weight-semibold); margin-left: 4px; vertical-align: middle; }
    .field-unverified-badge { display: inline-flex; align-items: center; gap: 2px; padding: 1px 6px; background: var(--color-surface-2); color: var(--color-ink-3); border: 1px dashed var(--color-line-2); border-radius: var(--radius-xs); font-size: 10px; font-weight: var(--weight-medium); margin-left: 4px; vertical-align: middle; }

    /* 版本历史 (PRD PRO-006) */
    .version-timeline { display: flex; flex-direction: column; gap: var(--space-2); }
    .version-item { display: grid; grid-template-columns: 100px 1fr 180px; gap: var(--space-3); padding: var(--space-2) 0; border-bottom: 1px solid var(--color-line); font-size: var(--text-sm); }
    .version-item:last-child { border-bottom: none; }
    .version-time { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-ink-3); }
    .version-changes { color: var(--color-ink-2); }
    .version-diff { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; }
    .version-diff .old { background: var(--color-danger-soft); color: var(--color-danger); padding: 1px 4px; border-radius: 2px; text-decoration: line-through; }
    .version-diff .new { background: var(--color-success-soft); color: var(--color-success); padding: 1px 4px; border-radius: 2px; }

    /* 字段来源图例 */
    .field-source-legend { display: flex; flex-wrap: wrap; gap: var(--space-3); padding: var(--space-2) var(--space-3); background: var(--color-surface-2); border-radius: var(--radius-sm); font-size: var(--text-xs); color: var(--color-ink-3); }
    .field-source-legend-item { display: inline-flex; align-items: center; gap: 4px; }
  </style>
