  <style>
    /* Hallmark · macrostructure: Marquee Hero + 紧凑 page-section · tone: modern-minimal · anchor hue: Cobalt oklch(48% 0.18 255) · system-managed (design.md v1.0 · 2026-08-08) */
    body { background: var(--color-paper); }
    .site-nav {
      position: sticky; top: 0; z-index: 50;
      background: var(--color-paper);
      border-bottom: 1px solid var(--color-line);
      backdrop-filter: saturate(180%) blur(8px);
    }
    .site-nav-inner {
      max-width: var(--container-max);
      margin: 0 auto; padding: 0 var(--space-6);
      height: 64px;
      display: flex; align-items: center; gap: var(--space-8);
    }
    .site-brand {
      display: flex; align-items: center; gap: var(--space-2);
      font-family: var(--font-display);
      font-weight: var(--weight-semibold);
      font-size: var(--text-lg);
      color: var(--color-ink);
      text-decoration: none; letter-spacing: -0.01em;
    }
    .site-brand-mark {
      width: 28px; height: 28px;
      border-radius: var(--radius-sm);
      background: linear-gradient(135deg, var(--color-accent), var(--color-accent-2));
      color: var(--color-accent-ink);
      display: inline-flex; align-items: center; justify-content: center;
      font-weight: var(--weight-bold); font-size: var(--text-sm);
      font-family: var(--font-display);
    }
    .site-menu { display: flex; align-items: center; gap: var(--space-1); flex: 1; }
    .site-menu a {
      padding: var(--space-2) var(--space-3);
      border-radius: var(--radius-sm);
      color: var(--color-ink-2);
      font-size: var(--text-md); font-weight: var(--weight-medium);
      text-decoration: none;
      transition: color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
    }
    .site-menu a:hover { color: var(--color-ink); background: var(--color-surface-2); }
    .site-menu a.is-current { color: var(--color-ink); }
    .site-actions { display: flex; align-items: center; gap: var(--space-2); }
    .nav-toggle { display: none; }

    /* Hero (taller, more vertical breathing) */
    .hero {
      background: linear-gradient(180deg, var(--color-accent-softer) 0%, var(--color-paper) 100%);
      border-bottom: 1px solid var(--color-line);
      padding: var(--space-16) 0 var(--space-12);
      position: relative;
      overflow: hidden;
    }
    .hero-decor-stack {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 0;
    }
    .hero-decor-orb-1 {
      position: absolute;
      top: -100px; right: 10%;
      width: 420px; height: 420px;
      border-radius: 50%;
      background: radial-gradient(circle, var(--color-accent) 0%, transparent 70%);
      opacity: 0.16;
      filter: blur(50px);
    }
    .hero-decor-orb-2 {
      position: absolute;
      bottom: -120px; left: -60px;
      width: 320px; height: 320px;
      border-radius: 50%;
      background: radial-gradient(circle, var(--color-trust) 0%, transparent 70%);
      opacity: 0.10;
      filter: blur(60px);
    }
    .hero-decor-lines {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(to right, var(--color-line) 1px, transparent 1px),
        linear-gradient(to bottom, var(--color-line) 1px, transparent 1px);
      background-size: 80px 80px;
      mask-image: radial-gradient(ellipse 60% 60% at 50% 50%, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0) 100%);
      -webkit-mask-image: radial-gradient(ellipse 60% 60% at 50% 50%, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0) 100%);
      opacity: 0.4;
    }
    .hero-inner { position: relative; z-index: 1; }
    .hero-inner {
      max-width: 880px;
      margin: 0 auto; padding: 0 var(--space-6);
      text-align: center;
    }
    .hero-eyebrow {
      display: inline-flex; align-items: center; gap: var(--space-2);
      font-size: var(--text-xs);
      font-weight: var(--weight-medium);
      text-transform: uppercase; letter-spacing: 0.08em;
      color: var(--color-accent);
      padding: 6px var(--space-3);
      background: var(--color-accent-soft);
      border-radius: var(--radius-pill);
      margin-bottom: var(--space-5);
    }
    .hero-eyebrow-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-accent); }
    .hero-title {
      font-family: var(--font-display);
      font-size: var(--text-display);
      font-weight: var(--weight-semibold);
      color: var(--color-ink);
      line-height: 1.05; letter-spacing: -0.025em;
      margin: 0 0 var(--space-5);
    }
    .hero-subtitle {
      font-size: var(--text-xl);
      color: var(--color-ink-2);
      line-height: var(--leading-relaxed);
      max-width: 640px; margin: 0 auto;
    }

    .page-section { padding: var(--space-10) 0; }
    .page-section:first-of-type { padding-top: var(--space-6); }
    .hero + .page-section { padding-top: var(--space-3); padding-bottom: var(--space-6); }
    .page-section + .page-section { border-top: 1px solid var(--color-line); }
    .container { max-width: var(--container-max); margin: 0 auto; padding: 0 var(--space-6); }
    .container-narrow { max-width: 880px; }

    /* Mission/Vision split */
    .mv-grid {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: var(--space-4);
      margin-top: var(--space-4);
    }
    .mv-card {
      background: var(--color-surface);
      border: 1px solid var(--color-line);
      border-radius: var(--radius-md);
      padding: var(--space-5);
    }
    .mv-eyebrow {
      font-size: var(--text-xs);
      text-transform: uppercase; letter-spacing: 0.08em;
      color: var(--color-accent);
      font-weight: var(--weight-medium);
      margin-bottom: var(--space-3);
      display: block;
    }
    .mv-title {
      font-family: var(--font-display);
      font-size: var(--text-2xl);
      font-weight: var(--weight-semibold);
      color: var(--color-ink);
      margin: 0 0 var(--space-3);
      letter-spacing: -0.01em;
    }
    .mv-text { font-size: var(--text-md); color: var(--color-ink-2); line-height: var(--leading-relaxed); margin: 0; }

    /* Story long-form */
    .story-grid {
      display: grid; grid-template-columns: 1fr 1.4fr;
      gap: var(--space-12);
      align-items: start;
    }
    .story-aside {
      position: sticky; top: 96px;
      padding: var(--space-6);
      background: var(--color-surface);
      border: 1px solid var(--color-line);
      border-radius: var(--radius-md);
    }
    .story-aside-row { display: flex; justify-content: space-between; padding: var(--space-3) 0; border-bottom: 1px solid var(--color-line); }
    .story-aside-row:last-child { border-bottom: none; }
    .story-aside-label { font-size: var(--text-sm); color: var(--color-ink-3); }
    .story-aside-value { font-size: var(--text-sm); color: var(--color-ink); font-weight: var(--weight-medium); }
    .story-body p { font-size: var(--text-md); color: var(--color-ink-2); line-height: var(--leading-relaxed); margin: 0 0 var(--space-4); }
    .story-body p:last-child { margin-bottom: 0; }
    .story-body .pullquote {
      font-family: var(--font-display);
      font-size: var(--text-xl);
      color: var(--color-ink);
      font-weight: var(--weight-medium);
      border-left: 2px solid var(--color-accent);
      padding: var(--space-2) 0 var(--space-2) var(--space-5);
      margin: var(--space-6) 0;
      letter-spacing: -0.01em;
    }

    /* Principles (2x2) */
    .principle-grid {
      display: grid; grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
      margin-top: var(--space-6);
    }
    .principle-card {
      background: var(--color-surface);
      border: 1px solid var(--color-line);
      border-radius: var(--radius-md);
      padding: var(--space-5);
    }
    .principle-num {
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      color: var(--color-ink-4);
      margin-bottom: var(--space-4);
      letter-spacing: 0.08em;
    }
    .principle-title {
      font-size: var(--text-lg);
      font-weight: var(--weight-semibold);
      color: var(--color-ink);
      margin: 0 0 var(--space-2);
    }
    .principle-desc {
      font-size: var(--text-sm);
      color: var(--color-ink-2);
      line-height: var(--leading-relaxed);
      margin: 0;
    }

    /* Boundary table */
    .boundary-table {
      background: var(--color-surface);
      border: 1px solid var(--color-line);
      border-radius: var(--radius-md);
      overflow: hidden;
      margin-top: var(--space-8);
    }
    .boundary-row {
      display: grid;
      grid-template-columns: 180px 1fr 1fr;
      border-bottom: 1px solid var(--color-line);
    }
    .boundary-row:last-child { border-bottom: none; }
    .boundary-row.is-head { background: var(--color-surface-2); }
    .boundary-row.is-head .boundary-cell { font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-ink-3); font-weight: var(--weight-medium); }
    .boundary-cell { padding: var(--space-4) var(--space-5); font-size: var(--text-md); color: var(--color-ink-2); }
    .boundary-cell:first-child { font-weight: var(--weight-medium); color: var(--color-ink); border-right: 1px solid var(--color-line); background: var(--color-surface-2); }
    .boundary-tag {
      display: inline-flex; align-items: center; gap: var(--space-1);
      padding: 2px var(--space-2);
      font-size: var(--text-xs);
      border-radius: var(--radius-pill);
      background: var(--color-accent-soft);
      color: var(--color-accent);
      font-weight: var(--weight-medium);
      margin-right: var(--space-2);
    }
    .boundary-tag-no { background: var(--color-surface-3); color: var(--color-ink-3); }
    .boundary-tag-yes { background: var(--color-success-soft); color: var(--color-success); }

    /* Team cards */
    .team-grid {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
      margin-top: var(--space-8);
    }
    .team-card {
      background: var(--color-surface);
      border: 1px solid var(--color-line);
      border-radius: var(--radius-md);
      padding: var(--space-6);
      text-align: center;
    }
    .team-avatar {
      width: 64px; height: 64px;
      border-radius: 50%;
      background: var(--color-accent-soft);
      color: var(--color-accent);
      display: inline-flex; align-items: center; justify-content: center;
      font-family: var(--font-display);
      font-weight: var(--weight-semibold);
      font-size: var(--text-xl);
      margin: 0 auto var(--space-4);
    }
    .team-name {
      font-size: var(--text-md);
      font-weight: var(--weight-semibold);
      color: var(--color-ink);
      margin: 0 0 var(--space-1);
    }
    .team-role {
      font-size: var(--text-sm);
      color: var(--color-ink-3);
      margin: 0 0 var(--space-3);
    }
    .team-bio {
      font-size: var(--text-sm);
      color: var(--color-ink-2);
      line-height: var(--leading-relaxed);
      margin: 0;
    }

    /* CTA band */
    .cta-band {
      background: var(--color-ink);
      color: var(--color-ink-inv);
      padding: var(--space-20) 0;
    }
    .cta-band-inner {
      max-width: var(--container-max);
      margin: 0 auto; padding: 0 var(--space-6);
      display: grid; grid-template-columns: 1.4fr 1fr;
      gap: var(--space-12); align-items: center;
    }
    .cta-band-eyebrow { color: var(--color-ink-4); margin-bottom: var(--space-3); display: block; }
    .cta-band-title { font-size: var(--text-3xl); font-weight: var(--weight-semibold); color: var(--color-ink-inv); margin: 0; letter-spacing: -0.02em; }
    .cta-band-actions { display: flex; gap: var(--space-3); justify-content: flex-end; flex-wrap: wrap; }
    .btn-on-dark { background: var(--color-ink-inv); color: var(--color-ink); }
    .btn-on-dark:hover { background: var(--color-surface-2); }
    .btn-on-dark-outline { background: transparent; color: var(--color-ink-inv); border-color: var(--color-line-3); }
    .btn-on-dark-outline:hover { background: rgba(255,255,255,0.08); }

    /* Footer */
    .site-footer { background: var(--color-surface); border-top: 1px solid var(--color-line); padding: var(--space-16) 0 var(--space-8); }
    .footer-grid {
      max-width: var(--container-max); margin: 0 auto; padding: 0 var(--space-6);
      display: grid; grid-template-columns: 1.5fr repeat(4, 1fr); gap: var(--space-8);
    }
    .footer-brand-block { display: flex; flex-direction: column; gap: var(--space-3); }
    .footer-tagline { font-size: var(--text-sm); color: var(--color-ink-2); line-height: var(--leading-relaxed); max-width: 280px; }
    .footer-social { display: flex; gap: var(--space-2); margin-top: var(--space-2); }
    .footer-social a {
      width: 32px; height: 32px;
      border-radius: var(--radius-sm);
      background: var(--color-surface-2);
      color: var(--color-ink-2);
      display: inline-flex; align-items: center; justify-content: center;
      text-decoration: none;
    }
    .footer-social a:hover { background: var(--color-accent-soft); color: var(--color-accent); }
    .footer-col h4 { font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-ink-3); font-weight: var(--weight-medium); margin: 0 0 var(--space-3); }
    .footer-col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-2); }
    .footer-col a { font-size: var(--text-sm); color: var(--color-ink-2); text-decoration: none; }
    .footer-col a:hover { color: var(--color-ink); }
    .footer-bottom {
      max-width: var(--container-max); margin: var(--space-12) auto 0;
      padding: var(--space-6) var(--space-6) 0;
      border-top: 1px solid var(--color-line);
      display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-3);
      font-size: var(--text-sm); color: var(--color-ink-3);
    }
    .footer-bottom-links { display: flex; gap: var(--space-4); }
    .footer-bottom-links a { color: var(--color-ink-3); text-decoration: none; }
    .footer-bottom-links a:hover { color: var(--color-ink); }

    @media (max-width: 1200px) {
      .hero-title { font-size: 56px; }
      .footer-grid { grid-template-columns: 1.5fr repeat(2, 1fr); }
    }
    @media (max-width: 1024px) {
      .hero-title { font-size: 48px; }
      .mv-grid { grid-template-columns: 1fr; }
      .story-grid { grid-template-columns: 1fr; }
      .story-aside { position: static; }
      .cta-band-inner { grid-template-columns: 1fr; }
      .cta-band-actions { justify-content: flex-start; }
    }
    @media (max-width: 768px) {
      .site-menu { display: none; }
      .nav-toggle { display: inline-flex; }
      .site-actions .btn-text-hide { display: none; }
      .hero { padding: var(--space-14) 0 var(--space-10); }
      .hero-title { font-size: 36px; }
      .page-section { padding: var(--space-12) 0; }
      .principle-grid { grid-template-columns: 1fr; }
      .team-grid { grid-template-columns: 1fr; }
      .boundary-row { grid-template-columns: 1fr; }
      .boundary-cell:first-child { border-right: none; border-bottom: 1px solid var(--color-line); }
      .footer-grid { grid-template-columns: 1fr 1fr; }
      .footer-brand-block { grid-column: span 2; }
    }
    @media (max-width: 480px) {
      .hero-title { font-size: 30px; }
      .footer-grid { grid-template-columns: 1fr; }
      .footer-brand-block { grid-column: span 1; }
    }
    @media (prefers-reduced-motion: reduce) { * { transition-duration: 0.01ms !important; } }
  </style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script src="../js/brand-motion.js"></script>
</head>
