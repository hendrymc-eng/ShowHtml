      <div class="modal-header">
        <div class="modal-title">创建新活动</div>
        <div class="modal-close" data-modal-close="modal-create">×</div>
      </div>
      <div class="modal-body">
        <div class="flex flex-col gap-3">
          <div class="input-group">
            <label class="input-label">活动类型</label>
            <select class="select">
              <option>学习中心</option>
              <option>活动与聚会</option>
              <option>项目中心</option>
              <option>服务订单</option>
              <option>产品购买</option>
              <option>公益行动</option>
            </select>
          </div>
          <div class="input-group">
            <label class="input-label">活动名称</label>
            <input class="input" placeholder="例：跨境并购对标分析工作坊" />
          </div>
          <div class="input-group">
            <label class="input-label">主办方</label>
            <input class="input" placeholder="可选择已有 EMP 或新增" />
          </div>
          <div class="input-group">
            <label class="input-label">活动描述</label>
            <textarea class="textarea" placeholder="详细介绍活动目标 / 议程 / 适合人群"></textarea>
          </div>
          <div class="grid-2x" style="gap: var(--space-3);">
            <div class="input-group">
              <label class="input-label">开始时间</label>
              <input class="input" type="datetime-local" value="2026-09-15T14:00" />
            </div>
            <div class="input-group">
              <label class="input-label">名额</label>
              <input class="input" type="number" value="20" />
            </div>
          </div>
          <div class="check-box js-check-box is-active" style="padding: var(--space-3); border: 1px solid var(--color-line); border-radius: var(--radius-sm);">
            <input type="checkbox" checked />
            <span class="text-sm">包含 0.5% 自动捐赠至清禾基金会</span>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-ghost" data-modal-close="modal-create">取消</button>
        <button class="btn btn-secondary">保存草稿</button>
        <button class="btn btn-primary" onclick="toast('活动创建成功，已通知 AI 团队审核','success');">创建并发布</button>
      </div>
    </div>
  </div>

