    .auth-row-warn:hover { background: var(--color-warn-soft); }
    .auth-row-expired { opacity: 0.65; }
    .auth-status-pill { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: var(--radius-pill); font-size: var(--text-xs); font-weight: var(--weight-medium); }
