    .history-card-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-3); }
    .history-period { font-size: var(--text-sm); color: var(--color-ink-2); font-weight: var(--weight-medium); }
    .history-score { font-family: var(--font-display); font-size: var(--text-2xl); font-weight: var(--weight-semibold); color: var(--color-accent); }
