    .cycle-day-tag { display: inline-block; padding: 1px 4px; border-radius: 2px; font-size: 10px; line-height: 1.4; }
    .cycle-day-tag-commit { background: var(--color-accent-soft); color: var(--color-accent); }
    .cycle-day-tag-actual { background: var(--color-success-soft); color: var(--color-success); }
    .cycle-day-tag-warn { background: var(--color-warn-soft); color: var(--color-warn-2); }
    .cycle-day.is-today { border-color: var(--color-accent); background: var(--color-accent-softer); box-shadow: 0 0 0 2px var(--color-accent-soft); }
    .cycle-day.is-future { opacity: 0.45; }
    .cycle-day.is-past { background: var(--color-surface-2); }

    /* 服务深度评分 · 4 维圆环 */
    .score-rings { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-4); }
    .score-ring { text-align: center; }
    .score-ring svg { width: 88px; height: 88px; }
    .score-ring-bg { fill: none; stroke: var(--color-surface-2); stroke-width: 6; }
    .score-ring-fg { fill: none; stroke-width: 6; stroke-linecap: round; }
    .score-ring-val { font-family: var(--font-display); font-size: var(--text-xl); font-weight: var(--weight-semibold); fill: var(--color-ink); }
    .score-ring-label { font-size: var(--text-sm); color: var(--color-ink-2); margin-top: var(--space-2); }
    .score-ring-meta { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; }

    /* 同期对比 · 双柱状 */
    .compare-bars { display: flex; flex-direction: column; gap: var(--space-4); }
    .compare-bar-row { display: grid; grid-template-columns: 100px 1fr 1fr 60px; gap: var(--space-3); align-items: center; }
    .compare-bar-label { font-size: var(--text-sm); color: var(--color-ink-2); }
    .compare-bar-pair { display: flex; flex-direction: column; gap: 2px; }
    .compare-bar-track { height: 8px; background: var(--color-surface-2); border-radius: var(--radius-pill); overflow: hidden; position: relative; }
    .compare-bar-fill { height: 100%; border-radius: var(--radius-pill); }
    .compare-bar-fill.is-current { background: var(--color-accent); }
    .compare-bar-fill.is-prev { background: var(--color-ink-3); }
    .compare-bar-val { font-size: var(--text-xs); color: var(--color-ink-3); font-family: var(--font-mono); text-align: right; }

    /* 历史服务窗口卡片 */
