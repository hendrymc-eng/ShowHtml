  <style>
    .ai-match-layout { display: grid; grid-template-columns: 280px 1fr; gap: var(--space-6); align-items: start; }
    @media (max-width: 1024px) { .ai-match-layout { grid-template-columns: 1fr; } .demand-side { display: none; } }
    .expert-card {
      background: var(--color-surface);
      border: 1px solid var(--color-line);
      border-radius: var(--radius-md);
      padding: var(--space-5);
      transition: all var(--dur-fast) var(--ease-out);
    }
    .expert-card:hover { border-color: var(--color-line-2); }
    .expert-card.is-top { border-color: var(--color-accent); background: var(--color-accent-softer); }
    .expert-rank {
      display: inline-flex; align-items: center; gap: var(--space-1);
      padding: 2px 8px;
      background: var(--color-surface-2);
      color: var(--color-ink-2);
      border-radius: var(--radius-pill);
      font-size: var(--text-xs); font-weight: var(--weight-medium);
      font-family: var(--font-mono);
    }
    .expert-rank.is-top { background: var(--color-accent); color: var(--color-accent-ink); }
    .reason-list { display: flex; flex-direction: column; gap: var(--space-1); }
    .reason-item { display: flex; align-items: flex-start; gap: var(--space-2); font-size: var(--text-sm); color: var(--color-ink-2); }
    .reason-check { width: 16px; height: 16px; border-radius: 50%; background: var(--color-success-soft); color: var(--color-success); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 10px; margin-top: 2px; }
    .reason-cross { width: 16px; height: 16px; border-radius: 50%; background: var(--color-danger-soft); color: var(--color-danger); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 10px; margin-top: 2px; }
    .reason-warn { width: 16px; height: 16px; border-radius: 50%; background: var(--color-warn-soft); color: var(--color-warn-2); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 10px; margin-top: 2px; }
    .expert-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-3); margin-top: var(--space-3); padding-top: var(--space-3); border-top: 1px solid var(--color-line); }
    .expert-stat { text-align: center; }
    .expert-stat-value { font-family: var(--font-mono); font-size: var(--text-md); font-weight: var(--weight-medium); color: var(--color-ink); }
    .expert-stat-label { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; }

    /* B1 增强：hover 抬升 + 选定高亮 */
    .expert-card { cursor: pointer; position: relative; }
    .expert-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); border-color: var(--color-line-2); }
    .expert-card.is-selected { border-color: var(--color-accent); border-width: 2px; background: var(--color-accent-softer); }
    .expert-card.is-selected::before {
      content: '✓ 已选定';
      position: absolute; top: 12px; right: 12px;
      padding: 2px 10px; border-radius: var(--radius-pill);
      background: var(--color-accent); color: var(--color-accent-ink);
      font-size: var(--text-xs); font-weight: var(--weight-medium);
    }
    @keyframes grow-bar { from { width: 0 !important; } }
    .progress-bar.animate-in { animation: grow-bar 900ms var(--ease-out) forwards; }

    /* B2 新增：评分圆环 + 雷达 + 案例 + 备选 */
    .score-ring { width: 80px; height: 80px; position: relative; }
    .score-ring svg { transform: rotate(-90deg); }
    .score-ring-bg { fill: none; stroke: var(--color-surface-2); stroke-width: 6; }
    .score-ring-fg { fill: none; stroke: var(--color-accent); stroke-width: 6; stroke-linecap: round; }
    .score-ring.is-top .score-ring-fg { stroke: var(--color-trust); }
    .score-num { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; font-family: var(--font-display); font-weight: var(--weight-semibold); }
    .score-num-val { font-size: var(--text-2xl); line-height: 1; color: var(--color-ink); }
    .score-num-lbl { font-size: 10px; color: var(--color-ink-3); margin-top: 2px; }
    .match-factor { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; background: var(--color-surface-2); border-radius: var(--radius-pill); font-size: var(--text-xs); color: var(--color-ink-2); }
    .match-factor.is-pos { background: var(--color-success-soft); color: var(--color-success-2); }
    .match-factor.is-neg { background: var(--color-warn-soft); color: var(--color-warn-2); }

    .radar-wrap { display: flex; align-items: center; gap: var(--space-6); }
    .radar { width: 200px; height: 200px; position: relative; flex-shrink: 0; }
    .radar-axis { position: absolute; inset: 0; }
    .radar-axis::before, .radar-axis::after { content: ''; position: absolute; background: var(--color-line-2); }
    .radar-axis::before { left: 50%; top: 0; bottom: 0; width: 1px; transform: translateX(-50%); }
    .radar-axis::after { top: 50%; left: 0; right: 0; height: 1px; transform: translateY(-50%); }
    .radar-grid { position: absolute; inset: 0; border: 1px solid var(--color-line); border-radius: 50%; }
    .radar-grid.r2 { inset: 25%; opacity: 0.5; }
    .radar-grid.r3 { inset: 50%; opacity: 0.3; }
    .radar-label { position: absolute; font-size: var(--text-xs); color: var(--color-ink-2); font-weight: var(--weight-medium); }
    .radar-label.t { top: -2px; left: 50%; transform: translateX(-50%); }
    .radar-label.r { right: -2px; top: 50%; transform: translateY(-50%); }
    .radar-label.b { bottom: -2px; left: 50%; transform: translateX(-50%); }
    .radar-label.l { left: -2px; top: 50%; transform: translateY(-50%); }
    .radar-shape { position: absolute; inset: 0; }
    .radar-shape svg { width: 100%; height: 100%; }
    .radar-legend { flex: 1; display: flex; flex-direction: column; gap: var(--space-2); }
    .radar-row { display: flex; align-items: center; gap: var(--space-3); font-size: var(--text-sm); }
    .radar-row-name { width: 80px; color: var(--color-ink-2); }
    .radar-row-bar { flex: 1; height: 6px; background: var(--color-surface-2); border-radius: var(--radius-pill); overflow: hidden; }
    .radar-row-fill { height: 100%; background: var(--color-accent); border-radius: var(--radius-pill); }
    .radar-row-num { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-ink); min-width: 32px; text-align: right; }

    .sim-case { padding: var(--space-3); border: 1px solid var(--color-line); border-radius: var(--radius-sm); background: var(--color-surface); }
    .sim-case-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-1); }
    .sim-case-name { font-size: var(--text-sm); font-weight: var(--weight-medium); color: var(--color-ink); }
    .sim-case-time { font-size: var(--text-xs); color: var(--color-ink-3); font-family: var(--font-mono); }
    .sim-case-meta { font-size: var(--text-xs); color: var(--color-ink-3); line-height: var(--leading-snug); }

    .reason-card { padding: var(--space-4); border: 1px solid var(--color-line); border-radius: var(--radius-md); background: var(--color-surface); }
    .reason-card-num { display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 50%; background: var(--color-accent); color: var(--color-accent-ink); font-size: var(--text-xs); font-weight: var(--weight-semibold); flex-shrink: 0; }
    .reason-card-title { font-size: var(--text-md); font-weight: var(--weight-medium); color: var(--color-ink); margin-bottom: var(--space-1); }
    .reason-card-desc { font-size: var(--text-sm); color: var(--color-ink-2); line-height: var(--leading-relaxed); }

    .filter-dim { padding: var(--space-3); border: 1px solid var(--color-line); border-radius: var(--radius-md); background: var(--color-surface); }
    .filter-dim-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-2); }
    .filter-dim-name { font-size: var(--text-sm); font-weight: var(--weight-medium); color: var(--color-ink); }
    .filter-weight { display: flex; align-items: center; gap: var(--space-2); margin-top: var(--space-2); }
    .filter-weight input[type="range"] { flex: 1; }
    .filter-weight-val { font-family: var(--font-mono); font-size: var(--text-xs); min-width: 32px; text-align: right; color: var(--color-accent); font-weight: var(--weight-medium); }
  </style>
