<script src="../js/app.js"></script>
<script>
  // B1 增强：进度条入场动画
  (function () {
    var bars = document.querySelectorAll('.progress-bar');
    if ('IntersectionObserver' in window) {
      var obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('animate-in'); obs.unobserve(e.target); } });
      }, { threshold: 0.3 });
      bars.forEach(function (b) { obs.observe(b); });
    }
  })();

  // B1 增强：候选卡 hover 效果 + 选定流程
  (function () {
    var cards = document.querySelectorAll('.expert-card');
    var expertData = {
      'zhangming': { name: '张明', avatar: '张', role: 'EMP 导师 · 企业服务中心', score: 92 },
      'liwenhua': { name: '李文华', avatar: '李', role: '企业顾问 · 北京', score: 87 },
      'wangzhiyuan': { name: '王志远', avatar: '王', role: '企业服务中心 · 自动分配', score: 82 },
      'chenxue': { name: '陈雪', avatar: '陈', role: '企业顾问 · 广东', score: 76 }
    };

    cards.forEach(function (card) {
      // hover 效果由 CSS 处理
      card.addEventListener('click', function (e) {
        // 按钮不触发卡片选择
        if (e.target.closest('button')) return;
        // 已选定的不可点击切换
        if (card.classList.contains('is-selected')) {
          toast('已选定此专家，请到「我的任务」查看', 'info');
          return;
        }
        // 全部取消
        cards.forEach(function (c) { c.classList.remove('is-selected'); });
        card.classList.add('is-selected');
        // 判断是哪位专家
        var name = card.querySelector('.text-xl.fw-semibold');
        if (name) {
          var key = '';
          var t = name.textContent.trim();
          if (t.indexOf('张明') >= 0) key = 'zhangming';
          else if (t.indexOf('李文华') >= 0) key = 'liwenhua';
          else if (t.indexOf('王志远') >= 0) key = 'wangzhiyuan';
          else if (t.indexOf('陈雪') >= 0) key = 'chenxue';
          var d = expertData[key];
          if (d) {
            document.getElementById('modal-expert-avatar').textContent = d.avatar;
            document.getElementById('modal-expert-name').textContent = d.name;
            document.getElementById('modal-expert-role').textContent = d.role;
            document.getElementById('modal-expert-score').textContent = d.score;
          }
        }
        var m = document.getElementById('modal-confirm-select');
        if (m) {
          m.classList.add('is-open');
          var bd = document.querySelector('[data-modal-backdrop="modal-confirm-select"]');
          if (bd) bd.classList.add('is-open');
          document.body.style.overflow = 'hidden';
        }
      });
    });
  })();

  // B1 增强：选定按钮 → 直接打开 modal
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('button');
    if (!btn) return;
    var t = btn.textContent.trim();
    if (t === '选定此专家' || t === '选定') {
      e.stopPropagation();
      var card = btn.closest('.expert-card');
      if (card) {
        document.querySelectorAll('.expert-card').forEach(function (c) { c.classList.remove('is-selected'); });
        card.classList.add('is-selected');
      }
      var m = document.getElementById('modal-confirm-select');
      if (m) {
        m.classList.add('is-open');
        var bd = document.querySelector('[data-modal-backdrop="modal-confirm-select"]');
        if (bd) bd.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      }
    } else if (t === '查看完整档案' || t === '查看档案') {
      e.stopPropagation();
      toast('正在加载专家完整档案...', 'info');
    } else if (t === '联系张明预沟通' || t === '了解流程') {
      e.stopPropagation();
      toast('已发起预沟通消息', 'success');
    } else if (t === '由中心分配') {
      e.stopPropagation();
      toast('已请求中心分配', 'info');
    } else if (t === '当前不可用') {
      e.stopPropagation();
      toast('该专家当前不可用，请选择其他', 'warn');
    } else if (t === '查看全部任务') {
      toast('已生成最佳匹配推荐', 'info');
    } else if (t === '重新匹配') {
      toast('AI 重新计算匹配中...', 'info');
    }
  });

  // B1 增强：确认选定 → 提交
  document.addEventListener('click', function (e) {
    var a = e.target.closest('[data-action]');
    if (!a) return;
    if (a.getAttribute('data-action') === 'final-select') {
      var name = document.getElementById('modal-expert-name').textContent;
      toast('已选定 ' + name + ' · 30 天服务窗口已开启', 'success');
      setTimeout(function () {
        var m = document.getElementById('modal-confirm-select');
        if (m) m.classList.remove('is-open');
        var bd = document.querySelector('[data-modal-backdrop="modal-confirm-select"]');
        if (bd) bd.classList.remove('is-open');
        document.body.style.overflow = '';
      }, 700);
    }
  });

  // B1 增强：左侧筛选变化
  document.querySelectorAll('.demand-side select').forEach(function (sel) {
    sel.addEventListener('change', function () {
      toast('已更新筛选：' + sel.options[sel.selectedIndex].text, 'info');
    });
  });

  // B2 新增：权重滑块同步显示
  document.querySelectorAll('input[type="range"][data-target-display]').forEach(function (rng) {
    rng.addEventListener('input', function () {
      var t = rng.getAttribute('data-target-display');
      var el = document.getElementById(t);
      if (el) el.textContent = rng.value + '%';
    });
  });

  // B2 新增：重新匹配按钮
  document.addEventListener('click', function (e) {
    var a = e.target.closest('[data-action="rematch"]');
    if (!a) return;
    toast('AI 正在基于新权重重算...', 'info');
  });

  // B1 增强：segmented 切换
  document.querySelectorAll('.segmented.js-segmented .segmented-item').forEach(function (it) {
    it.addEventListener('click', function () {
      toast('排序方式：' + it.textContent.trim(), 'info');
    });
  });
</script>
</body>
</html>
