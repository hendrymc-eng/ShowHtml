  <style>
    /* 学习路径 4 阶段进度 */
    .learning-path { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; position: relative; }
    .learning-path-stage { padding: var(--space-4) var(--space-3); text-align: center; position: relative; }
    .learning-path-stage:not(:last-child)::after { content: ''; position: absolute; top: 24px; right: -8px; width: 16px; height: 1px; background: var(--color-line-2); }
    .learning-path-circle { width: 32px; height: 32px; border-radius: 50%; background: var(--color-surface-2); border: 2px solid var(--color-line-2); display: flex; align-items: center; justify-content: center; font-size: var(--text-sm); font-weight: var(--weight-semibold); color: var(--color-ink-3); margin: 0 auto var(--space-2); position: relative; z-index: 2; }
    .learning-path-stage.is-current .learning-path-circle { background: var(--color-accent); color: var(--color-accent-ink); border-color: var(--color-accent); }
    .learning-path-stage.is-done .learning-path-circle { background: var(--color-success); color: white; border-color: var(--color-success); }
    .learning-path-stage.is-done::after { background: var(--color-success) !important; }
    .learning-path-title { font-size: var(--text-md); color: var(--color-ink); font-weight: var(--weight-medium); }
    .learning-path-meta { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; }

    /* 学习日历热力图（5 周 × 7 天） */
    .heatmap { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
    .heatmap-cell { aspect-ratio: 1; border-radius: 3px; background: var(--color-surface-2); display: flex; align-items: center; justify-content: center; font-size: 10px; color: var(--color-ink-3); cursor: pointer; transition: all var(--dur-fast) var(--ease-out); position: relative; }
    .heatmap-cell:hover { transform: scale(1.1); z-index: 2; box-shadow: var(--shadow-sm); }
    .heatmap-cell-l1 { background: var(--color-accent-softer); color: var(--color-ink-3); }
    .heatmap-cell-l2 { background: var(--color-accent-soft); color: var(--color-accent); }
    .heatmap-cell-l3 { background: var(--color-accent); color: white; }
    .heatmap-cell-l4 { background: var(--color-accent-2); color: white; }
    .heatmap-legend { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-xs); color: var(--color-ink-3); }
    .heatmap-legend-cells { display: flex; gap: 2px; }
    .heatmap-legend-cell { width: 12px; height: 12px; border-radius: 2px; }

    /* 导师卡 */
    .mentor-card { display: flex; gap: var(--space-3); align-items: flex-start; }
    .mentor-card-avatar { flex-shrink: 0; }
    .mentor-card-main { flex: 1; min-width: 0; }
    .mentor-card-name { font-size: var(--text-md); font-weight: var(--weight-semibold); color: var(--color-ink); }
    .mentor-card-role { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; }
    .mentor-card-tags { display: flex; flex-wrap: wrap; gap: var(--space-1); margin-top: var(--space-2); }

    /* 学习笔记 */
    .note-item { padding: var(--space-3) 0; border-bottom: 1px solid var(--color-line); }
    .note-item:last-child { border-bottom: none; }
    .note-title { font-size: var(--text-md); color: var(--color-ink); font-weight: var(--weight-medium); }
    .note-meta { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 4px; }
    .note-excerpt { font-size: var(--text-sm); color: var(--color-ink-2); margin-top: var(--space-2); line-height: var(--leading-relaxed); }

    /* 成就卡（灰度区分） */
    .achievement { padding: var(--space-4); border: 1px solid var(--color-line); border-radius: var(--radius-md); display: flex; align-items: center; gap: var(--space-3); transition: all var(--dur-fast) var(--ease-out); }
    .achievement-done { background: var(--color-surface); border-color: var(--color-line); }
    .achievement-locked { background: var(--color-surface-2); border-color: var(--color-line); opacity: 0.6; }
    .achievement-icon { width: 40px; height: 40px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .achievement-done .achievement-icon { background: var(--color-success-soft); color: var(--color-success); }
    .achievement-locked .achievement-icon { background: var(--color-surface-3); color: var(--color-ink-4); }
    .achievement-main { flex: 1; min-width: 0; }
    .achievement-name { font-size: var(--text-md); font-weight: var(--weight-medium); color: var(--color-ink); }
    .achievement-desc { font-size: var(--text-xs); color: var(--color-ink-3); margin-top: 2px; }

    /* 课程详情 drawer body */
    .drawer-section { margin-bottom: var(--space-5); }
    .drawer-section:last-child { margin-bottom: 0; }
    .drawer-section-title { font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-ink-3); font-weight: var(--weight-medium); margin-bottom: var(--space-2); }
    .drawer-kv { display: flex; justify-content: space-between; align-items: center; padding: var(--space-2) 0; border-bottom: 1px solid var(--color-line); font-size: var(--text-sm); }
    .drawer-kv:last-child { border-bottom: none; }
    .drawer-kv-label { color: var(--color-ink-3); }
    .drawer-kv-val { color: var(--color-ink); font-weight: var(--weight-medium); }
  </style>
</head>
